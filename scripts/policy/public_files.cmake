# The exporter and policy scanner consume this same exclusion definition.
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/public_exclude.txt" _public_rules)
# Load local, non-distributed tool configuration when present.
set(_local_public_list "${CMAKE_CURRENT_LIST_DIR}/../../private/policy/public_exclude.txt")
if(EXISTS "${_local_public_list}")
  file(STRINGS "${_local_public_list}" _local_public_rules)
  list(APPEND _public_rules ${_local_public_rules})
endif()
set(_public_entries "")
set(_public_components "")
foreach(_rule IN LISTS _public_rules)
  if(_rule STREQUAL "" OR _rule MATCHES "^#")
    continue()
  elseif(_rule MATCHES "^@component (.+)$")
    list(APPEND _public_components "${CMAKE_MATCH_1}")
  else()
    list(APPEND _public_entries "${_rule}")
  endif()
endforeach()
function(sic_public_path path result)
  string(REPLACE "/" ";" _parts "${path}")
  list(GET _parts 0 _root)
  list(FIND _public_entries "${path}" _entry_index)
  list(FIND _public_entries "${_root}" _root_index)
  if(NOT _entry_index EQUAL -1 OR NOT _root_index EQUAL -1)
    set(${result} FALSE PARENT_SCOPE)
    return()
  endif()
  foreach(_component_regex IN LISTS _public_components)
    foreach(_part IN LISTS _parts)
      if(_part MATCHES "${_component_regex}")
        set(${result} FALSE PARENT_SCOPE)
        return()
      endif()
    endforeach()
  endforeach()
  set(${result} TRUE PARENT_SCOPE)
endfunction()

function(sic_public_files root result)
  # Use the exporter's candidate inventory in a development checkout. A source
  # archive has no Git metadata and is scanned directly, including hidden files.
  find_program(_git git)
  if(_git)
    execute_process(COMMAND "${_git}" -C "${root}" rev-parse --show-toplevel
      RESULT_VARIABLE _status OUTPUT_VARIABLE _top ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
  endif()
  if(_git AND _status EQUAL 0 AND _top STREQUAL root)
    # Root rules exclude both the entry and every descendant. Nested exact
    # rules do not exclude descendants, so leave those to sic_public_path.
    set(_pathspecs ":/")
    foreach(_rule IN LISTS _public_rules)
      if(NOT _rule STREQUAL "" AND NOT _rule MATCHES "^#" AND
         NOT _rule MATCHES "^@component " AND NOT _rule MATCHES "/")
        list(APPEND _pathspecs ":(top,exclude,literal)${_rule}")
      endif()
    endforeach()
    execute_process(COMMAND "${_git}" -C "${root}" -c core.quotePath=false ls-files --cached --others --exclude-standard -- ${_pathspecs}
      RESULT_VARIABLE _status OUTPUT_VARIABLE _inventory ERROR_VARIABLE _error)
    if(NOT _status EQUAL 0)
      message(FATAL_ERROR "Public inventory failed: ${_error}")
    endif()
    string(REPLACE "\n" ";" _inventory "${_inventory}")
  else()
    set(_queue "")
    set(_inventory "")
    # Iterative walk prunes generated/private trees before visiting children.
    set(_queue ".")
    while(_queue)
      list(POP_BACK _queue _dir)
      file(GLOB _children RELATIVE "${root}" "${root}/${_dir}/*")
      foreach(_path IN LISTS _children)
        sic_public_path("${_path}" _public)
        if(NOT _public)
          continue()
        elseif(IS_SYMLINK "${root}/${_path}")
          message(FATAL_ERROR "Public symlink: ${_path}")
        elseif(IS_DIRECTORY "${root}/${_path}")
          list(APPEND _queue "${_path}")
        else()
          list(APPEND _inventory "${_path}")
        endif()
      endforeach()
    endwhile()
  endif()
  set(_files "")
  foreach(_path IN LISTS _inventory)
    if(_path STREQUAL "")
      continue()
    endif()
    sic_public_path("${_path}" _public)
    if(_public AND EXISTS "${root}/${_path}" AND NOT IS_DIRECTORY "${root}/${_path}")
      if(IS_SYMLINK "${root}/${_path}")
        message(FATAL_ERROR "Public symlink: ${_path}")
      endif()
      list(APPEND _files "${_path}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES _files)
  list(SORT _files)
  set(${result} "${_files}" PARENT_SCOPE)
endfunction()
