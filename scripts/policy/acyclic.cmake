# Edges use hashed vertex identifiers; every owning file/folder is a vertex.
function(sic_acyclic kind nodes edges)
  foreach(_edge IN LISTS edges)
    string(REPLACE "|" ";" _pair "${_edge}")
    list(GET _pair 0 _from)
    list(GET _pair 1 _to)
    string(SHA256 _a "${_from}")
    string(SHA256 _b "${_to}")
    list(APPEND _next_${_a} "${_b}")
    set(_name_${_a} "${_from}")
    set(_name_${_b} "${_to}")
  endforeach()
  foreach(_node IN LISTS nodes)
    string(SHA256 _id "${_node}")
    if(_done_${_id})
      continue()
    endif()
    set(_stack "${_id}")
    while(_stack)
      list(GET _stack -1 _at)
      set(_active_${_at} TRUE)
      if(_next_${_at})
        list(POP_BACK _next_${_at} _child)
        if(_active_${_child})
          set(_cycle "")
          foreach(_part IN LISTS _stack)
            list(APPEND _cycle "${_name_${_part}}")
          endforeach()
          message(FATAL_ERROR "${kind} cycle: ${_cycle};${_name_${_child}}")
        elseif(NOT _done_${_child})
          list(APPEND _stack "${_child}")
        endif()
      else()
        set(_active_${_at} FALSE)
        set(_done_${_at} TRUE)
        list(POP_BACK _stack)
      endif()
    endwhile()
  endforeach()
endfunction()
