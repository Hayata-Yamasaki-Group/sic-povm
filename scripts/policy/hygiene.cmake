cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/public_files.cmake")
if(NOT DEFINED ROOT)
  get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
endif()
if(NOT DEFINED ALLOWLIST)
  set(ALLOWLIST "${CMAKE_CURRENT_LIST_DIR}/hygiene_allowlist.txt")
endif()
# Exact path, rule and complete-line digest bind each reviewed exception.
# Adding another match to an allowed line invalidates its digest.
file(STRINGS "${ALLOWLIST}" _rows)
set(_allowed "")
foreach(_row IN LISTS _rows)
  if(_row STREQUAL "" OR _row MATCHES "^#")
    continue()
  endif()
  if(NOT _row MATCHES "^([^|]+)[|]([1-9]|1[0-3])[|]([0-9a-f]+)[|]([^|]+)$")
    message(FATAL_ERROR "Invalid hygiene allowance: ${_row}")
  endif()
  string(LENGTH "${CMAKE_MATCH_3}" _length)
  if(NOT _length EQUAL 64)
    message(FATAL_ERROR "Invalid hygiene allowance digest: ${_row}")
  endif()
  list(APPEND _allowed "${CMAKE_MATCH_1}|${CMAKE_MATCH_2}|${CMAKE_MATCH_3}")
endforeach()
set(_word "(^|[^A-Za-z0-9_])")
set(_end "([^A-Za-z0-9_]|$)")
set(_pattern_1 "${_word}(R[0-9]+(-[A-Z0-9]+)?|P[0-9][a-e]?|Q[0-9]+|S[0-9]C|r[0-9]+-[a-z][A-Za-z0-9_-]*|P-[A-Z][A-Z][A-Z]+)${_end}")
set(_pattern_2 "${_word}((step|round) [0-9]+|gate [a-e])${_end}|pre-freeze|release-freeze")
set(_pattern_3 "${_word}worktrees?${_end}")
# Load local, non-distributed tool configuration when present.
include("${CMAKE_CURRENT_LIST_DIR}/../../private/policy/hygiene_local.cmake" OPTIONAL)
if(DEFINED _local_hygiene_words)
  string(APPEND _pattern_3 "|${_word}(${_local_hygiene_words})${_end}|${_local_hygiene_fragments}")
endif()
set(_pattern_4 "${_word}(legacy|historical|previously|old format|former|formerly|superseded|old name|no longer|catalogue v[0-9]+|(kept|retained|preserved|maintained) for (source |backward |backwards )?compatibility|before this change|moved from|renamed from|deprecated|for backward compatibility|compatibility alias|since commit [0-9a-f]+)${_end}")
set(_pattern_5 [=[goldens-v[0-9]+|reader2|sic_release|sic_convert|sicx_reader2|SicxProducer|[.]sic[34]([^A-Za-z0-9_]|$)|results[/][0-9]+]=])
set(_pattern_6 "docs/(cli|clifford-tools|conventions|data-[^/ \t\r\n\"<>]*|index|library-api|reproducibility|sicx-spec)[.]md|cpp/(README[.]md|docs/|tools/[^/ \t\r\n\"<>]+/README[.]md|apps/README[.]md)")
set(_month "(January|Jan|February|Feb|March|Mar|April|Apr|May|June|Jun|July|Jul|August|Aug|September|Sep|October|Oct|November|Nov|December|Dec)")
set(_pattern_7 "${_word}[12][0-9][0-9][0-9][-/.][01][0-9][-/.][0-3][0-9]${_end}|${_word}${_month} [0-3]?[0-9],? [12][0-9][0-9][0-9]${_end}|${_word}[0-3]?[0-9] ${_month} [12][0-9][0-9][0-9]${_end}")
# Context distinguishes prose labels from mathematical identifiers and wire-format names.
set(_pattern_8 "${_word}original[^\n]* (producer|version|build)${_end}")
set(_pattern_9 "(^|[^A-Za-z0-9_-])(v[0-9]+[ ]+([a-z]+[ ]+)?(fixture|file|build|producer|experiment|label)|((fixture|file|build|producer|experiment|label|experiments)[ ]+([a-z0-9.]+[ ]+)?v[0-9]+))${_end}")
set(_pattern_10 "${_word}tree v[0-9]+${_end}|${_word}(build|experiment)[ ]+[A-Za-z0-9_-]+-v[0-9]+${_end}|${_word}[A-Za-z0-9_-]+-v[0-9]+[ ]+(build|experiment)${_end}")
set(_pattern_13 "${_word}[a-z0-9]+(-[a-z0-9]+)+-v[0-9]+${_end}")
set(_pattern_12 "(^|[ \t])//[ \t]*v[0-9]+${_end}|//[^\n]*[(]v[0-9]+[)]|as in v[0-9]+${_end}")
set(_pattern_11 "${_word}[A-Z][0-9]+_[A-Z][A-Z0-9_]*${_end}")
sic_public_files("${ROOT}" _files)
set(_hits 0)
set(_bad 0)
set(_report "")
set(_used "")
foreach(_path IN LISTS _files)
  # Generated numerical payloads of a release tree are checked by the data layout
  # policy (names, roles, catalogue closure and digests). Manifests, the catalogue,
  # symmetry tables, the bundled inputs and the metadata of ray files remain subject
  # to hygiene.
  if(_path MATCHES "^data/d[1-9][0-9]*/m[1-9][0-9]*/c(0|[1-9][0-9]*)[.](csv|npy|mat|h5)$" OR
     _path MATCHES "^data/d[1-9][0-9]*/all[.]npz$")
    continue()
  endif()
  # Binary formats contain zero bytes in their headers. Inspect the prefix as
  # bytes rather than treating printable fragments of binary data as prose.
  file(READ "${ROOT}/${_path}" _prefix LIMIT 8192 HEX)
  string(REGEX MATCHALL ".." _bytes "${_prefix}")
  if("00" IN_LIST _bytes)
    continue()
  endif()
  file(READ "${ROOT}/${_path}" _text)
  # In a ray file only the numerical arrays are skipped; every other member,
  # including labels, rounding and error bounds, is scanned.
  if(_path MATCHES "^data/d[1-9][0-9]*/m[1-9][0-9]*/c(0|[1-9][0-9]*)[.]json$")
    # Text that does not parse as JSON is scanned in full.
    # The largest arrays go first, so each later parse reads a shorter text.
    foreach(_member "hp;values" "fp64;decimal" "fp64;values" "fp32;decimal" "fp32;values")
      string(JSON _reduced ERROR_VARIABLE _json_error REMOVE "${_text}" ${_member})
      if(NOT _json_error)
        set(_text "${_reduced}")
      endif()
    endforeach()
  endif()
  string(TOLOWER "${_text}" _lower)
  set(_candidate FALSE)
  foreach(_rule RANGE 1 13)
    if((_rule GREATER 1 AND _rule LESS 5) OR _rule EQUAL 8 OR _rule EQUAL 9 OR _rule EQUAL 10 OR _rule EQUAL 12 OR _rule EQUAL 13)
      set(_subject "${_lower}")
    else()
      set(_subject "${_text}")
    endif()
    if(_subject MATCHES "${_pattern_${_rule}}")
      set(_candidate TRUE)
    endif()
  endforeach()
  if(NOT _candidate)
    continue()
  endif()
  # Split without CMake list semantics: source lines can contain semicolons
  # and unbalanced square brackets.
  set(_number 0)
  while(NOT _text STREQUAL "")
    math(EXPR _number "${_number}+1")
    string(FIND "${_text}" "\n" _newline)
    if(_newline LESS 0)
      set(_line "${_text}")
      set(_text "")
    else()
      string(SUBSTRING "${_text}" 0 ${_newline} _line)
      math(EXPR _next "${_newline}+1")
      string(SUBSTRING "${_text}" ${_next} -1 _text)
    endif()
    string(REGEX REPLACE "\r$" "" _line "${_line}")
    string(TOLOWER "${_line}" _lower)
    foreach(_rule RANGE 1 13)
      if((_rule GREATER 1 AND _rule LESS 5) OR _rule EQUAL 8 OR _rule EQUAL 9 OR _rule EQUAL 10 OR _rule EQUAL 12 OR _rule EQUAL 13)
        set(_subject "${_lower}")
      else()
        set(_subject "${_line}")
      endif()
      if(NOT _subject MATCHES "${_pattern_${_rule}}")
        continue()
      endif()
      math(EXPR _hits "${_hits}+1")
      string(SHA256 _digest "${_line}")
      set(_key "${_path}|${_rule}|${_digest}")
      if(_key IN_LIST _allowed)
        set(_class "REVIEWED")
        list(APPEND _used "${_key}")
      else()
        set(_class "UNREVIEWED")
        math(EXPR _bad "${_bad}+1")
      endif()
      string(APPEND _report "${_class}|${_key}|${_number}|${_line}\n")
    endforeach()
  endwhile()
endforeach()
if(DEFINED REPORT)
  file(WRITE "${REPORT}" "${_report}")
endif()
if(_bad)
  message(FATAL_ERROR "Public hygiene: ${_bad} unreviewed hits.\n${_report}")
endif()
# Removing an allowed line must also remove its allowance.
foreach(_key IN LISTS _allowed)
  if(NOT _key IN_LIST _used)
    message(FATAL_ERROR "Unused hygiene allowance: ${_key}")
  endif()
endforeach()
list(LENGTH _files _count)
message(STATUS "Public hygiene passed: ${_count} files, ${_hits} reviewed hits")
