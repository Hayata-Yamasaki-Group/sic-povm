cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/public_files.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/acyclic.cmake")
if(NOT DEFINED ROOT)
  get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
endif()
set(_exceptions "")
if(NOT DEFINED EXCEPTIONS)
  set(EXCEPTIONS "${CMAKE_CURRENT_LIST_DIR}/layout_exceptions.txt")
endif()
file(STRINGS "${EXCEPTIONS}" _rows)
foreach(_row IN LISTS _rows)
  if(_row STREQUAL "" OR _row MATCHES "^#")
    continue()
  endif()
  if(NOT _row MATCHES "^([A-Z][0-9])\\|([^|]+)\\|([^|]+)$")
    message(FATAL_ERROR "Invalid policy exception: ${_row}")
  endif()
  set(_key "${CMAKE_MATCH_1}|${CMAKE_MATCH_2}")
  if(_key IN_LIST _exceptions)
    message(FATAL_ERROR "Duplicate policy exception: ${_key}")
  endif()
  list(APPEND _exceptions "${_key}")
endforeach()
function(sic_layout_failure rule path detail)
  if(NOT "${rule}|${path}" IN_LIST _exceptions)
    message(FATAL_ERROR "${rule}: ${path}: ${detail}")
  endif()
  set_property(GLOBAL APPEND PROPERTY SIC_LAYOUT_USED "${rule}|${path}")
endfunction()
sic_public_files("${ROOT}" _files)
# Includes perform many membership checks against the same inventory.
foreach(_path IN LISTS _files)
  string(SHA256 _file_id "${_path}")
  set(_file_${_file_id} TRUE)
endforeach()
set(_nodes "")
set(_edges "")
set(_folders "")
set(_folder_edges "")
foreach(_path IN LISTS _files)
  get_filename_component(_dir "${_path}" DIRECTORY)
  if(_path MATCHES "^docs/" AND NOT _dir MATCHES "^docs(/[a-z0-9_]+)*$")
    sic_layout_failure(F1 "${_path}" "documentation directories must be lower_snake_case")
  endif()
  if(_path MATCHES "^docs/.*[.]md$" AND NOT _path MATCHES "^docs/([a-z0-9_]+/)*[a-z0-9_]+[.]md$")
    sic_layout_failure(F1 "${_path}" "documentation topic filename must be lower_snake_case")
  endif()
  string(SHA256 _id "${_dir}")
  math(EXPR _count_${_id} "0${_count_${_id}} + 1")
  # A release multiplet folder holds the files of every fiducial vector of the multiplet,
  # as fixed by the data contract and checked by the data layout policy.
  if(_count_${_id} GREATER 20 AND NOT _dir MATCHES "^data/d[1-9][0-9]*/m[1-9][0-9]*$")
    sic_layout_failure(D1 "${_dir}" "more than 20 direct regular files")
  endif()
  string(REPLACE "/" ";" _parts "${_path}")
  foreach(_part IN LISTS _parts)
    get_filename_component(_stem "${_part}" NAME_WE)
    string(TOLOWER "${_stem}" _stem)
    if(_stem MATCHES "^(util|utils|misc|common|internal|helpers)$")
      sic_layout_failure(F5 "${_path}" "undefined implementation stem or folder")
    endif()
  endforeach()
  string(TOLOWER "${_path}" _lower_path)
  if(NOT _lower_path MATCHES "[.](cpp|cc|cxx|c|h|hpp|hxx|tpp|mjs|sh|cmake)$" AND
     NOT _path MATCHES "(^|/)CMakeLists[.]txt$")
    continue()
  endif()
  if(_lower_path MATCHES "[.](cpp|cc|cxx|c|h|hpp|hxx|tpp)$" AND
     NOT _path MATCHES "^([a-z0-9_]+/)*[a-z0-9_]+([.]inl)?[.](cpp|cc|cxx|c|h|hpp|hxx|tpp)$")
    sic_layout_failure(F1 "${_path}" "C++ path is not lower_snake_case")
  endif()
  file(READ "${ROOT}/${_path}" _text)
  # Physical implementation lines; header declaration lines omit blank and
  # comment-only lines. Count a final unterminated line as a line too.
  string(REGEX REPLACE "\n$" "" _text "${_text}")
  # Semicolons are CMake list delimiters: count newlines directly instead.
  string(REGEX REPLACE "[^\n]+" "" _newlines "${_text}")
  string(LENGTH "${_newlines}" _line_count)
  if(NOT _text STREQUAL "")
    math(EXPR _line_count "${_line_count}+1")
  endif()
  if(_path MATCHES "[.](h|hpp|hxx)$")
    string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*+/" "" _declarations "${_text}")
    string(REGEX REPLACE "//[^\n]*" "" _declarations "${_declarations}")
    # Escape semicolons before converting declaration lines to a CMake list.
    string(REPLACE ";" "\\;" _declarations "${_declarations}")
    string(REPLACE "\n" ";" _declarations "${_declarations}")
    set(_line_count 0)
    foreach(_line IN LISTS _declarations)
      if(_line MATCHES "[^ \t\r]")
        math(EXPR _line_count "${_line_count}+1")
      endif()
    endforeach()
    set(_limit 300)
  else()
    set(_limit 1500)
  endif()
  if(_line_count GREATER _limit)
    sic_layout_failure(F3 "${_path}" "${_line_count} lines exceeds ${_limit}")
  endif()
  if(NOT _path MATCHES "[.](cpp|cc|cxx|c|h|hpp|hxx|tpp)$")
    continue()
  endif()
  list(APPEND _nodes "${_path}")
  list(APPEND _folders "${_dir}")
  string(REGEX MATCHALL "(^|\n)[ \t]*#[ \t]*include[ \t]*[\"<][^\">\n]+[\">]" _includes "${_text}")
  foreach(_include IN LISTS _includes)
    string(REGEX REPLACE "^[^\"<]*[\"<]([^\">]+)[\">]$" "\\1" _name "${_include}")
    set(_candidates "${_dir}/${_name}" "cpp/${_name}" "cpp/src/${_name}" "cpp/include/${_name}")
    if(_path MATCHES "^cpp/checkers/([^/]+)/")
      list(INSERT _candidates 1 "cpp/checkers/${CMAKE_MATCH_1}/src/${_name}")
    endif()
    foreach(_candidate IN LISTS _candidates)
      get_filename_component(_absolute "${ROOT}/${_candidate}" ABSOLUTE)
      file(RELATIVE_PATH _target "${ROOT}" "${_absolute}")
      string(SHA256 _file_id "${_target}")
      if(DEFINED _file_${_file_id})
        list(APPEND _edges "${_path}|${_target}")
        get_filename_component(_target_dir "${_target}" DIRECTORY)
        if(NOT _dir STREQUAL _target_dir)
          list(APPEND _folder_edges "${_dir}|${_target_dir}")
        endif()
        break()
      endif()
    endforeach()
    if(_name MATCHES "^sic/" AND NOT DEFINED _file_${_file_id})
      message(FATAL_ERROR "Unresolved public project include: ${_path}: ${_name}")
    endif()
  endforeach()
endforeach()
get_property(_used GLOBAL PROPERTY SIC_LAYOUT_USED)
foreach(_exception IN LISTS _exceptions)
  if(NOT _exception IN_LIST _used)
    message(FATAL_ERROR "Unused layout exception: ${_exception}")
  endif()
endforeach()
list(REMOVE_DUPLICATES _folders)
list(REMOVE_DUPLICATES _edges)
list(REMOVE_DUPLICATES _folder_edges)
sic_acyclic("File include" "${_nodes}" "${_edges}")
sic_acyclic("Folder include" "${_folders}" "${_folder_edges}")
if(DEFINED BUILD)
  execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${BUILD}" -N -V
    RESULT_VARIABLE _status OUTPUT_VARIABLE _manifest ERROR_VARIABLE _error TIMEOUT 5)
  if(NOT _status EQUAL 0)
    message(FATAL_ERROR "CTest inventory failed: ${_error}")
  endif()
  string(REPLACE ";" "\\;" _manifest "${_manifest}")
  string(REPLACE "\n" ";" _lines "${_manifest}")
  set(_layers 0)
  set(_registered 0)
  foreach(_line IN LISTS _lines)
    if(_line MATCHES "^Labels: (.*)$")
      separate_arguments(_labels UNIX_COMMAND "${CMAKE_MATCH_1}")
      foreach(_label IN LISTS _labels)
        if(_label MATCHES "^(unit|integration|e2e)$")
          math(EXPR _layers "${_layers}+1")
        endif()
      endforeach()
    elseif(_line MATCHES "^ *Test +#[0-9]+: (.+)$")
      if(NOT _layers EQUAL 1)
        message(FATAL_ERROR "Registered test ${CMAKE_MATCH_1} has ${_layers} primary layer labels")
      endif()
      math(EXPR _registered "${_registered}+1")
      set(_layers 0)
    elseif(_line MATCHES "^Total Tests: ([0-9]+)$")
      set(_total "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  if(NOT _registered GREATER 0 OR NOT _registered EQUAL _total)
    message(FATAL_ERROR "Incomplete CTest inventory: read ${_registered} of ${_total}")
  endif()
endif()
list(LENGTH _files _count)
message(STATUS "Public layout policy passed: ${_count} files")
