cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED WORK)
  message(FATAL_ERROR "WORK is required")
endif()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
file(WRITE "${WORK}/exceptions.txt" "")
function(check_control name expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${WORK}/${name}"
    "-DEXCEPTIONS=${WORK}/exceptions.txt" -P "${CMAKE_CURRENT_LIST_DIR}/layout.cmake"
    RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 5)
  if(_status EQUAL 0 OR NOT "${_stdout}${_stderr}" MATCHES "${expected}")
    message(FATAL_ERROR "Policy negative control ${name} failed: ${_status}: ${_stdout}${_stderr}")
  endif()
endfunction()
file(MAKE_DIRECTORY "${WORK}/crowded")
foreach(_i RANGE 1 21)
  file(WRITE "${WORK}/crowded/file_${_i}.txt" "")
endforeach()
check_control(crowded "D1:")
# Only release multiplet folders may hold more files; other data folders may not.
foreach(_i RANGE 1 21)
  file(WRITE "${WORK}/data_crowded/data/d8/file_${_i}.txt" "")
endforeach()
check_control(data_crowded "D1: data/d8:")
file(MAKE_DIRECTORY "${WORK}/stem")
file(WRITE "${WORK}/stem/util.hpp" "#pragma once\n")
check_control(stem "F5:")
file(MAKE_DIRECTORY "${WORK}/cycle")
file(WRITE "${WORK}/cycle/a.hpp" "#include \"b.hpp\"\n")
file(WRITE "${WORK}/cycle/b.hpp" "#include \"a.hpp\"\n")
check_control(cycle "File include cycle:")
# A positive control prevents a broken inventory from satisfying negatives.
file(MAKE_DIRECTORY "${WORK}/valid")
file(WRITE "${WORK}/valid/value.hpp" "#pragma once\nstruct Value {};\n")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${WORK}/valid" "-DEXCEPTIONS=${WORK}/exceptions.txt"
  -P "${CMAKE_CURRENT_LIST_DIR}/layout.cmake" RESULT_VARIABLE _status
  OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 5)
if(NOT _status EQUAL 0 OR NOT _stdout MATCHES "passed: 1 files")
  message(FATAL_ERROR "Positive inventory control failed: ${_stdout}${_stderr}")
endif()
foreach(_i RANGE 1 21)
  file(WRITE "${WORK}/data_multiplet/data/d8/m1/c${_i}.csv" "")
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${WORK}/data_multiplet" "-DEXCEPTIONS=${WORK}/exceptions.txt"
  -P "${CMAKE_CURRENT_LIST_DIR}/layout.cmake" RESULT_VARIABLE _status
  OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 5)
if(NOT _status EQUAL 0 OR NOT _stdout MATCHES "passed: 21 files")
  message(FATAL_ERROR "Release multiplet folder control failed: ${_stdout}${_stderr}")
endif()
message(STATUS "Layout negative and positive controls passed")
# Exercise the Git inventory with untracked public and excluded entries.
find_program(_git git)
if(_git)
set(_git_control "${WORK}/git_inventory")
set(_excluded_root "results")
file(MAKE_DIRECTORY "${_git_control}/${_excluded_root}")
execute_process(COMMAND "${_git}" init -q "${_git_control}"
  RESULT_VARIABLE _status ERROR_VARIABLE _error)
if(NOT _status EQUAL 0)
  message(FATAL_ERROR "Cannot initialize inventory control: ${_error}")
endif()
file(WRITE "${_git_control}/public.txt" "public\n")
file(WRITE "${_git_control}/${_excluded_root}/private.txt" "private\n")
include("${CMAKE_CURRENT_LIST_DIR}/public_files.cmake")
sic_public_files("${_git_control}" _selected)
if(NOT _selected STREQUAL "public.txt")
  message(FATAL_ERROR "Git untracked inventory control failed: ${_selected}")
endif()
else()
  message(STATUS "Git inventory control skipped: Git not found")
endif()
# Additional rule controls cover sizes, naming, directory aggregation and
# labels as CTest actually registers them (including missing labels).
file(MAKE_DIRECTORY "${WORK}/implementation_size")
string(REPEAT "// Physical implementation line\n" 1501 _large)
file(WRITE "${WORK}/implementation_size/large.cpp" "${_large}")
check_control(implementation_size "F3:")
file(MAKE_DIRECTORY "${WORK}/cmake_size")
string(REPEAT "# Physical registration line\n" 1501 _large)
file(WRITE "${WORK}/cmake_size/CMakeLists.txt" "${_large}")
check_control(cmake_size "F3:")
file(MAKE_DIRECTORY "${WORK}/header_size")
string(REPEAT "int declaration;\n" 301 _large)
file(WRITE "${WORK}/header_size/large.hpp" "${_large}")
check_control(header_size "F3:")
file(MAKE_DIRECTORY "${WORK}/naming")
file(WRITE "${WORK}/naming/BadName.hpp" "#pragma once\n")
check_control(naming "F1:")
file(MAKE_DIRECTORY "${WORK}/docs_naming/docs")
file(WRITE "${WORK}/docs_naming/docs/bad-name.md" "")
check_control(docs_naming "F1:")
file(MAKE_DIRECTORY "${WORK}/extension_case")
file(WRITE "${WORK}/extension_case/value.CPP" "// Invalid extension case\n")
check_control(extension_case "F1:")
file(MAKE_DIRECTORY "${WORK}/folder_cycle/one" "${WORK}/folder_cycle/two")
file(WRITE "${WORK}/folder_cycle/one/a.hpp" "#include \"../two/b.hpp\"\n")
file(WRITE "${WORK}/folder_cycle/two/b.hpp" "#include \"../one/value.hpp\"\n")
file(WRITE "${WORK}/folder_cycle/one/value.hpp" "#pragma once\n")
check_control(folder_cycle "Folder include cycle:")
file(MAKE_DIRECTORY "${WORK}/angle_cycle/cpp/include/sic")
file(WRITE "${WORK}/angle_cycle/cpp/include/sic/a.hpp" "#include <sic/b.hpp>\n")
file(WRITE "${WORK}/angle_cycle/cpp/include/sic/b.hpp" "#include <sic/a.hpp>\n")
check_control(angle_cycle "File include cycle:")
file(MAKE_DIRECTORY "${WORK}/unresolved")
file(WRITE "${WORK}/unresolved/value.hpp" "#include <sic/missing.hpp>\n")
check_control(unresolved "Unresolved public project include:")
foreach(_mode missing conflicting)
  set(_source "${WORK}/labels_${_mode}")
  file(MAKE_DIRECTORY "${_source}")
  set(_labels "")
  if(_mode STREQUAL "conflicting")
    set(_labels "set_tests_properties(synthetic PROPERTIES LABELS \"unit;integration\")\n")
  endif()
  file(WRITE "${_source}/CMakeLists.txt"
    "cmake_minimum_required(VERSION 3.20)\nproject(policy_control NONE)\nenable_testing()\nadd_test(NAME synthetic COMMAND \"${CMAKE_COMMAND}\" -E true)\n${_labels}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${_source}" -B "${_source}/build"
    RESULT_VARIABLE _status OUTPUT_QUIET ERROR_VARIABLE _error TIMEOUT 5)
  if(NOT _status EQUAL 0)
    message(FATAL_ERROR "Cannot register label control: ${_error}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${_source}"
    "-DBUILD=${_source}/build" "-DEXCEPTIONS=${WORK}/exceptions.txt" -P "${CMAKE_CURRENT_LIST_DIR}/layout.cmake"
    RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 5)
  if(_status EQUAL 0 OR NOT "${_stdout}${_stderr}" MATCHES "primary layer labels")
    message(FATAL_ERROR "Registered-label control failed: ${_stdout}${_stderr}")
  endif()
endforeach()
message(STATUS "Size, naming, folder/angle include and registered-label controls passed")

# CMake conventional capitalization does not permit an undefined bucket.
