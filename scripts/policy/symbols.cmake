cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/acyclic.cmake")
include("${BUILD}/policy-symbol-targets.cmake")
file(READ "${BUILD}/compile_commands.json" _commands)
string(JSON _count LENGTH "${_commands}")
math(EXPR _last "${_count}-1")
set(_objects "")
set(_nodes "")
set(_folders "")
foreach(_i RANGE 0 ${_last})
  string(JSON _command GET "${_commands}" ${_i} command)
  string(JSON _source GET "${_commands}" ${_i} file)
  string(JSON _directory GET "${_commands}" ${_i} directory)
  if(NOT _command MATCHES "CMakeFiles/([^/]+)[.]dir/")
    continue()
  endif()
  set(_target "${CMAKE_MATCH_1}")
  if(NOT _target IN_LIST PRODUCTION)
    continue()
  endif()
  if(NOT _command MATCHES " -o ([^ ]+) ")
    message(FATAL_ERROR "Cannot associate compiler object: ${_source}")
  endif()
  set(_object "${CMAKE_MATCH_1}")
  string(REGEX REPLACE "^\"(.*)\"$" "\\1" _object "${_object}")
  get_filename_component(_object "${_object}" ABSOLUTE BASE_DIR "${_directory}")
  if(NOT EXISTS "${_object}")
    message(FATAL_ERROR "Missing built production object: ${_object}")
  endif()
  file(RELATIVE_PATH _source "${ROOT}" "${_source}")
  string(SHA256 _key "${_object}")
  set(_source_${_key} "${_source}")
  list(APPEND _objects "${_object}")
  list(APPEND _nodes "${_source}")
  get_filename_component(_folder "${_source}" DIRECTORY)
  list(APPEND _folders "${_folder}")
endforeach()
if(NOT _objects)
  message(FATAL_ERROR "No built production objects found")
endif()
# One binutils invocation; raw Itanium names preserve exact overload identity.
execute_process(COMMAND "${NM}" -A -P ${_objects} RESULT_VARIABLE _status
  OUTPUT_VARIABLE _symbols ERROR_VARIABLE _error TIMEOUT 15)
if(NOT _status EQUAL 0)
  message(FATAL_ERROR "nm failed: ${_error}")
endif()
string(REPLACE "\n" ";" _symbols "${_symbols}")
set(_undefined "")
set(_defined "")
foreach(_line IN LISTS _symbols)
  if(NOT _line MATCHES "^(.+): ([^ ]*3sic[^ ]*) ([A-Za-z])($| )")
    continue()
  endif()
  set(_object "${CMAKE_MATCH_1}")
  set(_symbol "${CMAKE_MATCH_2}")
  set(_type "${CMAKE_MATCH_3}")
  string(SHA256 _object_key "${_object}")
  string(SHA256 _key "${_symbol}")
  set(_source "${_source_${_object_key}}")
  if(NOT _source)
    message(FATAL_ERROR "nm returned an unassociated object: ${_object}")
  endif()
  if(_type STREQUAL "U")
    list(APPEND _undefined "${_source}|${_key}")
  elseif(NOT _type MATCHES "^[uvw]$")
    list(APPEND _definitions_${_key} "${_source}")
    list(APPEND _defined "${_key}")
    if(NOT _type MATCHES "^[WV]$")
      list(APPEND _strong_${_key} "${_source}")
    endif()
  endif()
endforeach()
foreach(_key IN LISTS _defined)
  if(_strong_${_key})
    set(_owners_${_key} "${_strong_${_key}}")
  else()
    set(_owners_${_key} "${_definitions_${_key}}")
  endif()
  list(REMOVE_DUPLICATES _owners_${_key})
endforeach()
set(_edges "")
set(_folder_edges "")
set(_unresolved 0)
foreach(_reference IN LISTS _undefined)
  string(REPLACE "|" ";" _pair "${_reference}")
  list(GET _pair 0 _caller)
  list(GET _pair 1 _key)
  set(_owners "${_owners_${_key}}")
  if(NOT _owners)
    math(EXPR _unresolved "${_unresolved}+1")
    continue()
  endif()
  list(LENGTH _owners _count)
  if(_count GREATER 1 AND _caller IN_LIST _owners)
    continue()
  endif()
  foreach(_owner IN LISTS _owners)
    if(_caller STREQUAL _owner)
      continue()
    endif()
    list(APPEND _edges "${_caller}|${_owner}")
    get_filename_component(_from "${_caller}" DIRECTORY)
    get_filename_component(_to "${_owner}" DIRECTORY)
    if(NOT _from STREQUAL _to)
      list(APPEND _folder_edges "${_from}|${_to}")
    endif()
  endforeach()
endforeach()
list(REMOVE_DUPLICATES _nodes)
list(REMOVE_DUPLICATES _folders)
list(REMOVE_DUPLICATES _edges)
list(REMOVE_DUPLICATES _folder_edges)
sic_acyclic("File symbol" "${_nodes}" "${_edges}")
sic_acyclic("Folder symbol" "${_folders}" "${_folder_edges}")
sic_acyclic("Production link" "${PRODUCTION}" "${LINKS}")
list(LENGTH _objects _object_count)
list(LENGTH _edges _edge_count)
message(STATUS "Symbol policy passed: ${_object_count} objects, ${_edge_count} edges, ${_unresolved} external/unresolved references")
