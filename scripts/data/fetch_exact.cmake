# One multiplet of the exact-data target. Variables: SICX DUMP SPEC DATA_ROOT SOURCE OUT_ROOT JOBS EXACT_FACTOR.
# Fetches OUT_ROOT/<SPEC>/exact.sicx (verified, atomic), then generates exact.json beside it when DUMP is set.
set(parts "${DATA_ROOT}/${SPEC}/multiplet.sicx.parts.json")
file(READ "${parts}" _text)
string(REGEX MATCH "\"schema\":\"[^\"]*\",\"sha256\":\"[0-9a-f]+\",\"size_bytes\":\"([0-9]+)\"" _top "${_text}")
set(size "${CMAKE_MATCH_1}")
if(NOT size)
  message(FATAL_ERROR "cannot read size_bytes from ${parts}")
endif()
math(EXPR extra "${size} * ${EXACT_FACTOR}")
set(args fetch "${SPEC}" --data-root "${DATA_ROOT}" --out "${OUT_ROOT}/${SPEC}" --name exact.sicx --threads ${JOBS} --extra-bytes ${extra})
if(SOURCE)
  list(APPEND args --source "${SOURCE}")
endif()
execute_process(COMMAND "${SICX}" ${args} RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "sic-container fetch ${SPEC} failed")
endif()
if(DUMP AND NOT EXISTS "${OUT_ROOT}/${SPEC}/exact.json")
  string(REGEX REPLACE "^d[0-9]+/" "" mn "${SPEC}")
  execute_process(COMMAND "${DUMP}" "${OUT_ROOT}/${SPEC}/exact.sicx" --exact-json "${OUT_ROOT}/${SPEC}/exact.json" --multiplet "${mn}"
    RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "exact.json generation failed for ${SPEC}")
  endif()
elseif(NOT DUMP)
  message(STATUS "TODO: exact.json not generated (sic-inspect --exact-json unavailable)")
endif()
