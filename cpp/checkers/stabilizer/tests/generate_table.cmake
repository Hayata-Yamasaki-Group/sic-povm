include("${REPO}/cpp/tests/data/generate.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(root "${WORK}/release")
if(WRONG_ELEMENT)
  sic_generate_wh("${BIN}" "${WORK}/standard" 3 standard)
  sic_generate_layout("${BIN}" "${root}" "${WORK}/standard/multiplet.sicx" 1 8)
elseif(DIM EQUAL 2)
  sic_generate_d2("${BIN}" "${WORK}")
  sic_generate_layout("${BIN}" "${root}" "${WORK}/d2.sicx" 1 2)
elseif(DIM EQUAL 8)
  sic_generate_wh("${BIN}" "${WORK}/maximal" 3 maximal)
  sic_generate_wh("${BIN}" "${WORK}/standard" 3 standard)
  sic_generate_layout("${BIN}" "${root}" "${WORK}/maximal/multiplet.sicx" 1 8)
  sic_generate_layout("${BIN}" "${root}" "${WORK}/standard/multiplet.sicx" 2 8)
elseif(DIM EQUAL 4)
  sic_generate_wh("${BIN}" "${WORK}" 2 standard)
  sic_generate_layout("${BIN}" "${root}" "${WORK}/multiplet.sicx" 1 4)
else()
  sic_generate_wh("${BIN}" "${WORK}" 4 standard)
  sic_generate_layout("${BIN}" "${root}" "${WORK}/multiplet.sicx" 1 16)
endif()
sic_run("${BIN}/sic-inspect" --catalogue "${root}")
if(TSV)
  set(dir "${root}/d2/m1")
  sic_run("${BIN}/sic-decode" "${WORK}/d2.sicx" "${WORK}/high-precision" --threads 1 --no-pin
    --target-bits 256 --initial-bits 384)
  configure_file("${WORK}/high-precision/c0.normalized.balls" "${dir}/normalized-gauged.balls" COPYONLY)
  file(WRITE "${WORK}/catalogue.tsv" "2 d2-m1-c0 standard test ${dir}/c0.csv\n")
  set(catalogue "${WORK}/catalogue.tsv")
else()
  set(catalogue "${root}/catalogue.json")
endif()
sic_run("${BIN}/sic-stabilizer" --dim "${DIM}" --catalogue "${catalogue}" --out "${WORK}/stabilizers.txt")
if(WRONG_ELEMENT)
  file(WRITE "${WORK}/wrong.txt"
    "# sic-stabilizers/1.0\nray d8-m1-c0 d 8 order standard status test group_order 2 unitary_order 2\n"
    "elem d8-m1-c0 0 det +1 F 1 0 0 1 chi 0 0 order 1 trace 2 z_dev 0 residual 0\n"
    "elem d8-m1-c0 1 det +1 F 1 0 0 1 chi 1 0 order 8 trace 2 z_dev 0 residual 0\nend 1\n")
  execute_process(COMMAND "${CHECKER}" "${WORK}/wrong.txt" --catalogue "${catalogue}" --dim 8
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc STREQUAL "1" OR NOT out MATCHES "cert d8-m1-c0 1 det [+]1 [^\n]* FAIL\ncertified 1 non-identity elements")
    message(FATAL_ERROR "wrong displacement was not rejected numerically: ${rc}\n${out}${err}")
  endif()
elseif(CHECKER)
  execute_process(COMMAND "${CHECKER}" "${WORK}/stabilizers.txt" --catalogue "${catalogue}"
    --dim "${DIM}" --d2-exact "${REPO}/data/d2/d2.sicrad"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc STREQUAL "0" OR NOT out MATCHES "certified [1-9][0-9]* non-identity elements.*precision 384 bits: PASS")
    message(FATAL_ERROR "stabilizer certificate: ${rc}\n${out}${err}")
  endif()
  message(STATUS "${out}")
endif()
