foreach(bad 63 100001 64x)
  execute_process(COMMAND "${PARSER}" unused --repo unused --prec "${bad}" RESULT_VARIABLE rc OUTPUT_VARIABLE out)
  if(NOT rc EQUAL 2 OR out MATCHES "prec=")
    message(FATAL_ERROR "precision refusal failed: ${bad}")
  endif()
endforeach()
foreach(bad 1x)
  execute_process(COMMAND "${PARSER}" unused --repo unused --threshold "${bad}" RESULT_VARIABLE rc OUTPUT_VARIABLE out)
  if(NOT rc EQUAL 2 OR out MATCHES "prec=")
    message(FATAL_ERROR "threshold refusal failed: ${bad}")
  endif()
endforeach()
foreach(bits 64 100000)
  execute_process(COMMAND "${PARSER}" unused --repo unused --prec "${bits}" --threshold 0.25 RESULT_VARIABLE rc OUTPUT_VARIABLE out)
  if(NOT rc EQUAL 0 OR NOT out MATCHES "prec=${bits} threshold=2\\^-2")
    message(FATAL_ERROR "valid supplied values not passed through: ${bits} ${out}")
  endif()
endforeach()
foreach(bits 128 384)
  execute_process(COMMAND "${CHECKER}" "${ROOT}/data/d2/stabilizers.txt" --catalogue "${ROOT}/cpp/tests/data/catalogue.tsv" --repo "${ROOT}/cpp/tests/data" --d2-exact "${ROOT}/data/d2/d2.sicrad" --prec "${bits}" --threshold 1e-60 RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(bits EQUAL 128)
    if(NOT rc EQUAL 1 OR NOT out MATCHES "precision 128 bits: FAIL")
      message(FATAL_ERROR "low precision should fail: ${rc} ${out} ${err}")
    endif()
  elseif(NOT rc EQUAL 0 OR NOT out MATCHES "precision 384 bits: PASS")
    message(FATAL_ERROR "high precision should pass: ${rc} ${out} ${err}")
  endif()
endforeach()
