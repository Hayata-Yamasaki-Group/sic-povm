execute_process(COMMAND "${CHECKER}" --help RESULT_VARIABLE rc OUTPUT_VARIABLE help)
execute_process(COMMAND "${PARSER}" unused.sicx RESULT_VARIABLE parsed_rc OUTPUT_VARIABLE parsed)
if(NOT rc EQUAL 0 OR NOT parsed_rc EQUAL 0)
  message(FATAL_ERROR "help/default parser failed")
endif()
foreach(option threads seed integral-max-dim)
  if(NOT help MATCHES "--${option} [^\n]*default ([0-9]+)")
    message(FATAL_ERROR "default missing from help: ${help}")
  endif()
  set(value "${CMAKE_MATCH_1}")
  if(NOT parsed MATCHES "${option}=${value}( |\n)")
    message(FATAL_ERROR "help/parser defaults differ: ${option}: ${help} ${parsed}")
  endif()
endforeach()
foreach(pair "--seed|0|seed=0" "--seed|18446744073709551615|seed=18446744073709551615"
             "--integral-max-dim|0|integral-max-dim=0" "--integral-max-dim|2147483648|integral-max-dim=2147483648"
             "--primes|1048576|primes=1048576" "--prec|64|prec=64" "--prec|1048576|prec=1048576")
  string(REPLACE "|" ";" fields "${pair}")
  list(GET fields 0 option)
  list(GET fields 1 value)
  list(GET fields 2 expected)
  execute_process(COMMAND "${PARSER}" unused.sicx "${option}" "${value}" RESULT_VARIABLE rc OUTPUT_VARIABLE out)
  if(NOT rc EQUAL 0 OR NOT out MATCHES "${expected}( |\n)")
    message(FATAL_ERROR "boundary not forwarded: ${option} ${value}: ${rc} ${out}")
  endif()
endforeach()
