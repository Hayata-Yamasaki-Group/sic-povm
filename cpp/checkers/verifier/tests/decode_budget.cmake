# Check the CLI status as well as the coverage report.
if(CASE STREQUAL "full_low")
  set(args "${FIXTURE_D4}" --release --decode full --ray c0 --max-steps 0)
  set(status 3)
  set(pattern "RESULT: REFUSED: 1 requested rays were not checked; use --max-steps 3 to cover them")
elseif(CASE STREQUAL "full_sufficient")
  set(args "${FIXTURE_D4}" --release --decode full --max-steps 3)
  set(status 0)
  set(pattern "RESULT: PASS.*1 full [+] 0 ratio of 1 rays")
elseif(CASE STREQUAL "auto_low")
  set(args "${FIXTURE_D4}" --decode auto --max-steps 0)
  set(status 0)
  set(pattern "RESULT: PASS.*0 full [+] 1 ratio of 1 rays.*partial spot check")
elseif(CASE STREQUAL "full_mixed")
  set(args "${FIXTURE_D64}" --release --decode full --max-steps 91)
  set(status 3)
  set(pattern "RESULT: REFUSED: 2 requested rays were not checked; use --max-steps 92 to cover them")
elseif(CASE STREQUAL "auto_release")
  set(args "${FIXTURE_D64}" --release --decode auto --ray c3 --max-steps 0)
  set(status 0)
  set(pattern "RESULT: PASS.*0 full [+] 1 ratio of 1 rays.*partial spot check")
elseif(CASE STREQUAL "ratio_low")
  set(args "${FIXTURE_D64}" --release --decode ratio --ray c3 --max-steps 0)
  set(status 3)
  set(pattern "RESULT: REFUSED: 1 requested rays were not checked; use --max-steps 38 to cover them")
else()
  message(FATAL_ERROR "unknown case")
endif()
execute_process(COMMAND "${VERIFY}" ${args} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result STREQUAL "${status}" OR NOT output MATCHES "${pattern}")
  message(FATAL_ERROR "${CASE}: expected exit ${status} and ${pattern}, got ${result}\n${output}\n${error}")
endif()

if(CASE STREQUAL "auto_release" AND NOT output MATCHES "budget raised automatically")
  message(FATAL_ERROR "auto release fallback was not reported: ${output}")
endif()
