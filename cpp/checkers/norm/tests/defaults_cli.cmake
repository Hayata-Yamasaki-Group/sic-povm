execute_process(COMMAND "${CHECKER}" --help RESULT_VARIABLE rc OUTPUT_VARIABLE help)
execute_process(COMMAND "${PARSER}" unused.sicx RESULT_VARIABLE parsed_rc OUTPUT_VARIABLE parsed)
if(NOT rc EQUAL 0 OR NOT parsed_rc EQUAL 0)
  message(FATAL_ERROR "help/default parser failed")
endif()
foreach(option threads max-bits max-dimension max-field-dimension)
  if(NOT help MATCHES "--${option} [^\n]*default ([0-9]+)")
    message(FATAL_ERROR "default missing from help: ${help}")
  endif()
  set(value "${CMAKE_MATCH_1}")
  if(NOT parsed MATCHES "${option}=${value}( |\n)")
    message(FATAL_ERROR "help/parser defaults differ: ${option}: ${help} ${parsed}")
  endif()
endforeach()
execute_process(COMMAND "${PARSER}" unused.sicx --max-bits 9223372036854775807 --ray 0
  RESULT_VARIABLE rc OUTPUT_VARIABLE out)
if(NOT rc EQUAL 0 OR NOT out MATCHES "max-bits=9223372036854775807" OR NOT out MATCHES "ray=0")
  message(FATAL_ERROR "numeric boundary not forwarded: ${rc} ${out}")
endif()
