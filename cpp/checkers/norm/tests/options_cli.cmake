function(run expected pattern)
  execute_process(COMMAND "${CHECKER}" "${FIXTURE}" --threads 1 ${ARGN}
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
  if(NOT "${rc}" STREQUAL "${expected}" OR NOT out MATCHES "${pattern}")
    message(FATAL_ERROR "unexpected status/output: ${rc} ${out} ${err}")
  endif()
  set(last_output "${out}" PARENT_SCOPE)
endfunction()
if(CASE STREQUAL "estimate" OR CASE STREQUAL "leaf_estimate")
  string(REPLACE "_" "-" option "${CASE}")
  run(0 "${option}" "--${option}")
  if(last_output MATCHES "ALL CERTIFIED|EXACT SIC|\\[PROVED\\]")
    message(FATAL_ERROR "estimate claimed a certificate: ${last_output}")
  endif()
  run(2 "^$" "--${option}" --invalid-option)
elseif(CASE STREQUAL "max_bits")
  run(0 "summary: 1 rays, ALL CERTIFIED" --max-bits 1000)
  run(3 "REFUSED:" --max-bits 1)
  run(2 "^$" --max-bits)
elseif(CASE STREQUAL "max_dimension" OR CASE STREQUAL "max_field_dimension")
  string(REPLACE "_" "-" option "${CASE}")
  run(0 "FULL SICX input verification: PASS" --verify-input "--${option}" 16)
  run(3 "REFUSED:" --verify-input "--${option}" 1)
  run(2 "^$" --verify-input "--${option}" invalid)
else()
  message(FATAL_ERROR "unknown case")
endif()

# Every malformed numeric option is a usage error before any certificate work.
foreach(option --threads --ray --max-bits --max-dimension --max-field-dimension --partial-element --partial-chunk)
  foreach(bad invalid garbage -1 1x +1 " 1" 18446744073709551616)
    run(2 "^$" "${option}" "${bad}")
  endforeach()
endforeach()
foreach(option --threads --max-bits)
  run(2 "^$" "${option}" 0)
endforeach()
run(2 "^$" --max-bits 9223372036854775808)
run(2 "^$" --threads 4294967296)
