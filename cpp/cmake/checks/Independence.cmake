set_property(GLOBAL PROPERTY SIC_INDEPENDENT_CHECKERS "")
set_property(GLOBAL PROPERTY SIC_INDEPENDENT_PATHS "")

function(sic_add_independent_checker)
  cmake_parse_arguments(A "" "TARGET;DIRECTORY;EXPECTED_VIOLATION" "" ${ARGN})
  if(NOT TARGET ${A_TARGET})
    message(FATAL_ERROR "sic_add_independent_checker: no target ${A_TARGET}")
  endif()
  get_filename_component(_dir "${A_DIRECTORY}" ABSOLUTE)
  set_property(GLOBAL APPEND PROPERTY SIC_INDEPENDENT_CHECKERS ${A_TARGET})
  set_property(GLOBAL APPEND PROPERTY SIC_INDEPENDENT_PATHS "${_dir}")
  set(_expected 0)
  if(A_EXPECTED_VIOLATION)
    set(_expected 1)
  endif()
  set_property(TARGET ${A_TARGET} PROPERTY SIC_INDEPENDENT_DIRECTORY "${_dir}")
  set_property(TARGET ${A_TARGET} PROPERTY SIC_INDEPENDENT_EXPECTED "${A_EXPECTED_VIOLATION}")
  if(SIC_BUILD_TESTS)
    get_target_property(_bin ${A_TARGET} BINARY_DIR)
    string(REPLACE "-" "_" _checker_case "${A_TARGET}")
  sic_add_verdict_test(NAME sic_test_support_independence_${_checker_case} EXIT 0
      COMMAND ${CMAKE_COMMAND} -DTARGET=${A_TARGET} -DOBJECT_DIR=${_bin}/CMakeFiles/${A_TARGET}.dir
        -DBINARY_ROOT=${PROJECT_BINARY_DIR} -DSOURCE_ROOT=${PROJECT_SOURCE_DIR} -DCHECKER=${_dir}
        -DCHECKERS_FILE=${PROJECT_BINARY_DIR}/independent-checkers.txt
        -DSHINGLES=$<TARGET_FILE:sic-test-support-independence-shingles> "-DGENERATOR=${CMAKE_GENERATOR}"
        -DMAKE_PROGRAM=${CMAKE_MAKE_PROGRAM} -DEXPECTED=${_expected}
        -P ${PROJECT_SOURCE_DIR}/tests/independence/check_target.cmake)
    set_tests_properties(sic_test_support_independence_${_checker_case} PROPERTIES LABELS independence)
  endif()
endfunction()

# All targets defined in this project (every directory, recursively).
function(_sic_project_targets dir out)
  get_property(_t DIRECTORY "${dir}" PROPERTY BUILDSYSTEM_TARGETS)
  get_property(_subs DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
  foreach(_s ${_subs})
    _sic_project_targets("${_s}" _st)
    list(APPEND _t ${_st})
  endforeach()
  set(${out} ${_t} PARENT_SCOPE)
endfunction()

# Real target names in the link closure of a target (project targets and imported ones).
function(_sic_link_closure target out)
  set(_seen "")
  set(_queue ${target})
  while(_queue)
    list(POP_FRONT _queue _t)
    if(NOT TARGET ${_t})
      continue()
    endif()
    get_target_property(_aliased ${_t} ALIASED_TARGET)
    if(_aliased)
      set(_t ${_aliased})
    endif()
    if(_t IN_LIST _seen)
      continue()
    endif()
    list(APPEND _seen ${_t})
    get_target_property(_type ${_t} TYPE)
    set(_items "")
    if(NOT _type STREQUAL "INTERFACE_LIBRARY")
      get_target_property(_l ${_t} LINK_LIBRARIES)
      if(_l)
        list(APPEND _items ${_l})
      endif()
    endif()
    get_target_property(_il ${_t} INTERFACE_LINK_LIBRARIES)
    if(_il)
      list(APPEND _items ${_il})
    endif()
    foreach(_i ${_items})
      # unwrap generator expressions: keep every identifier-like token that names a target
      string(REGEX MATCHALL "[A-Za-z0-9_.+-]+(::[A-Za-z0-9_.+-]+)*" _tokens "${_i}")
      foreach(_tok ${_tokens})
        if(TARGET ${_tok})
          list(APPEND _queue ${_tok})
        endif()
      endforeach()
    endforeach()
  endwhile()
  list(REMOVE_ITEM _seen ${target})
  set(${out} ${_seen} PARENT_SCOPE)
endfunction()

function(sic_check_independence)
  get_property(_checkers GLOBAL PROPERTY SIC_INDEPENDENT_CHECKERS)
  get_property(_paths GLOBAL PROPERTY SIC_INDEPENDENT_PATHS)
  list(JOIN _paths "\n" _text)
  file(WRITE "${PROJECT_BINARY_DIR}/independent-checkers.txt" "${_text}\n")
  _sic_project_targets("${PROJECT_SOURCE_DIR}" _project)
  foreach(_c ${_checkers})
    get_target_property(_dir ${_c} SIC_INDEPENDENT_DIRECTORY)
    get_target_property(_expected ${_c} SIC_INDEPENDENT_EXPECTED)
    set(_problems "")
    _sic_link_closure(${_c} _closure)
    foreach(_t ${_closure})
      if(_t IN_LIST _project)
        list(APPEND _problems "links project target ${_t}")
      endif()
    endforeach()
    get_target_property(_inc ${_c} INCLUDE_DIRECTORIES)
    if(_inc)
      foreach(_d ${_inc})
        string(REGEX REPLACE "^\\$<BUILD_INTERFACE:(.*)>$" "\\1" _d "${_d}")
        get_filename_component(_d "${_d}" ABSOLUTE)
        string(FIND "${_d}/" "${_dir}/" _own)
        if(NOT _own EQUAL 0)
          foreach(_f include src apps tools tests experiments checkers)
            string(FIND "${_d}/" "${PROJECT_SOURCE_DIR}/${_f}/" _hit)
            if(_hit EQUAL 0)
              list(APPEND _problems "include directory ${_d}")
            endif()
          endforeach()
          string(FIND "${_d}/" "${PROJECT_BINARY_DIR}/" _hit)
          if(_hit EQUAL 0)
            list(APPEND _problems "include directory ${_d} (build tree)")
          endif()
        endif()
      endforeach()
    endif()
    if(_problems)
      list(JOIN _problems "; " _msg)
      if(_expected)
        message(STATUS "independence: ${_c}: known violation (${_expected}): ${_msg}")
      else()
        message(FATAL_ERROR "independence: ${_c} is not independent: ${_msg}")
      endif()
    else()
      message(STATUS "independence: ${_c}: link closure and include directories clean")
    endif()
  endforeach()
endfunction()

function(sic_add_independence_tests)
if(SIC_BUILD_TESTS)
  add_executable(sic-test-support-independence-shingles tests/independence/independence_shingles.cpp)
  target_compile_features(sic-test-support-independence-shingles PRIVATE cxx_std_20)
  add_test(NAME sic_test_support_independence_gp
    COMMAND ${CMAKE_COMMAND} -DGP_DIR=${PROJECT_SOURCE_DIR}/checkers/gp -DSOURCE_ROOT=${PROJECT_SOURCE_DIR}
      -P ${PROJECT_SOURCE_DIR}/tests/independence/check_gp.cmake)
  set_tests_properties(sic_test_support_independence_gp PROPERTIES LABELS independence TIMEOUT 120)
endif()
if(SIC_ENABLE_FLINT)
  if(SIC_BUILD_TESTS)
    foreach(_n d2 d4 d8 d8-maximal d16 d32)
      set(_f "${SIC_TEST_FIXTURES_DIR}/${_n}.sicx")
      string(REPLACE "-" "_" _sic_test_case_0 "sic_test_verifier_${_n}")
  sic_add_verdict_test(NAME ${_sic_test_case_0} EXIT 0 COMMAND sic-verify-independent "${_f}")
      set_tests_properties(${_sic_test_case_0} PROPERTIES LABELS "sicx;independence"
        PASS_REGULAR_EXPRESSION "RESULT: PASS")
      string(REPLACE "-" "_" _sic_test_case_1 "sic_test_verifier_release_${_n}")
  sic_add_verdict_test(NAME ${_sic_test_case_1} EXIT 0 COMMAND sic-verify-independent "${_f}" --release)
      set_tests_properties(${_sic_test_case_1} PROPERTIES LABELS "sicx;independence"
        PASS_REGULAR_EXPRESSION "RESULT: PASS")

    endforeach()
  endif()
endif()
endfunction()
