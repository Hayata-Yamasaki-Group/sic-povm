include_guard(GLOBAL)

# Preload observers and glibc RSS-release assertions require the native allocator.
function(sic_disable_test_with_sanitizer test)
  if(CMAKE_CONFIGURATION_TYPES)
    set(disabled_configs)
    foreach(configuration IN LISTS CMAKE_CONFIGURATION_TYPES)
      string(TOUPPER "${configuration}" configuration_upper)
      if("${CMAKE_CXX_FLAGS} ${CMAKE_CXX_FLAGS_${configuration_upper}}" MATCHES "-fsanitize=")
        list(APPEND disabled_configs "$<CONFIG:${configuration}>")
      endif()
    endforeach()
    if(disabled_configs)
      list(JOIN disabled_configs "," disabled_expression)
      set_tests_properties(${test} PROPERTIES DISABLED "$<OR:${disabled_expression}>")
    endif()
  else()
    string(TOUPPER "${CMAKE_BUILD_TYPE}" configuration_upper)
    if("${CMAKE_CXX_FLAGS} ${CMAKE_CXX_FLAGS_${configuration_upper}}" MATCHES "-fsanitize=")
      set_tests_properties(${test} PROPERTIES DISABLED TRUE)
    endif()
  endif()
endfunction()
