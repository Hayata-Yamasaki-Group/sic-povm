# Preserve output-verdict assertions while also enforcing process status.
function(sic_add_verdict_test)
  cmake_parse_arguments(V "" "NAME;EXIT" "COMMAND" ${ARGN})
  if(NOT DEFINED V_EXIT OR NOT V_EXIT MATCHES "^[0-9]+$")
    message(FATAL_ERROR "sic_add_verdict_test requires an explicit EXIT status")
  endif()
  list(POP_FRONT V_COMMAND program)
  if(TARGET "${program}")
    set(program "$<TARGET_FILE:${program}>")
  endif()
  add_test(NAME "${V_NAME}" COMMAND "${SIC_NODE_EXECUTABLE}"
    "${SIC_REPO_ROOT}/scripts/docs/exit_status.mjs" "${V_EXIT}" "${program}" ${V_COMMAND})
  set_property(GLOBAL APPEND PROPERTY SIC_VERDICT_TESTS "${V_NAME}")
  set_property(GLOBAL PROPERTY "SIC_VERDICT_DIRECTORY_${V_NAME}" "${CMAKE_CURRENT_SOURCE_DIR}")
endfunction()
function(sic_guard_verdict_status)
  get_property(tests DIRECTORY PROPERTY TESTS)
  foreach(test IN LISTS tests)
    get_property(guarded GLOBAL PROPERTY "SIC_VERDICT_DIRECTORY_${test}")
    if(guarded)
      set_property(TEST "${test}" APPEND PROPERTY FAIL_REGULAR_EXPRESSION "SIC_UNEXPECTED_EXIT_STATUS")
    endif()
  endforeach()
endfunction()
