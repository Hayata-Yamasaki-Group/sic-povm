# One effective mode for the entire tree, including private layout consumers.
if(SIC_ENABLE_TEST_HOOKS AND NOT SIC_BUILD_TESTS)
  message(FATAL_ERROR "SIC_ENABLE_TEST_HOOKS requires SIC_BUILD_TESTS=ON; use a separate test tree")
endif()
set(SIC_TEST_HOOKS_MODE 0)
if(SIC_ENABLE_TEST_HOOKS)
  set(SIC_TEST_HOOKS_MODE 1)
endif()
set(_sic_hooks_header "${PROJECT_BINARY_DIR}/test_hooks_mode.hpp")
configure_file("${CMAKE_CURRENT_LIST_DIR}/test_hooks_mode.hpp.in" "${_sic_hooks_header}" @ONLY)
# Exercise the compiler, including user flags. Presence, even =0, enables #ifdef.
include(CheckCXXSourceCompiles)
set(CMAKE_REQUIRED_DEFINITIONS)
if(SIC_ENABLE_TEST_HOOKS)
  set(CMAKE_REQUIRED_DEFINITIONS -DSIC_ENABLE_TEST_HOOKS=1)
endif()
unset(SIC_TEST_HOOKS_COMPILER_MODE_OK CACHE)
check_cxx_source_compiles("#include \"${_sic_hooks_header}\"
int main() { return 0; }" SIC_TEST_HOOKS_COMPILER_MODE_OK)
unset(CMAKE_REQUIRED_DEFINITIONS)
if(NOT SIC_TEST_HOOKS_COMPILER_MODE_OK)
  message(FATAL_ERROR "SIC_ENABLE_TEST_HOOKS conflicts with compiler flags; remove manual macro definitions (including =0), and select the CMake option")
endif()
# Reject overrides in inactive configurations as well as the compiler-probed one.
get_cmake_property(_sic_variables VARIABLES)
foreach(_v IN LISTS _sic_variables)
  if(_v MATCHES "^CMAKE_CXX_FLAGS" AND "${${_v}}" MATCHES "[/-]D[ ]*SIC_ENABLE_TEST_HOOKS([ =]|$)")
    message(FATAL_ERROR "Select SIC_ENABLE_TEST_HOOKS with the CMake option, not ${_v}")
  endif()
endforeach()
function(sic_apply_test_hooks_policy)
  _sic_project_targets("${PROJECT_SOURCE_DIR}" _targets)
  foreach(_target IN LISTS _targets)
    get_target_property(_type ${_target} TYPE)
    if(NOT _type MATCHES "^(STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY|EXECUTABLE)$")
      continue()
    endif()
    get_target_property(_checker ${_target} SIC_INDEPENDENT_DIRECTORY)
    get_target_property(_owner ${_target} SOURCE_DIR)
    get_target_property(_sources ${_target} SOURCES)
    # Checker selftests and deliberate independence fixtures share checker ownership,
    # even when they are not individually enrolled as standalone checkers.
    if(_checker)
      continue()
    endif()
    set(_independent FALSE)
    foreach(_source IN LISTS _sources)
      get_filename_component(_source "${_source}" ABSOLUTE BASE_DIR "${_owner}")
      if(_source MATCHES "^${PROJECT_SOURCE_DIR}/(checkers/|tests/independence/)")
        set(_independent TRUE)
      endif()
    endforeach()
    if(_independent)
      continue()
    endif()
    if(SIC_ENABLE_TEST_HOOKS)
      target_compile_definitions(${_target} PRIVATE SIC_ENABLE_TEST_HOOKS=1)
    endif()
    if(MSVC)
      target_compile_options(${_target} PRIVATE "/FI${_sic_hooks_header}")
    elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
      target_compile_options(${_target} PRIVATE "SHELL:-include \"${_sic_hooks_header}\"")
    else()
      message(FATAL_ERROR "Test-hook mode assertion needs a force-include option for this compiler")
    endif()
  endforeach()
endfunction()
