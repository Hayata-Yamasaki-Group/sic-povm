# Every standalone example explicitly enrolls its source, executable, test and arguments.
function(sic_register_standalone_example)
  cmake_parse_arguments(EXAMPLE "" "SOURCE;TARGET;TEST" "ARGS" ${ARGN})
  if(EXAMPLE_UNPARSED_ARGUMENTS OR NOT EXAMPLE_SOURCE OR NOT EXAMPLE_TARGET OR NOT EXAMPLE_TEST)
    message(FATAL_ERROR "Incomplete standalone example registration")
  endif()
  if(NOT EXISTS "${PROJECT_SOURCE_DIR}/examples/${EXAMPLE_SOURCE}")
    message(FATAL_ERROR "Missing registered standalone example: ${EXAMPLE_SOURCE}")
  endif()
  if(NOT TARGET ${EXAMPLE_TARGET})
    sic_add_executable(${EXAMPLE_TARGET} "${PROJECT_SOURCE_DIR}/examples/${EXAMPLE_SOURCE}")
  endif()
  add_test(NAME ${EXAMPLE_TEST} COMMAND ${EXAMPLE_TARGET} ${EXAMPLE_ARGS})
  set_tests_properties(${EXAMPLE_TEST} PROPERTIES LABELS docs)
endfunction()
sic_register_standalone_example(SOURCE read_fiducial.cpp TARGET read-fiducial
