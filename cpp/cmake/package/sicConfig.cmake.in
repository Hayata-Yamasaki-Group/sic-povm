@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
set(sic_WITH_FLINT @SIC_ENABLE_FLINT@)
set(sic_core_FOUND TRUE)
set(sic_support_FOUND TRUE)
set(sic_search_FOUND TRUE)
set(sic_transport_FOUND ${sic_WITH_FLINT})
set(sic_sicx_FOUND ${sic_WITH_FLINT})
set(sic_decode_FOUND ${sic_WITH_FLINT})
set(sic_access_FOUND ${sic_WITH_FLINT})
set(sic_data_FOUND TRUE)
if(@SIC_WITH_HDF5@)
  set(_sic_hdf5_module_path "${CMAKE_MODULE_PATH}")
  list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
  find_dependency(SicHDF5)
  set(CMAKE_MODULE_PATH "${_sic_hdf5_module_path}")
  unset(_sic_hdf5_module_path)
endif()
set(sic_bounds_FOUND ${sic_WITH_FLINT})
if(sic_WITH_FLINT)
  set(_sic_saved_module_path "${CMAKE_MODULE_PATH}")
  list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
  find_dependency(SicFLINT 3)
  set(CMAKE_MODULE_PATH "${_sic_saved_module_path}")
  unset(_sic_saved_module_path)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/sicTargets.cmake")
check_required_components(sic)
