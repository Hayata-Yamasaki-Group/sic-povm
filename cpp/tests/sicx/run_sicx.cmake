# SICX CTest driver. Variables: MODE, BIN (tool directory), WORK, FIXTURE, NAME, plus mode-specific ones.
#   roundtrip: verify FIXTURE; text-json (single and split) back to byte-identical .sicx;
#              optional GOLDEN_TEXT / GOLDEN_JSON byte comparisons.
# Every roundtrip also checks the canonical generator form (sic-verify --rescaling, spec section 3.7).
function(run)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "command failed (${status}): ${ARGN}\n${out}\n${err}")
  endif()
endfunction()
function(refused what)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE err)
  if(status EQUAL 0)
    message(FATAL_ERROR "${what} was accepted: ${ARGN}")
  endif()
  message(STATUS "refused as expected (${what}): ${err}")
endfunction()
function(same a b)
  file(SHA256 "${a}" ha)
  file(SHA256 "${b}" hb)
  if(NOT ha STREQUAL hb)
    message(FATAL_ERROR "files differ: ${a} ${b}")
  endif()
endfunction()

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

macro(roundtrip file)
  run("${BIN}/sic-verify" "${file}" --threads 2 --rescaling)
  run("${BIN}/sic-inspect" "${file}" --text-json "${WORK}/${NAME}.jsonl" --threads 2)
  run("${BIN}/sic-container" from-text "${WORK}/${NAME}.jsonl" "${WORK}/${NAME}-again.sicx")
  same("${file}" "${WORK}/${NAME}-again.sicx")
  run("${BIN}/sic-inspect" "${file}" --text-json "${WORK}/${NAME}-split" --part-bytes 4096)
  run("${BIN}/sic-container" from-text "${WORK}/${NAME}-split.parts.json" "${WORK}/${NAME}-parts.sicx")
  same("${file}" "${WORK}/${NAME}-parts.sicx")
  run("${BIN}/sic-inspect" "${file}" --json-rays "${WORK}/${NAME}-rays" --multiplet m1)
  run("${BIN}/sic-inspect" "${file}" --json-all "${WORK}/${NAME}-all.json" --multiplet m1)
  run("${BIN}/sic-inspect" "${file}" --block 1)
  run("${BIN}/sic-inspect" "${file}" --entry 1)
  if(GOLDEN_TEXT)
    same("${WORK}/${NAME}.jsonl" "${GOLDEN_TEXT}")
  endif()
  if(GOLDEN_JSON)
    same("${WORK}/${NAME}-rays/c0.json" "${GOLDEN_JSON}")
  endif()
endmacro()

if(MODE STREQUAL "roundtrip")
  roundtrip("${FIXTURE}")
elseif(MODE STREQUAL "release")
  # Release data tree for two d = 8 multiplets: m1 (FIXTURE, conductor 1) and m2 (FIXTURE2, conductor 3), N from provenance
  # conductors; no SICX, no conductor, parts reassemble to the fixtures; catalogue golden.
  set(root "${WORK}/data")
  set(assets "${WORK}/assets")
  run("${BIN}/sic-inspect" "${FIXTURE}" --release-layout "${root}" --provenance-conductors 1,3 --provenance-conductor 1 --assets-dir "${assets}" --part-size 1900000000)
  run("${BIN}/sic-inspect" "${FIXTURE2}" --release-layout "${root}" --provenance-conductors 1,3 --provenance-conductor 3 --assets-dir "${assets}" --part-size 1900000000)
  run("${BIN}/sic-inspect" --catalogue "${root}")
  foreach(f d8/m1/manifest.json d8/m1/multiplet.sicx.parts.json d8/m1/c0.json d8/m2/manifest.json
            d8/m2/multiplet.sicx.parts.json d8/m2/c0.json catalogue.json)
    if(NOT EXISTS "${root}/${f}")
      message(FATAL_ERROR "release tree lacks ${f}")
    endif()
  endforeach()
  file(GLOB_RECURSE _all RELATIVE "${root}" "${root}/*")
  foreach(f ${_all})
    if(f MATCHES "\\.sicx$|exact|jsonl")
      message(FATAL_ERROR "SICX, exact JSON or text form in the data tree: ${f}")
    endif()
    file(READ "${root}/${f}" _t)
    if(_t MATCHES "conductor|-f[0-9]")
      message(FATAL_ERROR "conductor in public file ${f}")
    endif()
  endforeach()
  # The parts reassemble to the fixtures (fixture 1 is m1, fixture 2 is m2).
  foreach(pair "m1;${FIXTURE}" "m2;${FIXTURE2}")
    list(GET pair 0 m)
    list(GET pair 1 fixture)
    file(GLOB parts "${assets}/d8-${m}.sicx.part-*")
    list(SORT parts)
    execute_process(COMMAND ${CMAKE_COMMAND} -E cat ${parts} OUTPUT_FILE "${WORK}/${m}.sicx" RESULT_VARIABLE rc)
    same("${WORK}/${m}.sicx" "${fixture}")
  endforeach()
  if(GOLDEN_JSON)
    same("${root}/catalogue.json" "${GOLDEN_JSON}")
  endif()
else()
  message(FATAL_ERROR "unknown MODE ${MODE}")
endif()
