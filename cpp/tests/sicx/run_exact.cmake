# exact.json tests. Variables: MODE, BIN (tool directory), WORK, FIXTURE, NAME, plus per mode:
#   make_d2: the native producer must reproduce the exact part, then ordinary decoder finalization checks BALL.
#   exact:   `sic-inspect FIXTURE --exact-json` (generation runs the numerical check against BALL) twice
#            must give identical bytes; the ray file must reference exact.json.
#   gp:      the GP reference script (GP, SCRIPT, optional SHIFTS) verifies the generated exact.json exactly.
#            Skipped (SKIP_REGULAR_EXPRESSION) when gp is not installed.
function(run)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "command failed (${status}): ${ARGN}\n${out}\n${err}")
  endif()
  set(last_output "${out}" PARENT_SCOPE)
endfunction()
function(same a b)
  file(SHA256 "${a}" ha)
  file(SHA256 "${b}" hb)
  if(NOT ha STREQUAL hb)
    message(FATAL_ERROR "files differ: ${a} ${b}")
  endif()
endfunction()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
if(MODE STREQUAL "make_d2")
  run("${BIN}/sic-construct" 1 --out "${WORK}/${NAME}.sicx" --radicals "${RADICALS}"
    --rays-out "${WORK}/rays.json")
  run("${BIN}/sic-test-decode-finalize" "${FIXTURE}" "${WORK}/reference")
  same("${WORK}/${NAME}.sicx" "${WORK}/reference/exact.sicx")
  run("${BIN}/sic-decode" "${WORK}/${NAME}.sicx" "${WORK}/decode"
    --ray-list "${WORK}/rays.json" --finalize --threads 2 --no-pin)
  run("${BIN}/sic-verify" "${WORK}/${NAME}.sicx")
else()
  run("${BIN}/sic-inspect" "${FIXTURE}" --exact-json "${WORK}/exact.json" --multiplet m1)
  message(STATUS "${last_output}")
  if(MODE STREQUAL "exact")
    run("${BIN}/sic-inspect" "${FIXTURE}" --exact-json "${WORK}/exact-b.json" --multiplet m1)
    same("${WORK}/exact.json" "${WORK}/exact-b.json")
    file(MAKE_DIRECTORY "${WORK}/rays")
    file(COPY "${WORK}/exact.json" DESTINATION "${WORK}/rays")
    run("${BIN}/sic-inspect" "${FIXTURE}" --json-rays "${WORK}/rays" --multiplet m1)
    file(GLOB rayfiles "${WORK}/rays/c*.json")
    foreach(f ${rayfiles})
      file(READ "${f}" text)
      if(NOT text MATCHES "\"exact\":\\{\"file\":\"exact.json\",\"ray\":\"d[0-9]+(-m[0-9]+)?-c[0-9]+\"\\}")
        message(FATAL_ERROR "ray file ${f} does not reference exact.json")
      endif()
    endforeach()
  elseif(MODE STREQUAL "gp")
    if(NOT GP)
      message(STATUS "SKIP: gp not found")
      return()
    endif()
    set(env_args "SIC_EXACT_JSON=${WORK}/exact.json")
    if(SHIFTS)
      list(APPEND env_args "SIC_SHIFTS=${SHIFTS}")
    endif()
    execute_process(COMMAND ${CMAKE_COMMAND} -E env ${env_args} "${GP}" -q -s 2G "${SCRIPT}"
      INPUT_FILE /dev/null RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
    message(STATUS "${out}")
    if(NOT status EQUAL 0 OR NOT out MATCHES "\nPASS")
      message(FATAL_ERROR "GP verification failed (${status})\n${out}\n${err}")
    endif()
  endif()
endif()
