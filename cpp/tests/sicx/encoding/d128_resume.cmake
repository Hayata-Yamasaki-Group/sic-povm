# Construct once, then SIGKILL and resume the real d128 source through K=8 encoding.
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(ENV{SIC_THREADS} 8)
execute_process(COMMAND "${PRODUCER}" 7
  --order standard --threads 8 --memory-mib 8192 --out "${WORK}/input.sicx"
  RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 90)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "d128 construction failed: ${status}\n${stdout}${stderr}")
endif()
foreach(action clean kill resume)
  if(action STREQUAL "clean")
    set(out "${WORK}/reference.sicx")
  else()
    set(out "${WORK}/recovered.sicx")
  endif()
  execute_process(COMMAND "${PROGRAM}" --copy-resume "${WORK}/input.sicx" "${out}" "${action}"
    RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
  if(action STREQUAL "kill")
    if(NOT "${status}" MATCHES "[Kk]illed" OR EXISTS "${out}" OR NOT EXISTS "${out}.spool.partial.journal")
      message(FATAL_ERROR "d128 encoder was not killed: ${status}\n${stdout}${stderr}")
    endif()
  elseif(NOT status EQUAL 0)
    message(FATAL_ERROR "d128 ${action} failed: ${status}\n${stdout}${stderr}")
  endif()
endforeach()
file(SHA256 "${WORK}/input.sicx" input)
foreach(output reference recovered)
  file(SHA256 "${WORK}/${output}.sicx" actual)
  if(NOT input STREQUAL actual)
    message(FATAL_ERROR "d128 ${output} bytes differ from uninterrupted native file")
  endif()
  message(STATUS "d128 K=8 ${output}: identical ${actual}")
endforeach()
