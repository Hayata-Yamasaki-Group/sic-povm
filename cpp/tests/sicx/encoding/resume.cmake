# Synthetic eight-block format fixture, not a SIC: K=4 and SIGKILL inside batch two.
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
foreach(action clean kill resume)
  if(action STREQUAL "clean")
    set(out "${WORK}/reference.part")
  else()
    set(out "${WORK}/recovered.part")
  endif()
  execute_process(COMMAND "${PROGRAM}" --synthetic-part "${out}" "${action}"
    RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
  if(action STREQUAL "kill")
    if(NOT "${status}" MATCHES "[Kk]illed" OR EXISTS "${out}" OR
       NOT EXISTS "${out}.partial.journal")
      message(FATAL_ERROR "fixture was not killed mid-batch: ${status}\n${stdout}${stderr}")
    endif()
  elseif(NOT status EQUAL 0)
    message(FATAL_ERROR "${action} failed: ${status}\n${stdout}${stderr}")
  endif()
endforeach()
foreach(suffix "" .idx .elements.json)
  file(SHA256 "${WORK}/reference.part${suffix}" reference)
  file(SHA256 "${WORK}/recovered.part${suffix}" recovered)
  if(NOT reference STREQUAL recovered)
    message(FATAL_ERROR "resumed part${suffix} differs from uninterrupted output")
  endif()
  message(STATUS "K=4 SIGKILL/resume part${suffix}: identical ${reference}")
endforeach()
