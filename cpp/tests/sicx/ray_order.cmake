file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
function(expect code diagnostic)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${rc}" STREQUAL "${code}" OR NOT "${out}${err}" MATCHES "${diagnostic}")
    message(FATAL_ERROR "${ARGN}: expected ${code}/${diagnostic}, got ${rc}: ${out}${err}")
  endif()
endfunction()
expect(0 "rejects 23 permutations" "${WRITER}" "${FIXTURE}" "${WORK}")
configure_file("${WORK}/exact.sicx" "${WORK}/exact-input.sicx" COPYONLY)

# Exercise actual certified finalization, not just container acceptance.
expect(0 "FINALIZED" "${DECODER}" "${WORK}/exact.sicx" "${WORK}/decoded" --finalize
  --ray c0 1,0,0,24,11 36 --ray c1 1,0,0,24,12 29
  --ray c2 1,1,0,24,11 44 --ray c3 1,1,0,24,12 33 --threads 2 --no-pin)
foreach(file "${FIXTURE}" "${WORK}/exact.sicx" "${WORK}/order-0.sicx")
  expect(0 "RESULT: PASS" "${READER2}" "${file}" --decode full --release --max-steps 1048576)
  expect(0 "FULL" "${CRT}" "${file}")
  expect(0 "FULL SICX input verification: PASS" "${EXACT}" "${file}" --verify-input)
endforeach()
foreach(i RANGE 1 23)
  set(file "${WORK}/order-${i}.sicx")
  file(READ "${WORK}/order-${i}.args" ray_args)
  separate_arguments(ray_args UNIX_COMMAND "${ray_args}")
  expect(1 "ray words" "${DECODER}" "${WORK}/exact-input.sicx" "${WORK}/bad-decode"
    --finalize ${ray_args} --threads 2 --no-pin)
  expect(1 "ray words" "${VERIFY}" "${file}")
  expect(2 "ray words" "${READER2}" "${file}" --decode off)
  expect(1 "ray words" "${CRT}" "${file}")
  expect(3 "ray word order" "${EXACT}" "${file}" --verify-input)
endforeach()

# Release manifests, per-ray JSON, aggregate JSON and the catalogue must preserve
# exactly the labels and words from the verified container.
expect(0 "RELEASE" "${DUMP}" "${FIXTURE}" --release-layout "${WORK}/release" --multiplet 1)
expect(0 "WROTE" "${DUMP}" --catalogue "${WORK}/release")
expect(0 "WROTE" "${DUMP}" "${FIXTURE}" --json-all "${WORK}/all.json" --multiplet m1)
file(READ "${WORK}/release/d64/m1/manifest.json" manifest)
file(READ "${WORK}/release/catalogue.json" catalogue)
file(READ "${WORK}/all.json" all)
string(JSON nrays LENGTH "${manifest}" rays)
if(NOT nrays EQUAL 4)
  message(FATAL_ERROR "release dropped d64 rays")
endif()
set(expected "1,0,0,24,11" "1,0,0,24,12" "1,1,0,24,11" "1,1,0,24,12")
foreach(i RANGE 0 3)
  string(JSON label GET "${manifest}" rays ${i} label)
  string(JSON word GET "${manifest}" rays ${i} exponents)
  string(JSON cat_label GET "${catalogue}" dimensions 0 multiplets 0 rays ${i} label)
  string(JSON cat_word GET "${catalogue}" dimensions 0 multiplets 0 rays ${i} exponents)
  file(READ "${WORK}/release/d64/m1/c${i}.json" ray)
  string(JSON ray_word GET "${ray}" galois_element exponents)
  string(JSON all_word GET "${all}" rays ${i} galois_element exponents)
  set(digits "")
  foreach(l RANGE 0 4)
    string(JSON digit GET "${word}" ${l})
    list(APPEND digits "${digit}")
  endforeach()
  list(JOIN digits "," digits)
  list(GET expected ${i} want)
  if(NOT label STREQUAL "c${i}" OR NOT cat_label STREQUAL label OR NOT digits STREQUAL want
      OR NOT cat_word STREQUAL word OR NOT ray_word STREQUAL word OR NOT all_word STREQUAL word)
    message(FATAL_ERROR "ray order changed in JSON exports/catalogue at c${i}")
  endif()
endforeach()
message(STATUS "PASS: four d64 rays accepted by finalizer and all readers; all 23 other orders rejected")
