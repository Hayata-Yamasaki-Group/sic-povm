# Kill/resume of the streaming writer through the tools (sic-construct, sic-decode --finalize).
# Variables: BIN (tool directory), PRODUCER (sic-construct), WORK and S (d = 2^S).
# 1. reference: one uninterrupted producer run (release option set, clean environment);
# 2. producer killed after K durable chunks, and killed mid-chunk at byte B; a rerun without --resume must
#    refuse the partial file; a rerun with --resume must give identical bytes;
# 3. --finalize of a copy killed after its first chunk (RAYS), then --finalize --resume: identical to a one-shot
#    --finalize of another copy; the result verifies.
function(run)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "command failed (${status}): ${ARGN}\n${out}\n${err}")
  endif()
endfunction()
function(same a b what)
  file(SHA256 "${a}" ha)
  file(SHA256 "${b}" hb)
  if(NOT ha STREQUAL hb)
    message(FATAL_ERROR "${what}: files differ: ${a} ${b}")
  endif()
  message(STATUS "${what}: identical ${ha}")
endfunction()
find_program(ENV_PROGRAM env REQUIRED)
# Fixed production kernels, resident storage, two workers.
set(producer_flags --threads 2 --order standard)
function(produce out)  # produce OUT [fault hook or --resume] -> status and captured diagnostics
  set(extra_env)
  set(extra_flags)
  foreach(arg IN LISTS ARGN)
    if(arg STREQUAL "--resume")
      list(APPEND extra_flags "${arg}")
    else()
      list(APPEND extra_env "${arg}")
    endif()
  endforeach()
  execute_process(COMMAND "${ENV_PROGRAM}" -i "PATH=$ENV{PATH}" LC_ALL=C "ASAN_OPTIONS=$ENV{ASAN_OPTIONS}" "UBSAN_OPTIONS=$ENV{UBSAN_OPTIONS}" ${extra_env}
    "${PRODUCER}" ${S} ${producer_flags} --out "${out}" --rays-out "${out}.rays.json" ${extra_flags}
    RESULT_VARIABLE status OUTPUT_VARIABLE out_text ERROR_VARIABLE err_text)
  set(PRODUCE_STATUS ${status} PARENT_SCOPE)
  set(PRODUCE_OUTPUT "${out_text}${err_text}" PARENT_SCOPE)
endfunction()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
produce("${WORK}/ref.sicx")
if(NOT PRODUCE_STATUS EQUAL 0)
  message(FATAL_ERROR "reference producer run failed (${PRODUCE_STATUS})\n${PRODUCE_OUTPUT}")
endif()
set(fin_args --ray-list "${WORK}/ref.sicx.rays.json")
# Byte fault: the middle of the middle BODY chunk, so a torn data block and a partial adoption are exercised.
execute_process(COMMAND "${BIN}/sic-inspect" "${WORK}/ref.sicx" --info OUTPUT_VARIABLE info RESULT_VARIABLE status)
string(REGEX MATCHALL "chunk [0-9]+ BODY flags=[01] offset=[0-9]+ length=[0-9]+" bodies "${info}")
list(LENGTH bodies nbody)
if(NOT status EQUAL 0 OR nbody LESS 3)
  message(FATAL_ERROR "reference file has too few BODY chunks for the byte fault (${nbody})")
endif()
math(EXPR pick "${nbody} / 2")
list(GET bodies ${pick} body)
string(REGEX MATCH "offset=([0-9]+) length=([0-9]+)" _ "${body}")
math(EXPR mid "${CMAKE_MATCH_1} + ${CMAKE_MATCH_2} / 2")
message(STATUS "byte fault inside ${body}: ${mid}")
function(produce_ambient out)
  execute_process(COMMAND "${ENV_PROGRAM}" -i "PATH=$ENV{PATH}" LC_ALL=C
    "SIC_OUT=${out}" SIC_THREADS=2 SIC_ORDER=standard SIC_ENTRY_ARB=1 ${ARGN}
    "${BIN}/sic-test-construct-test-hooks" ambient "${S}"
    RESULT_VARIABLE status OUTPUT_VARIABLE out_text ERROR_VARIABLE err_text)
  set(PRODUCE_STATUS ${status} PARENT_SCOPE)
  set(PRODUCE_OUTPUT "${out_text}${err_text}" PARENT_SCOPE)
endfunction()
# Non-producer environment changes do not bind the producer plan; producer settings do.
foreach(key SIC_RAY SIC_SHIFTS SIC_EXACT_JSON SIC_PART_ASSET)
  set(path "${WORK}/${key}.sicx")
  produce_ambient("${path}" "SIC_FAULT_KILL_AFTER_CHUNKS=7" "${key}=before")
  if(PRODUCE_STATUS EQUAL 0 OR (NOT EXISTS "${path}.sicx-quarantine.partial.journal" AND
                              NOT EXISTS "${path}.sicx-quarantine.spool.partial.journal"))
    message(FATAL_ERROR "fault did not leave a resumable ${key} setup: ${PRODUCE_OUTPUT}")
  endif()
  produce_ambient("${path}" SIC_SICX_RESUME=1 "${key}=after")
  if(NOT PRODUCE_STATUS EQUAL 0)
    message(FATAL_ERROR "non-producer ${key} changed resume: ${PRODUCE_OUTPUT}")
  endif()
  string(REGEX MATCH "SICX resume: adopted ([0-9]+) of [0-9]+ tower/action elements" adopted "${PRODUCE_OUTPUT}")
  if(NOT adopted OR CMAKE_MATCH_1 EQUAL 0)
    message(FATAL_ERROR "${key} resume adopted nothing: ${PRODUCE_OUTPUT}")
  endif()
endforeach()
produce_ambient("${WORK}/changed-producer.sicx" "SIC_FAULT_KILL_AFTER_CHUNKS=7" "SIC_GHOST_DEBUG=0")
if(PRODUCE_STATUS EQUAL 0 OR (NOT EXISTS "${WORK}/changed-producer.sicx.sicx-quarantine.partial.journal" AND
                             NOT EXISTS "${WORK}/changed-producer.sicx.sicx-quarantine.spool.partial.journal"))
  message(FATAL_ERROR "fault did not stop producer setting setup")
endif()
produce_ambient("${WORK}/changed-producer.sicx" SIC_SICX_RESUME=1 "SIC_GHOST_DEBUG=1")
if(PRODUCE_STATUS EQUAL 0 OR NOT PRODUCE_OUTPUT MATCHES "plan")
  message(FATAL_ERROR "changed producer setting was not refused for its plan: ${PRODUCE_OUTPUT}")
endif()
foreach(fault "SIC_FAULT_KILL_AFTER_CHUNKS=7" "SIC_FAULT_KILL_AT_BYTE=${mid}" "SIC_TEST_KILL_AFTER_WRITE=1")
  file(REMOVE "${WORK}/k.sicx" "${WORK}/k.sicx.rays.json" "${WORK}/k.sicx.sicx-quarantine.partial" "${WORK}/k.sicx.sicx-quarantine.partial.journal" "${WORK}/k.sicx.sicx-quarantine.spool.partial" "${WORK}/k.sicx.sicx-quarantine.spool.partial.journal")
  produce("${WORK}/k.sicx" "${fault}")
  if(fault STREQUAL "SIC_TEST_KILL_AFTER_WRITE=1" AND NOT PRODUCE_STATUS EQUAL 86)
    message(FATAL_ERROR "completed-write hook did not exit 86: ${PRODUCE_OUTPUT}")
  endif()
  if(PRODUCE_STATUS EQUAL 0)
    message(FATAL_ERROR "fault ${fault} did not stop the producer")
  endif()
  if(EXISTS "${WORK}/k.sicx" OR (NOT EXISTS "${WORK}/k.sicx.sicx-quarantine.partial" AND NOT EXISTS "${WORK}/k.sicx.sicx-quarantine.spool.partial" AND NOT EXISTS "${WORK}/k.sicx.sicx-quarantine"))
    message(FATAL_ERROR "a killed producer must leave only k.sicx.sicx-quarantine.partial (${fault})")
  endif()
  produce("${WORK}/k.sicx")
  if(PRODUCE_STATUS EQUAL 0 OR NOT PRODUCE_OUTPUT MATCHES "partial output exists")
    message(FATAL_ERROR "a rerun without --resume must refuse the existing partial file\n${PRODUCE_OUTPUT}")
  endif()
  if(fault STREQUAL "SIC_TEST_KILL_AFTER_WRITE=1")
    # Recreate the disk state after the ray list was written and before the
    # exact SICX was published. Resume must preserve the bound list.
    file(COPY_FILE "${WORK}/ref.sicx.rays.json" "${WORK}/k.sicx.rays.json")
  endif()
  produce("${WORK}/k.sicx" --resume)
  if(NOT PRODUCE_STATUS EQUAL 0)
    message(FATAL_ERROR "resume after ${fault} failed (${PRODUCE_STATUS})\n${PRODUCE_OUTPUT}")
  endif()
  string(REGEX MATCH "SICX resume: adopted ([0-9]+) of [0-9]+ tower/action elements" adopted "${PRODUCE_OUTPUT}")
  if(NOT adopted OR CMAKE_MATCH_1 EQUAL 0)
    message(FATAL_ERROR "resume after ${fault} adopted nothing\n${PRODUCE_OUTPUT}")
  endif()
  message(STATUS "${adopted}")
  same("${WORK}/ref.sicx" "${WORK}/k.sicx" "producer ${fault} + --resume")
  same("${WORK}/ref.sicx.rays.json" "${WORK}/k.sicx.rays.json" "ray list after ${fault} + --resume")
endforeach()
# A completed quarantine without its authenticated durable journal is preserved, never discarded.
produce("${WORK}/missing.sicx" "SIC_TEST_KILL_AFTER_WRITE=1")
if(NOT PRODUCE_STATUS EQUAL 86 OR NOT EXISTS "${WORK}/missing.sicx.sicx-quarantine")
  message(FATAL_ERROR "completed-write fault did not retain the private output")
endif()
file(SHA256 "${WORK}/missing.sicx.sicx-quarantine" completed_before)
file(REMOVE "${WORK}/missing.sicx.sicx-quarantine.spool.partial.journal")
produce("${WORK}/missing.sicx" --resume)
file(SHA256 "${WORK}/missing.sicx.sicx-quarantine" completed_after)
if(PRODUCE_STATUS EQUAL 0 OR NOT completed_before STREQUAL completed_after OR EXISTS "${WORK}/missing.sicx")
  message(FATAL_ERROR "missing-journal recovery changed or published the completed file")
endif()
file(COPY_FILE "${WORK}/ref.sicx" "${WORK}/f.sicx")
file(COPY_FILE "${WORK}/ref.sicx" "${WORK}/g.sicx")
run("${BIN}/sic-decode" "${WORK}/g.sicx" "${WORK}/decg" --finalize ${fin_args} --threads 2 --no-pin)
execute_process(COMMAND ${CMAKE_COMMAND} -E env SIC_FAULT_KILL_AFTER_CHUNKS=1
  "${BIN}/sic-decode" "${WORK}/f.sicx" "${WORK}/dec1" --finalize ${fin_args} --threads 2 --no-pin
  RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(status EQUAL 0)
  message(FATAL_ERROR "SIC_FAULT_KILL_AFTER_CHUNKS=1 did not stop --finalize")
endif()
run("${BIN}/sic-decode" "${WORK}/f.sicx" "${WORK}/dec2" --finalize ${fin_args} --threads 2 --no-pin --resume)
same("${WORK}/g.sicx" "${WORK}/f.sicx" "killed --finalize + --finalize --resume")
run("${BIN}/sic-verify" "${WORK}/f.sicx" --threads 2)
