# A tiny raw coordinate whose imaginary interval straddles zero. The decoder's
# absolute accuracy promise holds, but binary64 rounding is not unique.
file(MAKE_DIRECTORY "${WORK}")
set(a "${WORK}/raw.balls")
file(WRITE "${a}" "sic-vector-balls/1.0\nd 1\n1 0 0 0 | -1 -1f3 92ff88d -b8\nend\n")
foreach(mode raw overlap)
  execute_process(COMMAND "${COMPARE}" "${a}" "${a}" 1 ${mode} 128 RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0 OR NOT out MATCHES "PASS 1 ${mode} coordinates")
    message(FATAL_ERROR "self comparison failed: ${rc} ${out} ${err}")
  endif()
endforeach()
execute_process(COMMAND "${COMPARE}" "${a}" "${a}" 1 normalized 128 RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 1 OR NOT err MATCHES "uncertified FP64 rounding")
  message(FATAL_ERROR "normalized ambiguous rounding was accepted: ${rc} ${err}")
endif()
file(WRITE "${WORK}/disjoint.balls" "sic-vector-balls/1.0\nd 1\n2 0 0 0 | -1 -1f3 92ff88d -b8\nend\n")
foreach(mode raw overlap)
  execute_process(COMMAND "${COMPARE}" "${a}" "${WORK}/disjoint.balls" 1 ${mode} 128 RESULT_VARIABLE rc ERROR_VARIABLE err)
  if(NOT rc EQUAL 1 OR NOT err MATCHES "disjoint")
    message(FATAL_ERROR "disjoint enclosure was accepted: ${rc} ${err}")
  endif()
endforeach()
message(STATUS "PASS 5 raw comparator fixture controls")
