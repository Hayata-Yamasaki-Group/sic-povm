cmake_minimum_required(VERSION 3.16)
# Every file in the build-tree fixture view is listed exactly once in tests/fixtures/sicx/SHA256SUMS with its current SHA-256.
# Variables: LIST (tests/fixtures/sicx/SHA256SUMS), DIR (fixtures directory).
file(STRINGS "${LIST}" lines)
file(GLOB files RELATIVE "${DIR}" "${DIR}/*")
set(seen "")
foreach(line IN LISTS lines)
  string(REGEX MATCH "^([0-9a-f]+)  (.+)$" m "${line}")
  if(NOT m)
    message(FATAL_ERROR "malformed line: ${line}")
  endif()
  set(hash "${CMAKE_MATCH_1}")
  set(name "${CMAKE_MATCH_2}")
  if(name IN_LIST seen)
    message(FATAL_ERROR "listed twice: ${name}")
  endif()
  list(APPEND seen "${name}")
  if(NOT EXISTS "${DIR}/${name}")
    message(FATAL_ERROR "listed but missing: ${name}")
  endif()
  file(SHA256 "${DIR}/${name}" actual)
  if(NOT actual STREQUAL hash)
    message(FATAL_ERROR "SHA-256 mismatch: ${name}")
  endif()
endforeach()
foreach(f IN LISTS files)
  if(NOT f IN_LIST seen)
    message(FATAL_ERROR "fixture not listed in tests/fixtures/sicx/SHA256SUMS: ${f}")
  endif()
endforeach()
message(STATUS "tests/fixtures/sicx/SHA256SUMS: all listed fixtures match")
