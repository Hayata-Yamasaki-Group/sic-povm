cmake_minimum_required(VERSION 3.20)
if(TEST_WORKERS STREQUAL "auto")
  include(ProcessorCount)
  # nproc consults these OpenMP settings; discovery must use process allowance.
  foreach(_variable OMP_NUM_THREADS OMP_THREAD_LIMIT)
    set(_defined_${_variable} FALSE)
    if(DEFINED ENV{${_variable}})
      set(_defined_${_variable} TRUE)
      set(_saved_${_variable} "$ENV{${_variable}}")
    endif()
    unset(ENV{${_variable}})
  endforeach()
  ProcessorCount(TEST_WORKERS)
  foreach(_variable OMP_NUM_THREADS OMP_THREAD_LIMIT)
    if(_defined_${_variable})
      set(ENV{${_variable}} "${_saved_${_variable}}")
    endif()
  endforeach()
  if(TEST_WORKERS LESS 3)
    set(TEST_WORKERS 3)
  endif()
endif()
if(NOT DEFINED SCRIPT AND NOT TEST_WORKERS MATCHES "^[1-9][0-9]*$")
  message(FATAL_ERROR "TEST_WORKERS must be supplied by the test registration")
endif()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
if(DEFINED SCRIPT)
  execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD}" --prefix "${WORK}/original"
    RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "OFF install failed: ${_out}${_err}")
  endif()
  file(RENAME "${WORK}/original" "${WORK}/relocated")
  file(GLOB_RECURSE _interfaces "${WORK}/relocated/include/*" "${WORK}/relocated/lib*/cmake/*")
  foreach(_file IN LISTS _interfaces)
    file(READ "${_file}" _text)
    if(_text MATCHES "test_hooks_mode|SIC_ENABLE_TEST_HOOKS|sic_test_|sic-test-")
      message(FATAL_ERROR "private hook policy exported: ${_file}")
    endif()
  endforeach()
  execute_process(COMMAND "${CMAKE_COMMAND}" -DMODE=isolation -DBIN=${WORK}/relocated/bin
    -DWORK=${WORK}/matrix -DFIXTURE=${FIXTURE} -P "${SCRIPT}"
    WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "installed isolation failed: ${_out}${_err}")
  endif()
  message(STATUS "${_out}")
  return()
endif()

foreach(_case direct runtime arbitrary destdir build_target)
  set(_prefix "${WORK}/${_case}")
  set(_args "")
  if(_case STREQUAL "runtime")
    set(_args --component Unspecified)
  elseif(_case STREQUAL "arbitrary")
    set(_args --component no-such-component)
  endif()
  set(_env "DESTDIR=")
  if(_case STREQUAL "destdir" OR _case STREQUAL "build_target")
    set(_env "DESTDIR=${WORK}/destdir-${_case}")
  endif()
  file(MAKE_DIRECTORY "${_prefix}")
  file(WRITE "${_prefix}/sentinel" "preserve\n")
  set(_command "${CMAKE_COMMAND}" --install "${BUILD}" --prefix "${_prefix}" ${_args})
  if(_case STREQUAL "build_target")
    set(_command "${CMAKE_COMMAND}" --build "${BUILD}" --target install --parallel "${TEST_WORKERS}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "${_env}" ${_command}
    RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  file(WRITE "${WORK}/${_case}.log" "${_rc}\n${_out}${_err}")
  if(_rc EQUAL 0 OR NOT "${_out}${_err}" MATCHES "Installation refused: SIC_ENABLE_TEST_HOOKS=ON")
    message(FATAL_ERROR "${_case}: ON install did not explicitly refuse: ${_rc} ${_out}${_err}")
  endif()
  file(READ "${_prefix}/sentinel" _sentinel)
  file(GLOB_RECURSE _files LIST_DIRECTORIES FALSE "${_prefix}/*" "${WORK}/destdir-${_case}/*")
  list(LENGTH _files _count)
  if(NOT _count EQUAL 1 OR NOT _sentinel STREQUAL "preserve\n")
    message(FATAL_ERROR "${_case}: ON install wrote payload or changed sentinel: ${_files}")
  endif()
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD}" --prefix "${WORK}/absent"
  RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
if(_rc EQUAL 0 OR EXISTS "${WORK}/absent")
  message(FATAL_ERROR "ON install created a prefix")
endif()
message(STATUS "direct, component, arbitrary component, DESTDIR and install target refusal PASS")
