# CTest independence_gp (cmake/checks/Independence.cmake): the GP checkers under cpp/checkers/gp load no code of the tree (no
# string literal naming a .gp, .cpp, .hpp or .h file outside comments, so nothing is read() or included from the
# production side; data inputs such as exact.json are allowed; no extern(), externstr(), system() or install()), and
# no C++ source of the tree includes a .gp file.
# Variables: GP_DIR (cpp/checkers/gp), SOURCE_ROOT (cpp/).
cmake_minimum_required(VERSION 3.20)  # script mode: IN_LIST and current policies
set(_fail "")
file(GLOB _gp "${GP_DIR}/*.gp")
list(LENGTH _gp _n)
if(_n EQUAL 0)
  list(APPEND _fail "no GP scripts under ${GP_DIR}")
endif()
foreach(_f ${_gp})
  file(STRINGS "${_f}" _lines)
  set(_no 0)
  foreach(_l IN LISTS _lines)
    math(EXPR _no "${_no} + 1")
    string(REGEX REPLACE "\\\\\\\\.*$" "" _code "${_l}")  # strip GP comments (\\ ...)
    if(_code MATCHES "\"[^\"]*\\.(gp|cpp|hpp|h)\"")
      list(APPEND _fail "${_f}:${_no}: names a code file: ${_l}")
    endif()
    if(_code MATCHES "(^|[^A-Za-z0-9_])(extern|externstr|system|install)[ \t]*\\(")
      list(APPEND _fail "${_f}:${_no}: runs or loads external code: ${_l}")
    endif()
  endforeach()
endforeach()
file(GLOB_RECURSE _cxx "${SOURCE_ROOT}/*.cpp" "${SOURCE_ROOT}/*.hpp")
foreach(_f ${_cxx})
  file(RELATIVE_PATH _relative "${SOURCE_ROOT}" "${_f}")
  if(_relative MATCHES "(^|/)(build[^/]*|candidates|repro)/")
    continue()
  endif()
  file(STRINGS "${_f}" _inc REGEX "^[ \t]*#[ \t]*include[ \t]*[\"<][^\">]*\\.gp[\">]")
  if(_inc)
    list(APPEND _fail "${_f}: includes a .gp file")
  endif()
endforeach()
if(_fail)
  list(JOIN _fail "\n  " _msg)
  message(FATAL_ERROR "independence_gp: FAIL\n  ${_msg}")
endif()
message(STATUS "independence_gp: PASS (${_n} GP scripts)")
if(NOT GP_CONTROL)
  # Exercise both scan directions in an isolated miniature source tree.
  set(_control "${CMAKE_CURRENT_BINARY_DIR}/independence_gp_control")
  file(REMOVE_RECURSE "${_control}")
  file(MAKE_DIRECTORY "${_control}/checkers/gp" "${_control}/src")
  file(WRITE "${_control}/checkers/gp/check.gp" "print(1)\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -DGP_CONTROL=ON -DGP_DIR=${_control}/checkers/gp
    -DSOURCE_ROOT=${_control} -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE _positive OUTPUT_QUIET ERROR_QUIET)
  if(NOT _positive EQUAL 0)
    message(FATAL_ERROR "independence_gp positive control failed")
  endif()
  file(WRITE "${_control}/checkers/gp/check.gp" "read(\"src/code.cpp\")\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -DGP_CONTROL=ON -DGP_DIR=${_control}/checkers/gp
    -DSOURCE_ROOT=${_control} -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE _gp_negative OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  if(_gp_negative EQUAL 0 OR NOT "${_out}${_err}" MATCHES "names a code file")
    message(FATAL_ERROR "independence_gp GP negative control failed")
  endif()
  file(WRITE "${_control}/checkers/gp/check.gp" "print(1)\n")
  file(WRITE "${_control}/src/code.cpp" "#include \"check.gp\"\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -DGP_CONTROL=ON -DGP_DIR=${_control}/checkers/gp
    -DSOURCE_ROOT=${_control} -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE _cpp_negative OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  if(_cpp_negative EQUAL 0 OR NOT "${_out}${_err}" MATCHES "includes a .gp file")
    message(FATAL_ERROR "independence_gp C++ negative control failed")
  endif()
  file(REMOVE_RECURSE "${_control}")
  message(STATUS "independence_gp controls: PASS")
endif()
