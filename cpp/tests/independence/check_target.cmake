# SPDX-License-Identifier: AGPL-3.0-or-later
# CTest independence_<target> (cmake/checks/Independence.cmake). Variables: TARGET, OBJECT_DIR (CMakeFiles/<t>.dir),
# BINARY_ROOT, SOURCE_ROOT (cpp/), CHECKER (the checker's own directory or file), CHECKERS_FILE (one enrolled checker
# path per line, written at configure time; excluded from the production set), SHINGLES (helper), GENERATOR, MAKE_PROGRAM,
# EXPECTED (1 for a known violation).
# Violations: a dependency under cpp/{include,src,apps,tools,tests,experiments,checkers} or the build tree outside CHECKER; a
# project archive, object or shared library, a -L directory in the build tree or the source tree (outside
# build-deps), or a -l name of a project library on the link line; shared 8-line code windows with the production
# sources (cpp/include, src, apps, tools, checkers minus the checkers). Infrastructure errors (no dependency information, no
# link line, helper failure) always fail. With EXPECTED=1 the test passes only if at least one violation is found
# and no infrastructure error occurs, so a fixed violation makes it fail until the enrolment is updated.
cmake_minimum_required(VERSION 3.20)  # script mode: IN_LIST and current policies
set(_fail "")
set(_infra "")
get_filename_component(CHECKER "${CHECKER}" REALPATH)
get_filename_component(SOURCE_ROOT "${SOURCE_ROOT}" REALPATH)
get_filename_component(BINARY_ROOT "${BINARY_ROOT}" REALPATH)
# link.txt and depfile paths are relative to the target's binary directory (Makefiles) or to BINARY_ROOT (Ninja)
if(GENERATOR MATCHES "Ninja")
  set(_base "${BINARY_ROOT}")
else()
  get_filename_component(_base "${OBJECT_DIR}/../.." REALPATH)
endif()
function(_own path out)  # TRUE if path is CHECKER itself or inside the CHECKER directory
  if(path STREQUAL CHECKER)
    set(${out} TRUE PARENT_SCOPE)
    return()
  endif()
  string(FIND "${path}" "${CHECKER}/" _p)
  if(_p EQUAL 0)
    set(${out} TRUE PARENT_SCOPE)
  else()
    set(${out} FALSE PARENT_SCOPE)
  endif()
endfunction()

# 1. Include closure from the compiler dependency files.
set(_deps "")
if(GENERATOR MATCHES "Ninja")
  execute_process(COMMAND "${MAKE_PROGRAM}" -C "${BINARY_ROOT}" -t deps OUTPUT_VARIABLE _ninja RESULT_VARIABLE _rc)
  if(NOT _rc EQUAL 0)
    list(APPEND _infra "ninja -t deps failed (${_rc})")
  endif()
  string(REGEX MATCHALL "[^\n]*CMakeFiles/${TARGET}\\.dir/[^\n]*\n(    [^\n]*\n)*" _blocks "${_ninja}")
  foreach(_b ${_blocks})
    string(REGEX MATCHALL "\n    [^\n]+" _lines "${_b}")
    foreach(_l ${_lines})
      string(STRIP "${_l}" _l)
      list(APPEND _deps "${_l}")
    endforeach()
  endforeach()
else()
  file(GLOB_RECURSE _objects "${OBJECT_DIR}/*.o")
  foreach(_object ${_objects})
    if(NOT EXISTS "${_object}.d")
      list(APPEND _infra "missing compiler dependency file: ${_object}.d")
    endif()
  endforeach()
  file(GLOB_RECURSE _dfiles "${OBJECT_DIR}/*.o.d")
  foreach(_f ${_dfiles})
    file(READ "${_f}" _txt)
    string(REPLACE "\\\n" " " _txt "${_txt}")
    string(REGEX REPLACE "^[^:]*:" "" _txt "${_txt}")
    string(REGEX MATCHALL "[^ \t\n]+" _items "${_txt}")
    list(APPEND _deps ${_items})
  endforeach()
endif()
list(LENGTH _deps _n)
if(_n EQUAL 0)
  list(APPEND _infra "no compiler dependency information for ${TARGET} (build it first; generator ${GENERATOR})")
endif()
list(REMOVE_DUPLICATES _deps)
foreach(_d ${_deps})
  get_filename_component(_d "${_d}" REALPATH BASE_DIR "${_base}")
  _own("${_d}" _is_own)
  if(_is_own)
    continue()
  endif()
  foreach(_f include src apps tools tests experiments checkers)
    string(FIND "${_d}" "${SOURCE_ROOT}/${_f}/" _hit)
    if(_hit EQUAL 0)
      list(APPEND _fail "includes ${_d}")
    endif()
  endforeach()
  string(FIND "${_d}" "${BINARY_ROOT}/" _hit)
  if(_hit EQUAL 0)
    list(APPEND _fail "includes generated ${_d}")
  endif()
endforeach()

# 2. Link line.
set(_link "")
if(GENERATOR MATCHES "Ninja")
  execute_process(COMMAND "${MAKE_PROGRAM}" -C "${BINARY_ROOT}" -t commands -s ${TARGET} OUTPUT_VARIABLE _all RESULT_VARIABLE _rc)
  if(NOT _rc EQUAL 0)
    list(APPEND _infra "ninja -t commands failed (${_rc})")
  endif()
  string(REGEX MATCHALL "[^\n]* -o [^\n]*${TARGET}[^\n]*" _link "${_all}")
elseif(EXISTS "${OBJECT_DIR}/link.txt")
  file(READ "${OBJECT_DIR}/link.txt" _link)
endif()
if(_link STREQUAL "")
  list(APPEND _infra "no link line for ${TARGET}")
endif()
file(GLOB_RECURSE _project_libs LIST_DIRECTORIES false "${BINARY_ROOT}/*.a" "${BINARY_ROOT}/*.so")
set(_project_names "")
foreach(_l ${_project_libs})
  get_filename_component(_nm "${_l}" NAME_WE)
  string(REGEX REPLACE "^lib" "" _nm "${_nm}")
  list(APPEND _project_names "${_nm}")
endforeach()
string(REGEX MATCHALL "[^ \t\n]+" _tokens "${_link}")
foreach(_t ${_tokens})
  if(_t MATCHES "^-L(.+)$")
    get_filename_component(_dir "${CMAKE_MATCH_1}" REALPATH BASE_DIR "${_base}")
    string(FIND "${_dir}/" "${BINARY_ROOT}/" _b)
    string(FIND "${_dir}/" "${SOURCE_ROOT}/" _s)
    string(FIND "${_dir}/" "${SOURCE_ROOT}/build-deps/" _deps_dir)
    if(_b EQUAL 0 OR (_s EQUAL 0 AND NOT _deps_dir EQUAL 0))
      list(APPEND _fail "link search directory ${_dir}")
    endif()
  elseif(_t MATCHES "^-l(.+)$")
    if(CMAKE_MATCH_1 IN_LIST _project_names)
      list(APPEND _fail "links -l${CMAKE_MATCH_1} (a library built by this project)")
    endif()
  elseif(_t MATCHES "\\.(a|o|so)$")
    get_filename_component(_o "${_t}" REALPATH BASE_DIR "${_base}")
    string(FIND "${_o}" "${OBJECT_DIR}/" _own_obj)
    get_filename_component(_od "${OBJECT_DIR}" REALPATH)
    string(FIND "${_o}" "${_od}/" _own_obj2)
    string(FIND "${_o}" "${BINARY_ROOT}/" _ours)
    if(_ours EQUAL 0 AND NOT _own_obj EQUAL 0 AND NOT _own_obj2 EQUAL 0)
      list(APPEND _fail "links ${_o}")
    endif()
  endif()
endforeach()

# 3. Copied code: shared 8-line windows with the production sources (the checkers themselves excluded).
set(_excl "")
set(_checkers "")
if(EXISTS "${CHECKERS_FILE}")
  file(STRINGS "${CHECKERS_FILE}" _checkers)
endif()
foreach(_c ${_checkers})
  list(APPEND _excl --exclude "${_c}")
endforeach()
execute_process(COMMAND "${SHINGLES}" "${CHECKER}" ${_excl} "${SOURCE_ROOT}/include" "${SOURCE_ROOT}/src"
    "${SOURCE_ROOT}/apps" "${SOURCE_ROOT}/tools" "${SOURCE_ROOT}/checkers"
  RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
message(STATUS "${_out}")
if(_rc EQUAL 1)
  list(APPEND _fail "shared code with production sources: ${_out}")
elseif(NOT _rc EQUAL 0)
  list(APPEND _infra "independence_shingles failed (${_rc}): ${_err}")
endif()

if(_infra)
  list(JOIN _infra "\n  " _msg)
  message(FATAL_ERROR "independence_${TARGET}: CHECK ERROR\n  ${_msg}")
endif()
list(REMOVE_DUPLICATES _fail)
list(JOIN _fail "\n  " _msg)
if(EXPECTED)
  if(NOT _fail)
    message(FATAL_ERROR "independence_${TARGET}: the expected violation is gone; remove EXPECTED_VIOLATION from its enrolment")
  endif()
  message(STATUS "independence_${TARGET}: EXPECTED VIOLATION (known, scheduled):\n  ${_msg}")
  return()
endif()
if(_fail)
  message(FATAL_ERROR "independence_${TARGET}: NOT INDEPENDENT\n  ${_msg}")
endif()
message(STATUS "independence_${TARGET}: PASS (${_n} dependency entries checked)")
