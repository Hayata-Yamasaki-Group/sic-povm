file(REMOVE_RECURSE "${WORK}")
separate_arguments(args UNIX_COMMAND "${ARGS}")
if(DEFINED MEMORY_MIB)
  list(LENGTH MEMORY_MIB budgets)
  list(LENGTH THREADS workers)
  if(NOT budgets EQUAL workers)
    message(FATAL_ERROR "MEMORY_MIB must give one cap for each entry in THREADS")
  endif()
endif()
set(first "")
foreach(t ${THREADS})
  set(memory_args)
  if(DEFINED MEMORY_MIB)
    list(POP_FRONT MEMORY_MIB cap)
    set(memory_args --memory-mib "${cap}")
  endif()
  execute_process(COMMAND "${CMD}" "${INPUT}" "${WORK}/t${t}" --threads ${t} ${args} ${memory_args}
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT status EQUAL 0 OR NOT out MATCHES "\nPASS")
    message(FATAL_ERROR "decode with ${t} workers failed (${status})\n${out}\n${err}")
  endif()
  file(GLOB outputs RELATIVE "${WORK}/t${t}" "${WORK}/t${t}/*.raw.balls" "${WORK}/t${t}/*.fp64.txt")
  list(SORT outputs)
  set(digest "")
  foreach(f ${outputs})
    file(SHA256 "${WORK}/t${t}/${f}" h)
    string(APPEND digest "${f}:${h};")
  endforeach()
  if(first STREQUAL "")
    set(first "${digest}")
  elseif(NOT digest STREQUAL first)
    message(FATAL_ERROR "outputs with ${t} workers differ from the first run")
  endif()
endforeach()
if(GOLDEN)
  file(STRINGS "${GOLDEN}" golden_lines)
  set(entries "")
  foreach(line ${golden_lines})
    string(REGEX MATCH "^([0-9a-f]+)  (.+)$" m "${line}")
    list(APPEND entries "${CMAKE_MATCH_2}:${CMAKE_MATCH_1}")
  endforeach()
  list(SORT entries)
  set(expected "")
  foreach(entry ${entries})
    string(APPEND expected "${entry};")
  endforeach()
  if(NOT first STREQUAL expected)
    message(FATAL_ERROR "outputs differ from the golden digests ${GOLDEN}\n got: ${first}\n expected: ${expected}")
  endif()
  message(STATUS "outputs equal the golden digests")
endif()
message(STATUS "identical outputs for workers ${THREADS}")
