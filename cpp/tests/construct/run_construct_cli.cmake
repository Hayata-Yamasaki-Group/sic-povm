# CLI failures must occur before constructing a Group or Table, including on the d2 shortcut.
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
if(MODE STREQUAL "injected")
# Acceptance failure is distinct from resource exhaustion and malformed CLI input.
foreach(exponent 1 2)
  set(output "${WORK}/failed-acceptance-d${exponent}.sicx")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env SIC_TEST_FAIL_SIC_CHECK=1
    "${PROGRAM}" ${exponent} --out "${output}" --threads 2
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 1 OR NOT err MATCHES "\\[construction\\]" OR EXISTS "${output}")
    message(FATAL_ERROR "acceptance classification/publication failed: ${rc}\n${out}\n${err}")
  endif()
endforeach()
  return()
endif()
execute_process(COMMAND "${PROGRAM}" --help RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT status EQUAL 0 OR NOT out MATCHES "usage: sic-construct" OR NOT err STREQUAL "")
  message(FATAL_ERROR "--help must use stdout and exit 0: ${status} ${out} ${err}")
endif()
function(refuse)
  execute_process(COMMAND "${PROGRAM}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT status MATCHES "^[12]$" OR NOT err MATCHES "sic-construct:" OR out MATCHES "d=|entry error bounds|Newton|quadrature start")
    message(FATAL_ERROR "expected early CLI refusal: ${ARGN}\n${status}\n${out}\n${err}")
  endif()
endfunction()
function(check_orders exponent expected)
  execute_process(COMMAND "${PROGRAM}" "${exponent}" --orders
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc STREQUAL "0" OR NOT out STREQUAL expected OR NOT err STREQUAL "")
    message(FATAL_ERROR "orders for S=${exponent}: ${rc}\n${out}${err}")
  endif()
endfunction()
check_orders(1 "standard 1\n")
check_orders(2 "standard 1\n")
check_orders(3 "maximal 1\nstandard 3\n")
check_orders(7 "maximal 1\nstandard 5\n")
check_orders(8 "standard 1\n")
check_orders(9 "maximal 1\nstandard 3\n")
check_orders(10 "maximal 1\nstandard 5\n")
check_orders(11 "standard 1\n")
refuse(13 --orders)
refuse(7 --orders --out "${WORK}/orders-must-not-write.sicx")
if(EXISTS "${WORK}/orders-must-not-write.sicx")
  message(FATAL_ERROR "order listing published output")
endif()
refuse(--unknown)
refuse(--dimension 5 --out "${WORK}/general-d.sicx")
refuse(--d 6 --out "${WORK}/general-d.sicx")
refuse(2 --out "${WORK}/x.sicx" --step-selection unsupported.json)
refuse(2)
refuse(0 --out "${WORK}/zero.sicx")
refuse(13 --out "${WORK}/unsupported.sicx")
refuse(21 --out "${WORK}/unsupported21.sicx")
refuse(2 --out "${WORK}/duplicate.sicx" --threads 1 --threads 2)
refuse(2 --out)
refuse(2 --out "${WORK}/x.sicx" --threads 0)
refuse(2 --out "${WORK}/x.sicx" --threads 2147483648)
refuse(2 --out "${WORK}/x.sicx" --threads 2x)
refuse(2 --out "${WORK}/x.sicx" --threads +2)
refuse(2 --out "${WORK}/x.sicx" --threads " 2")
refuse(2 --out "${WORK}/x.sicx" --memory-mib +2)
refuse(2 --out "${WORK}/x.sicx" --order=standard)
refuse(2 --out "${WORK}/x.sicx" -- --progress)
refuse(2 --out "${WORK}/x.sicx" --memory-mib nan)
refuse(2 --out "${WORK}/x.sicx" --memory-mib 0)
refuse(2 --out "${WORK}/x.sicx" --order wrong)
refuse(2 --out "${WORK}/x.sicx" --memory-strategy resident)
refuse(2 --out "${WORK}/x.sicx" --resume=1)
refuse(1 --resume --out "${WORK}/d2-resume.sicx")
refuse(2 0 1 7 --out "${WORK}/old-positions.sicx")
refuse(1 0 2 7 --out "${WORK}/x.sicx")
refuse(2 --out "${WORK}/missing/x.sicx")
file(WRITE "${WORK}/stop" "")
refuse(1 --stop-file "${WORK}/stop" --out "${WORK}/stopped-d2.sicx")
refuse(2 --stop-file "${WORK}/stop" --out "${WORK}/stopped.sicx")
file(WRITE "${WORK}/existing.sicx" "preserve me")
refuse(1 --out "${WORK}/existing.sicx")
refuse(2 --out "${WORK}/existing.sicx")
file(READ "${WORK}/existing.sicx" existing)
if(NOT existing STREQUAL "preserve me")
  message(FATAL_ERROR "existing output was modified")
endif()
file(CREATE_LINK "${WORK}/missing-target" "${WORK}/dangling.sicx" SYMBOLIC)
refuse(2 --out "${WORK}/dangling.sicx")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env SIC_ENTRY_ARB=0 SIC_WORK_BITS=512 SIC_ORDER=maximal
  SIC_PHASED_STORAGE=1 SIC_THREADS=3 SIC_STEP_SELECTION=/invalid/ignored.json SIC_SAVE_STEP_SELECTION=/invalid/ignored.json SIC_OUT=/invalid/ignored.sicx SIC_SICX_BLOCK_COORDINATES=32
  "${PROGRAM}" 2 --out "${WORK}/clean.sicx" --order standard --threads 2
  RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT status EQUAL 0 OR NOT out MATCHES "SIC check [^\n]*PASS")
  message(FATAL_ERROR "flags did not override the discarded environment: ${status}\n${out}\n${err}")
endif()
foreach(setting "SIC_ORDER=wrong" "SIC_THREADS=bad" "SIC_SEED_A=garbage" "SIC_FIRST_PASS_BITS=bad")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "${setting}"
    "${PROGRAM}" 5 --out "${WORK}/invalid-environment.sicx" --threads 1
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT status EQUAL 1 OR NOT err MATCHES "\\[invalid_argument\\]" OR
     out MATCHES "d=|entry error bounds|Newton|quadrature start" OR
     EXISTS "${WORK}/invalid-environment.sicx")
    message(FATAL_ERROR "invalid setting was not refused before work: ${setting}: ${status} ${out} ${err}")
  endif()
endforeach()
file(SHA256 "${WORK}/clean.sicx" digest)
if(NOT digest STREQUAL "b5e4771117cd9767d5d096dbb69bde695817aa6f5b872a86370b8e41ce844622")
  message(FATAL_ERROR "inherited settings changed canonical bytes: ${digest}")
endif()

refuse(7 --order standard --memory-strategy phased --out "${WORK}/invalid-phased.sicx")

# F2's private spool is also a resumable output and must be refused before arithmetic.
foreach(suffix .partial .partial.journal .spool.partial .spool.partial.journal)
  set(output "${WORK}/partial-check.sicx")
  file(WRITE "${output}${suffix}" "preserve partial")
  execute_process(COMMAND "${PROGRAM}" 2 --out "${output}" --threads 2
    RESULT_VARIABLE rc OUTPUT_VARIABLE text ERROR_VARIABLE err)
  if(rc EQUAL 0 OR NOT err MATCHES "partial output exists")
    message(FATAL_ERROR "early partial refusal missing for ${suffix}: ${text}\n${err}")
  endif()
  file(READ "${output}${suffix}" kept)
  if(NOT kept STREQUAL "preserve partial" OR EXISTS "${output}")
    message(FATAL_ERROR "partial refusal mutated files")
  endif()
  file(REMOVE "${output}${suffix}")
endforeach()

execute_process(COMMAND "${PROGRAM}" 2 --out "${WORK}/resource.sicx" --memory-mib 1
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 1 OR NOT err MATCHES "\\[resource\\]" OR EXISTS "${WORK}/resource.sicx")
  message(FATAL_ERROR "resource classification failed: ${rc}\n${out}\n${err}")
endif()
execute_process(COMMAND "${PROGRAM}" 2 --out "${WORK}/bad.sicx" --threads 0
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 2 OR NOT err MATCHES "\\[invalid_argument\\]")
  message(FATAL_ERROR "input classification failed: ${rc}\n${out}\n${err}")
endif()
