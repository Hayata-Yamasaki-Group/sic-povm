file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
function(produce name)
  execute_process(COMMAND "${PROGRAM}" 2 --threads 2 --out "${WORK}/${name}.sicx" ${ARGN}
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(rc "${rc}" PARENT_SCOPE)
  set(out "${out}" PARENT_SCOPE)
  set(err "${err}" PARENT_SCOPE)
endfunction()
produce(reference)
if(NOT rc EQUAL 0 OR err MATCHES "ADMISSION |SICX-PROFILE")
  message(FATAL_ERROR "reference: ${rc} ${out} ${err}")
endif()
file(SHA256 "${WORK}/reference.sicx" reference)
produce(policy --maximum-exponent 2 --valuation-table-mib 1 --valuation-total-mib 2 --alignment-seed 1 --log-admissions)
if(NOT rc EQUAL 0 OR NOT err MATCHES "ADMISSION " OR out MATCHES "ADMISSION ")
  message(FATAL_ERROR "policy/observation: ${rc} ${out} ${err}")
endif()
# Compare policy outputs using the same explicit seed; no arbitrary root is pinned.
file(SHA256 "${WORK}/policy.sicx" policy)
produce(seeded --alignment-seed 1)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "seeded reference: ${rc} ${out} ${err}")
endif()
file(STRINGS "${WORK}/seeded.sicx" provenance REGEX "seed")
if(NOT provenance MATCHES "\"seed\":\"1\"")
  message(FATAL_ERROR "alignment seed missing from provenance: ${provenance}")
endif()
file(SHA256 "${WORK}/seeded.sicx" seeded)
if(NOT policy STREQUAL seeded)
  message(FATAL_ERROR "valuation policy changed canonical output")
endif()
produce(observed --log-admissions)
if(NOT rc EQUAL 0 OR NOT err MATCHES "ADMISSION " OR out MATCHES "ADMISSION ")
  message(FATAL_ERROR "admission logging: ${rc} ${out} ${err}")
endif()
file(SHA256 "${WORK}/observed.sicx" observed)
if(NOT observed STREQUAL reference)
  message(FATAL_ERROR "admission logging changed output")
endif()
foreach(args "--maximum-exponent;1" "--maximum-exponent;0" "--maximum-exponent;21"
    "--valuation-table-mib;0" "--valuation-total-mib;0" "--alignment-seed;-1"
    "--alignment-seed;9223372036854775808")
  produce(refused ${args})
  if(NOT rc EQUAL 2 OR NOT err MATCHES "\\[invalid_argument\\]" OR EXISTS "${WORK}/refused.sicx")
    message(FATAL_ERROR "invalid ${args}: ${rc} ${out} ${err}")
  endif()
endforeach()
produce(refused --valuation-table-mib 2 --valuation-total-mib 1)
if(NOT rc EQUAL 1 OR NOT err MATCHES "\\[invalid_argument\\]" OR EXISTS "${WORK}/refused.sicx")
  message(FATAL_ERROR "inconsistent valuation policy: ${rc} ${out} ${err}")
endif()
if(HOOKS)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env SIC_TEST_KILL_AFTER_WRITE=1
    "${PROGRAM}" 2 --threads 2 --alignment-seed 1 --out "${WORK}/resume.sicx"
    RESULT_VARIABLE killed OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT killed EQUAL 86 OR NOT EXISTS "${WORK}/resume.sicx.sicx-quarantine")
    message(FATAL_ERROR "checkpoint: ${killed} ${out} ${err}")
  endif()
  file(SHA256 "${WORK}/resume.sicx.sicx-quarantine" before)
  produce(resume --resume --alignment-seed 2)
  file(SHA256 "${WORK}/resume.sicx.sicx-quarantine" after)
  if(NOT rc EQUAL 1 OR NOT err MATCHES "\\[integrity\\]" OR NOT err MATCHES "plan digest" OR EXISTS "${WORK}/resume.sicx" OR NOT before STREQUAL after)
    message(FATAL_ERROR "changed seed resume: ${rc} ${out} ${err}")
  endif()
endif()
