file(SHA256 "${INPUT}" hash)
if(NOT hash STREQUAL EXPECTED)
  message(FATAL_ERROR "committed V1 fixture digest differs")
endif()
execute_process(COMMAND "${VERIFY}" "${INPUT}" --threads 2 RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "V1 full verification failed: ${out}\n${err}")
endif()
set(CMD "${DECODE}")
set(THREADS 1 4 16)
set(ARGS "--no-pin")
include("${IDENTITY_SCRIPT}")
set(output "${WORK}/reencoded.sicx")
execute_process(COMMAND "${SICX}" reencode "${INPUT}" "${output}" --threads 2 RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "V1 file route failed: ${out}\n${err}")
endif()
file(SHA256 "${output}" after)
if(NOT hash STREQUAL after)
  message(FATAL_ERROR "V1 file route changed bytes")
endif()
