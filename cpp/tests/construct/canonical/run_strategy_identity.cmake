# Exact bytes and certifications must be independent of retention and worker count.
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
# The odd d128 plan matrix runs outside CTest under the bounded validation runner.
# Keep the registered control near its base runtime; sample automatic retention at d16.
if(NOT DEFINED IDENTITY_CASE)
  set(IDENTITY_CASE all)
endif()
if(IDENTITY_CASE MATCHES "^s([2-6])$")
  set(_exponents "${CMAKE_MATCH_1}")
elseif(IDENTITY_CASE STREQUAL "all")
  set(_exponents 2 3 4 5 6)
elseif(IDENTITY_CASE STREQUAL "reduced")
  set(_exponents)
else()
  message(FATAL_ERROR "unknown strategy identity case: ${IDENTITY_CASE}")
endif()
foreach(s IN LISTS _exponents)
  set(plans keep spill)
  if(s EQUAL 4)
    list(APPEND plans auto)
  endif()
  foreach(plan IN LISTS plans)
    set(control)
    if(plan STREQUAL "keep")
      set(control SIC_DEV_KEEP_ALL=1)
    elseif(plan STREQUAL "spill")
      set(control SIC_DEV_SPILL=1)
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${control}
      "${PROGRAM}" "${s}" --order standard --threads 2 --memory-mib 4096
      --out "${WORK}/s${s}-${plan}.sicx"
      RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
    file(WRITE "${WORK}/s${s}-${plan}.log" "${out}${err}")
    if(NOT status EQUAL 0 OR NOT out MATCHES "SIC check [^\n]*PASS")
      message(FATAL_ERROR "s=${s} ${plan} failed: ${status}\n${out}\n${err}")
    endif()
    if(plan STREQUAL "spill" AND NOT out MATCHES "memory final plan: bounded=1")
      message(FATAL_ERROR "forced spill did not run the bounded backend")
    endif()
    if(plan STREQUAL "keep" AND out MATCHES "memory item: [^\n]*plan=(spill|recompute)")
      message(FATAL_ERROR "forced keep did not retain all optional items")
    endif()
    file(SHA256 "${WORK}/s${s}-${plan}.sicx" digest_${plan})
  endforeach()
  if(NOT digest_keep STREQUAL digest_spill)
    message(FATAL_ERROR "s=${s}: plan bytes differ")
  endif()
  if(s EQUAL 4 AND NOT digest_auto STREQUAL digest_keep)
    message(FATAL_ERROR "s=${s}: automatic plan bytes differ")
  endif()
  file(APPEND "${WORK}/identity.sha256" "${digest_keep}  s${s} keep=spill (automatic sampled at s4)\n")
  file(REMOVE "${WORK}/s${s}-keep.sicx" "${WORK}/s${s}-spill.sicx" "${WORK}/s${s}-auto.sicx")
endforeach()
if(IDENTITY_CASE STREQUAL "all" OR IDENTITY_CASE STREQUAL "reduced")
# Reduced-order layouts retain their full table and still plan exact leaves independently.
execute_process(COMMAND "${CMAKE_COMMAND}" -E env SIC_DEV_SPILL=1 "${PROGRAM}" 3
  --order maximal --threads 2 --out "${WORK}/reduced.sicx"
  RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT status EQUAL 0 OR NOT out MATCHES "SIC check [^\n]*PASS")
  message(FATAL_ERROR "reduced-order execution failed: ${out}\n${err}")
endif()
foreach(order standard maximal)
  execute_process(COMMAND "${PROGRAM}" 11 --order "${order}" --memory-mib 1
    --out "${WORK}/d2048-${order}.sicx" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(status EQUAL 0 OR NOT err MATCHES "resource admission rejected before Group construction" OR out MATCHES "quadrature start|Newton|Galois FFT")
    message(FATAL_ERROR "metadata-only refusal failed: ${status}\n${out}\n${err}")
  endif()
endforeach()
endif()
