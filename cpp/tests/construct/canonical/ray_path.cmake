file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
function(expect code diagnostic)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${rc}" STREQUAL "${code}" OR NOT "${out}${err}" MATCHES "${diagnostic}")
    message(FATAL_ERROR "${ARGN}: expected ${code}/${diagnostic}, got ${rc}: ${out}${err}")
  endif()
  set(output "${out}" PARENT_SCOPE)
  set(error_output "${err}" PARENT_SCOPE)
endfunction()
function(same_bytes expected actual)
  file(SHA256 "${expected}" a)
  file(SHA256 "${actual}" b)
  if(NOT a STREQUAL b)
    message(FATAL_ERROR "different bytes: ${expected} and ${actual}")
  endif()
endfunction()
function(expect_d16_counters log batches passes)
  if(NOT log MATCHES "(^|\n)FINALIZE-MEMORY batches=${batches} packing_batches=[1-9][0-9]* packing_peak_rays=[1-9][0-9]* passes=${passes}(\n|$)" OR
     NOT log MATCHES "(^|\n)DECODE d=16 [^\n]*passes=${passes} replays=0(\n|$)")
    message(FATAL_ERROR "expected ${batches} d16 batches, ${passes} passes and zero replays: ${log}")
  endif()
endfunction()

set(exact "${WORK}/exact.sicx")
set(list "${WORK}/rays.json")
set(threads --threads 2)
if(S EQUAL 1)
  set(projection --dimension-two)
else()
  set(group --group-cache "${WORK}/group.bin")
  set(projection --group "${WORK}/group.bin")
endif()
expect(0 "ray selection started .*ray selection complete:" "${BIN}/sic-construct"
  "${S}" --order "${ORDER}" --progress --out "${exact}" --rays-out "${list}" ${group} ${threads})
expect(0 "." "${BIN}/sic-ray-selector" derive ${projection} --threads 1)
set(entry "${output}")
expect(0 "." "${BIN}/sic-ray-selector" check ${projection} --words "${list}" ${threads})
if(NOT output STREQUAL entry)
  message(FATAL_ERROR "checkpoint check differs from checkpoint derive")
endif()
file(READ "${list}" rays)
foreach(field IN ITEMS smith words)
  string(JSON actual GET "${rays}" "${field}")
  string(JSON expected GET "${entry}" "${field}")
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "in-process and checkpoint ${field} differ")
  endif()
endforeach()
string(JSON count LENGTH "${rays}" labels)
if(NOT count EQUAL COUNT)
  message(FATAL_ERROR "expected ${COUNT} rays, got ${count}")
endif()
math(EXPR last "${count}-1")

set(automatic "${WORK}/automatic.sicx")
set(explicit "${WORK}/explicit.sicx")
set(serial "${WORK}/serial.sicx")
foreach(file "${automatic}" "${explicit}" "${serial}")
  file(COPY_FILE "${exact}" "${file}")
endforeach()
expect(0 "FINALIZED" "${BIN}/sic-decode" "${automatic}" "${WORK}/auto" --finalize --ray-list "${list}" ${threads} --no-pin)
set(log "${output}")
foreach(i RANGE 0 ${last})
  string(JSON label GET "${rays}" labels "${i}")
  string(JSON word GET "${rays}" words "${i}")
  if(NOT label STREQUAL "c${i}" OR NOT log MATCHES "RAY ${label} automatic anchor=([0-9]+)")
    message(FATAL_ERROR "missing or mislabelled automatic anchor at ${i}: ${log}")
  endif()
  list(APPEND chosen --ray "${label}" "${word}" "${CMAKE_MATCH_1}")
endforeach()
expect(0 "FINALIZED" "${BIN}/sic-decode" "${explicit}" "${WORK}/explicit" --finalize ${chosen} ${threads} --no-pin)
expect(0 "FINALIZED" "${BIN}/sic-decode" "${serial}" "${WORK}/serial" --finalize --ray-list "${list}" --threads 1 --no-pin)
same_bytes("${automatic}" "${explicit}")
same_bytes("${automatic}" "${serial}")
foreach(i RANGE 0 ${last})
  same_bytes("${WORK}/auto/c${i}.fp64.txt" "${WORK}/explicit/c${i}.fp64.txt")
  same_bytes("${WORK}/auto/c${i}.fp64.txt" "${WORK}/serial/c${i}.fp64.txt")
endforeach()
expect(0 "PASS full:" "${BIN}/sic-verify" "${automatic}" ${threads})

if(S EQUAL 6)
  file(COPY_FILE "${exact}" "${WORK}/four.sicx")
  expect(0 "FINALIZE-MEMORY batches=1 packing_batches=1 packing_peak_rays=4"
    "${BIN}/sic-decode" "${WORK}/four.sicx" "${WORK}/four" --finalize --ray-list "${list}"
    --threads 4 --no-pin --check-budget --memory-mib 256)
  file(SHA256 "${WORK}/four.sicx" digest)
  if(NOT output MATCHES "FINALIZED [^\n]+ sha256=${digest}([\n]|$)")
    message(FATAL_ERROR "reported digest differs from the finalized file: ${output}")
  endif()
  same_bytes("${automatic}" "${WORK}/four.sicx")
  foreach(i RANGE 0 ${last})
    foreach(kind raw.balls normalized.balls fp64.txt)
      same_bytes("${WORK}/auto/c${i}.${kind}" "${WORK}/four/c${i}.${kind}")
    endforeach()
  endforeach()
endif()

if(S EQUAL 1)
  string(JSON wrong_word SET "${rays}" words 0 "\"1\"")
  string(JSON wrong_label SET "${rays}" labels 0 "\"c1\"")
  string(JSON extra_ray SET "${rays}" words 1 "\"1\"")
  string(JSON extra_ray SET "${extra_ray}" labels 1 "\"c1\"")
  foreach(mutation wrong_word wrong_label extra_ray)
    file(WRITE "${WORK}/${mutation}.json" "${${mutation}}")
    expect(1 "invalid_format.*closed-form ray list" "${BIN}/sic-decode" "${exact}" "${WORK}/wrong"
      --finalize --ray-list "${WORK}/${mutation}.json" ${threads} --no-pin)
  endforeach()
endif()

if(S EQUAL 2)
  expect(0 "SIC check .*PASS" "${BIN}/sic-construct" "${S}" --order "${ORDER}"
    --out "${WORK}/without-rays.sicx" ${threads})
  same_bytes("${exact}" "${WORK}/without-rays.sicx")
  string(REPEAT "0" 64 wrong)
  string(JSON mismatched SET "${rays}" exact_root "\"${wrong}\"")
  file(WRITE "${WORK}/wrong.json" "${mismatched}")
  expect(1 "integrity.*exact root" "${BIN}/sic-decode" "${exact}" "${WORK}/wrong"
    --finalize --ray-list "${WORK}/wrong.json" ${threads} --no-pin)
  string(JSON bad_label SET "${rays}" labels 0 "\"c1\"")
  file(WRITE "${WORK}/wrong.json" "${bad_label}")
  expect(1 "invalid_format.*ray labels must be consecutive from c0" "${BIN}/sic-decode" "${exact}" "${WORK}/wrong"
    --finalize --ray-list "${WORK}/wrong.json" ${threads} --no-pin)
  expect(2 "invalid_argument" "${BIN}/sic-decode" "${exact}" "${WORK}/wrong"
    --ray-list "${list}" --finalize --ray c0 0,0,0 auto ${threads} --no-pin)
  expect(2 "--rays cannot be used with --finalize" "${BIN}/sic-decode" "${exact}" "${WORK}/wrong"
    --rays all --finalize --ray-list "${list}" ${threads} --no-pin)
  expect(2 "--ray-list FILE requires --finalize" "${BIN}/sic-decode" "${exact}" "${WORK}/wrong"
    --ray-list "${list}" ${threads} --no-pin)
  expect(2 "invalid_argument" "${BIN}/sic-decode" "${exact}" "${WORK}/wrong"
    --ray c0 0,0,0 auto ${threads} --no-pin)
  file(COPY_FILE "${exact}" "${WORK}/direct.sicx")
  expect(0 "FINALIZED" "${BIN}/sic-decode" "${WORK}/direct.sicx" "${WORK}/direct"
    --finalize --ray c0 0,0,0 auto --threads 1 --no-pin)
  same_bytes("${automatic}" "${WORK}/direct.sicx")
endif()
message(STATUS "${S}/${ORDER}: ${COUNT} checkpoint words; automatic, explicit and serial SICX match")

if(COUNT GREATER 1)
  file(SHA256 "${list}" pin)
  string(JSON shortened REMOVE "${rays}" labels "${last}")
  string(JSON shortened REMOVE "${shortened}" words "${last}")
  file(WRITE "${WORK}/shortened.json" "${shortened}\n")
  expect(1 "integrity.*ray list SHA-256" "${BIN}/sic-decode" "${exact}" "${WORK}/shortened"
    --finalize --ray-list "${WORK}/shortened.json" --rays-sha256 "${pin}" ${threads} --no-pin)
  if(EXISTS "${WORK}/shortened" OR EXISTS "${exact}.partial.journal")
    message(FATAL_ERROR "a same-root shortened list reached finalization")
  endif()
endif()

if(HOOKS AND S EQUAL 4)
  expect_d16_counters("${log}" 1 1)
  file(COPY_FILE "${exact}" "${WORK}/serial-fast.sicx")
  expect(0 "FINALIZED"
    "${CMAKE_COMMAND}" -E env SIC_TEST_FINALIZATION_BATCH_RAYS=1 "${BIN}/sic-decode"
    "${WORK}/serial-fast.sicx" "${WORK}/serial-fast" --finalize --ray-list "${list}" --threads 1 --no-pin)
  expect_d16_counters("${output}" "${COUNT}" "${COUNT}")
  same_bytes("${automatic}" "${WORK}/serial-fast.sicx")

  math(EXPR total_outputs "${COUNT} * 16")
  math(EXPR split_passes "${COUNT} + 1")
  file(COPY_FILE "${exact}" "${WORK}/refusal.sicx")
  expect(0 "FINALIZED"
    "${CMAKE_COMMAND}" -E env --unset=SIC_TEST_FINALIZATION_BATCH_RAYS
    SIC_TEST_FINALIZATION_REFUSE_FIRST_BATCH=1 "${BIN}/sic-decode"
    "${WORK}/refusal.sicx" "${WORK}/refusal" --finalize --ray-list "${list}" --threads 1 --no-pin --profile)
  expect_d16_counters("${output}" 1 "${split_passes}")
  if(NOT error_output MATCHES "pass 1 precision=([0-9]+) outputs=${total_outputs}\n")
    message(FATAL_ERROR "missing first shared pass: ${error_output}")
  endif()
  set(bits "${CMAKE_MATCH_1}")
  string(FIND "${error_output}" "SICX-PROFILE level 1 " first_level)
  string(FIND "${error_output}" "test finalization batch refusal" refusal)
  if(first_level LESS 0 OR NOT first_level LESS refusal)
    message(FATAL_ERROR "d16 refusal did not follow shared tree preparation: ${error_output}")
  endif()
  if(NOT error_output MATCHES "precision refusal at ${bits}: [^\n]*test finalization batch refusal\n" OR
     NOT error_output MATCHES "retrying pending rays independently at ${bits} bits\n")
    message(FATAL_ERROR "d16 refusal did not split the rays at the current precision: ${error_output}")
  endif()
  string(REGEX MATCHALL "pass 1 precision=${bits} outputs=16\n" ray_passes "${error_output}")
  list(LENGTH ray_passes ray_pass_count)
  if(NOT ray_pass_count EQUAL COUNT)
    message(FATAL_ERROR "expected ${COUNT} independent passes, got ${ray_pass_count}: ${error_output}")
  endif()
  same_bytes("${automatic}" "${WORK}/refusal.sicx")
  same_bytes("${WORK}/serial-fast.sicx" "${WORK}/refusal.sicx")
  foreach(i RANGE 0 ${last})
    foreach(kind raw.balls normalized.balls fp64.txt)
      same_bytes("${WORK}/auto/c${i}.${kind}" "${WORK}/refusal/c${i}.${kind}")
      same_bytes("${WORK}/serial-fast/c${i}.${kind}" "${WORK}/refusal/c${i}.${kind}")
    endforeach()
  endforeach()

  file(STRINGS "${WORK}/auto/c0.raw.balls" fast_raw)
  list(SUBLIST fast_raw 3 -1 fast_retained)
  foreach(mode shared split)
    set(command "${CMAKE_COMMAND}" -E env --unset=SIC_TEST_FINALIZATION_BATCH_RAYS
      SIC_TEST_FINALIZATION_REPLAY_FIRST_OUTPUT=1)
    set(first_outputs "${total_outputs}")
    set(passes 2)
    if(mode STREQUAL split)
      list(APPEND command SIC_TEST_FINALIZATION_BATCH_RAYS=1)
      set(first_outputs 16)
      set(passes "${split_passes}")
    endif()
    set(dest "${WORK}/partial-${mode}")
    file(COPY_FILE "${exact}" "${dest}.sicx")
    expect(0 "passes=${passes} replays=1" ${command} "${BIN}/sic-decode" "${dest}.sicx" "${dest}"
      --finalize --ray-list "${list}" --threads 1 --no-pin --profile)
    if(NOT error_output MATCHES "pass 1 precision=[0-9]+ outputs=${first_outputs}\n" OR
       NOT error_output MATCHES "radius check: 1 outputs replayed\n" OR
       NOT error_output MATCHES "pass 2 precision=[0-9]+ outputs=1\n" OR
       error_output MATCHES "precision refusal")
      message(FATAL_ERROR "partial replay did not keep the passing ray in ${mode}: ${error_output}")
    endif()
    same_bytes("${WORK}/partial-shared.sicx" "${dest}.sicx")
    file(STRINGS "${dest}/c0.raw.balls" partial_raw)
    list(SUBLIST partial_raw 3 -1 partial_retained)
    if(NOT partial_retained STREQUAL fast_retained)
      message(FATAL_ERROR "partial replay changed an accepted c0 coordinate in ${mode}")
    endif()
    foreach(i RANGE 0 ${last})
      foreach(kind raw.balls normalized.balls fp64.txt)
        same_bytes("${WORK}/partial-shared/c${i}.${kind}" "${dest}/c${i}.${kind}")
        if(i GREATER 0)
          same_bytes("${WORK}/auto/c${i}.${kind}" "${dest}/c${i}.${kind}")
        endif()
      endforeach()
    endforeach()
  endforeach()

  set(low_options --target-bits 64 --guard-bits 0 --initial-bits 64)
  set(budget 64)
  if(DEFINED ENV{ASAN_OPTIONS})
    set(budget 512)
  endif()
  math(EXPR smaller_budget "${budget} / 2")
  foreach(mode all smaller retry)
    file(COPY_FILE "${exact}" "${WORK}/${mode}-low.sicx")
    set(command "${CMAKE_COMMAND}" -E env --unset=SIC_TEST_FINALIZATION_BATCH_RAYS)
    set(memory "${budget}")
    if(mode STREQUAL retry)
      list(APPEND command SIC_TEST_FINALIZATION_BATCH_RAYS=1)
      set(expected "${COUNT}")
    else()
      set(expected 1)
    endif()
    if(mode STREQUAL smaller)
      set(memory "${smaller_budget}")
    endif()
    expect(0 "FINALIZE-MEMORY batches=${expected} " ${command} "${BIN}/sic-decode"
      "${WORK}/${mode}-low.sicx" "${WORK}/${mode}-low" --finalize --ray-list "${list}"
      --threads 1 --no-pin --check-budget --profile --memory-mib "${memory}" ${low_options})
    if(NOT output MATCHES "replays=[1-9][0-9]*")
      message(FATAL_ERROR "low-precision finalization did not exercise replay")
    endif()
    if(mode STREQUAL retry AND NOT output MATCHES "retry with at most 1 rays")
      message(FATAL_ERROR "finalization did not exercise resource retry")
    endif()
    string(REGEX MATCHALL "SICX-PROFILE tower payload=" tower_loads "${error_output}")
    list(LENGTH tower_loads tower_load_count)
    if(NOT tower_load_count EQUAL 1)
      message(FATAL_ERROR "expected one decoder tower initialization in ${mode}, got ${tower_load_count}")
    endif()
    same_bytes("${WORK}/all-low.sicx" "${WORK}/${mode}-low.sicx")
    foreach(i RANGE 0 ${last})
      foreach(kind raw.balls normalized.balls fp64.txt)
        same_bytes("${WORK}/all-low/c${i}.${kind}" "${WORK}/${mode}-low/c${i}.${kind}")
      endforeach()
    endforeach()
  endforeach()

  foreach(width 1 2)
    math(EXPR packing_batches "${COUNT} / ${width}")
    file(COPY_FILE "${exact}" "${WORK}/pack-${width}.sicx")
    expect(0 "FINALIZE-MEMORY batches=1 packing_batches=${packing_batches} packing_peak_rays=${width}"
      "${CMAKE_COMMAND}" -E env --unset=SIC_TEST_FINALIZATION_BATCH_RAYS
      "SIC_TEST_FINALIZATION_PACK_RAYS=${width}" "${BIN}/sic-decode"
      "${WORK}/pack-${width}.sicx" "${WORK}/pack-${width}" --finalize --ray-list "${list}"
      --threads 2 --no-pin --check-budget --memory-mib "${budget}")
    same_bytes("${automatic}" "${WORK}/pack-${width}.sicx")
  endforeach()
  file(COPY_FILE "${exact}" "${WORK}/budget-refused.sicx")
  expect(1 "\\[resource\\]" "${BIN}/sic-decode" "${WORK}/budget-refused.sicx" "${WORK}/budget-refused"
    --finalize --ray-list "${list}" --threads 2 --no-pin --check-budget --memory-mib 2)
  same_bytes("${exact}" "${WORK}/budget-refused.sicx")
  if(EXISTS "${WORK}/budget-refused.sicx.partial.journal")
    message(FATAL_ERROR "a refused budget reached finalization publication")
  endif()
endif()
