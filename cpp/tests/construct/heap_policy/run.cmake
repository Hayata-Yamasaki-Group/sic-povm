file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(clean)
# The CLI honors arbitrary MALLOC_* names, including settings unknown to glibc.
execute_process(COMMAND "${CMAKE_COMMAND}" -E environment OUTPUT_VARIABLE inherited
  COMMAND_ERROR_IS_FATAL ANY)
string(REGEX MATCHALL "(^|\n)MALLOC_[^=\n]*=" malloc_keys "${inherited}")
foreach(key IN LISTS malloc_keys)
  string(STRIP "${key}" key)
  string(REGEX REPLACE "=$" "" key "${key}")
  list(APPEND clean "--unset=${key}")
endforeach()
foreach(key MALLOC_ARENA_MAX MALLOC_ARENA_TEST MALLOC_CHECK_ MALLOC_MMAP_MAX_
    MALLOC_MMAP_THRESHOLD_ MALLOC_PERTURB_ MALLOC_TOP_PAD_ MALLOC_TRIM_THRESHOLD_
    MALLOC_CUSTOM_SETTING GLIBC_TUNABLES LD_PRELOAD)
  list(APPEND clean "--unset=${key}")
endforeach()
foreach(case default maximal explicit mmap arena custom empty tunable tcache unrelated misleading)
  set(extra)
  set(order standard)
  set(expected "")
  if(case STREQUAL default OR case STREQUAL maximal)
    set(expected "mmap 33554432 1\ntrim 16777216 1\n")
  elseif(case STREQUAL explicit)
    list(APPEND extra "MALLOC_TRIM_THRESHOLD_=262144")
  elseif(case STREQUAL empty)
    list(APPEND extra "MALLOC_ARENA_MAX=")
  elseif(case STREQUAL mmap)
    list(APPEND extra "MALLOC_MMAP_THRESHOLD_=16777216")
  elseif(case STREQUAL arena)
    list(APPEND extra "MALLOC_ARENA_MAX=16")
  elseif(case STREQUAL custom)
    list(APPEND extra "MALLOC_CUSTOM_SETTING=1")
  elseif(case STREQUAL tunable)
    list(APPEND extra "GLIBC_TUNABLES=glibc.rtld.nns=4:glibc.malloc.trim_threshold=262144")
  elseif(case STREQUAL tcache)
    list(APPEND extra "GLIBC_TUNABLES=glibc.malloc.tcache_count=0")
  elseif(case STREQUAL unrelated)
    list(APPEND extra "GLIBC_TUNABLES=glibc.rtld.nns=4")
    set(expected "mmap 33554432 1\ntrim 16777216 1\n")
  elseif(case STREQUAL misleading)
    list(APPEND extra "GLIBC_TUNABLES=other.glibc.malloc.trim_threshold=262144")
    set(expected "mmap 33554432 1\ntrim 16777216 1\n")
  endif()
  if(case STREQUAL maximal)
    set(order maximal)
  endif()
  set(trace "${WORK}/${case}.trace")
  set(native "${WORK}/${case}.sicx")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${clean} ${extra}
    "LD_PRELOAD=${OBSERVER}" "SIC_TEST_HEAP_TRACE=${trace}"
    "${PROGRAM}" 3 --order "${order}" --threads 2 --memory-mib 1024 --out "${native}"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 20)
  if(NOT status EQUAL 0 OR NOT EXISTS "${native}" OR NOT EXISTS "${trace}")
    message(FATAL_ERROR "heap policy ${case} did not complete: ${status}\n${out}\n${err}")
  endif()
  file(READ "${trace}" actual)
  string(APPEND expected "pthread_create\npthread_result 0\n")
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "heap policy ${case}: expected '${expected}', observed '${actual}'")
  endif()
  file(SHA256 "${native}" digest)
  if(case STREQUAL default)
    set(reference "${digest}")
  elseif(case STREQUAL maximal)
    if(NOT digest STREQUAL "3173c722d8706f33a76ff905c9354b9a77481aa951c472fc17cb1d9fef8a0f04")
      message(FATAL_ERROR "maximal heap policy changed native bytes: ${digest}")
    endif()
  elseif(NOT digest STREQUAL reference)
    message(FATAL_ERROR "heap policy ${case} changed native bytes")
  endif()
endforeach()

# Refused allocator settings preserve construction and do not emit an error.
foreach(fault mmap trim)
  set(trace "${WORK}/fail-${fault}.trace")
  set(native "${WORK}/fail-${fault}.sicx")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${clean}
    "LD_PRELOAD=${OBSERVER}" "SIC_TEST_HEAP_TRACE=${trace}" "SIC_TEST_HEAP_FAIL=${fault}"
    "${PROGRAM}" 3 --threads 2 --memory-mib 1024 --out "${native}"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 20)
  if(NOT status EQUAL 0 OR NOT EXISTS "${native}" OR NOT err STREQUAL "")
    message(FATAL_ERROR "heap refusal ${fault}: ${status}\n${out}\n${err}")
  endif()
  file(READ "${trace}" actual)
  if(fault STREQUAL mmap)
    set(expected "mmap 33554432 0\n")
  else()
    set(expected "mmap 33554432 1\ntrim 16777216 0\n")
  endif()
  string(APPEND expected "pthread_create\npthread_result 0\n")
  file(SHA256 "${native}" digest)
  if(NOT digest STREQUAL reference)
    message(FATAL_ERROR "heap refusal ${fault} changed native bytes")
  endif()
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "heap refusal ${fault} performed unexpected work: '${actual}'")
  endif()
endforeach()
