file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
foreach(s 1 2 4)
  set(extra)
  if(s EQUAL 1)
    list(APPEND extra --radicals "${RADICALS}")
  endif()
  set(output "${WORK}/s${s}.sicx")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env SIC_TEST_FAIL_SIC_CHECK=1
    "${PROGRAM}" ${s} --threads 2 --out "${output}" ${extra}
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${out}${err}" MATCHES "(injected SIC refusal|SIC check [^\n]*FAIL)")
    message(FATAL_ERROR "injection did not reach the SIC gate: ${out}\n${err}")
  endif()
  if(NOT status EQUAL 1 OR EXISTS "${output}" OR EXISTS "${output}.sicx-quarantine")
    message(FATAL_ERROR "SIC refusal published/leaked a completed output at s=${s}: ${status}\n${out}\n${err}")
  endif()
  if(s GREATER 1)
    execute_process(COMMAND "${PROGRAM}" ${s} --threads 2 --resume --out "${output}"
      RESULT_VARIABLE resumed OUTPUT_VARIABLE resumed_out ERROR_VARIABLE resumed_err)
    if(NOT resumed EQUAL 0 OR NOT resumed_out MATCHES "SIC check [^\n]*PASS" OR NOT EXISTS "${output}")
      message(FATAL_ERROR "resume after SIC refusal failed: ${resumed_out}\n${resumed_err}")
    endif()
    execute_process(COMMAND "${PROGRAM}" ${s} --threads 2 --out "${output}.reference"
      RESULT_VARIABLE fresh OUTPUT_QUIET ERROR_VARIABLE fresh_err)
    if(NOT fresh EQUAL 0)
      message(FATAL_ERROR "fresh refusal control failed: ${fresh_err}")
    endif()
    file(SHA256 "${output}" actual)
    file(SHA256 "${output}.reference" expected)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "resume after SIC refusal changed canonical bytes")
    endif()
  endif()
endforeach()
execute_process(COMMAND "${PROGRAM}" 2 --out "${WORK}/reserved.sicx-quarantine"
  RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(status EQUAL 0 OR NOT err MATCHES "reserved producer scratch namespace" OR out MATCHES "entry error bounds")
  message(FATAL_ERROR "scratch namespace not refused before construction")
endif()
