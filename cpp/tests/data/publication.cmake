cmake_minimum_required(VERSION 3.20)
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
function(run expected tool)
  execute_process(COMMAND "${BIN}/${tool}" ${ARGN} RESULT_VARIABLE status
    OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 25)
  if(NOT status EQUAL expected)
    message(FATAL_ERROR "${tool}: expected ${expected}, got ${status}: ${out}${err}")
  endif()
  if(expected EQUAL 1 AND NOT err MATCHES "\\[io\\]")
    message(FATAL_ERROR "expected io refusal: ${err}")
  endif()
  set(last_error "${err}" PARENT_SCOPE)
endfunction()
function(refuse path message tool)
  file(SHA256 "${path}" before)
  run(1 "${tool}" ${ARGN})
  string(FIND "${last_error}" "${message}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "missing collision message ${message}: ${last_error}")
  endif()
  file(SHA256 "${path}" after)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "collision changed ${path}")
  endif()
endfunction()
# JSON ray and all-in-one publication paths.
run(0 sic-inspect "${FIXTURE}" --json-rays "${WORK}/rays" --multiplet m1)
refuse("${WORK}/rays/c0.json" "output exists:" sic-inspect
  "${FIXTURE}" --json-rays "${WORK}/rays" --multiplet m1)
run(0 sic-inspect "${FIXTURE}" --json-all "${WORK}/all.json" --multiplet m1)
refuse("${WORK}/all.json" "output exists:" sic-inspect
  "${FIXTURE}" --json-all "${WORK}/all.json" --multiplet m1)
file(READ "${WORK}/all.json" all)
if(NOT all MATCHES "sic-fiducial-json")
  message(FATAL_ERROR "all-in-one JSON omitted the ray document")
endif()
# numeric.cpp's no-replace writer: bundle reaches write_new without a separate output preflight.
run(0 sic-data bundle "${WORK}/bundle.npz" 4 "${WORK}/rays/c0.json")
run(0 sic-data check-bundle "${WORK}/bundle.npz" "${WORK}/rays/c0.json")
refuse("${WORK}/bundle.npz" "output exists:" sic-data bundle
  "${WORK}/bundle.npz" 4 "${WORK}/rays/c0.json")
# Exact export's recoverable staging path must publish the full document and refuse replacement.
run(0 sic-inspect "${FIXTURE}" --exact-json "${WORK}/exact.json" --multiplet m1)
refuse("${WORK}/exact.json" "output exists" sic-inspect
  "${FIXTURE}" --exact-json "${WORK}/exact.json" --multiplet m1)
file(READ "${WORK}/exact.json" exact)
if(NOT exact MATCHES "sic-exact-json/1.0" OR EXISTS "${WORK}/exact.json.partial")
  message(FATAL_ERROR "incomplete exact publication")
endif()
# The CLI preserves its earlier nonempty-directory refusal; the unit tests the writer directly.
file(MAKE_DIRECTORY "${WORK}/decode")
file(WRITE "${WORK}/decode/decode.provenance.json" "preserved provenance\n")
refuse("${WORK}/decode/decode.provenance.json" "output directory must be absent or empty:" sic-decode
  "${FIXTURE}" "${WORK}/decode" --threads 1 --no-pin)
file(REMOVE_RECURSE "${WORK}/decode")
run(0 sic-decode "${FIXTURE}" "${WORK}/decode" --threads 1 --no-pin)
file(READ "${WORK}/decode/decode.provenance.json" provenance)
string(JSON decoder GET "${provenance}" decoder)
string(JSON dimension GET "${provenance}" d)
string(JSON workers GET "${provenance}" workers)
if(NOT decoder STREQUAL "sic-decode/1.0" OR NOT dimension EQUAL 4 OR NOT workers EQUAL 1)
  message(FATAL_ERROR "wrong published decoder provenance: ${provenance}")
endif()
# Removed option spellings must fail as usage errors, with no compatibility aliases.
foreach(option valuation-table valuation-total alignment-memory alignment-cache alignment-batch alignment-worker)
  execute_process(COMMAND "${BIN}/sic-construct" 2 --out "${WORK}/unused.sicx" "--${option}-mb" 1
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE err TIMEOUT 10)
  if(NOT status EQUAL 2 OR NOT err MATCHES "unknown option")
    message(FATAL_ERROR "removed option accepted: ${option}: ${status}: ${err}")
  endif()
endforeach()
execute_process(COMMAND "${BIN}/sic-decode" "${FIXTURE}" "${WORK}/unused" --prefetch-mb 1
  RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE err TIMEOUT 10)
if(NOT status EQUAL 2 OR NOT err MATCHES "unknown option")
  message(FATAL_ERROR "removed prefetch option accepted: ${status}: ${err}")
endif()

# A dangling target is still an existing directory entry.
file(CREATE_LINK "${WORK}/missing-bundle" "${WORK}/dangling.npz" SYMBOLIC)
run(1 sic-data bundle "${WORK}/dangling.npz" 4 "${WORK}/rays/c0.json")
if(NOT last_error MATCHES "output exists:" OR NOT IS_SYMLINK "${WORK}/dangling.npz")
  message(FATAL_ERROR "dangling bundle target was followed: ${last_error}")
endif()
file(CREATE_LINK "${WORK}/missing-numeric" "${WORK}/rays/c0.npy" SYMBOLIC)
run(1 sic-data write "${WORK}/rays/c0.json" "${WORK}/rays" --formats npy)
if(NOT last_error MATCHES "output exists" OR NOT IS_SYMLINK "${WORK}/rays/c0.npy")
  message(FATAL_ERROR "dangling numeric target was followed: ${last_error}")
endif()
