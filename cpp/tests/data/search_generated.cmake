include("${CMAKE_CURRENT_LIST_DIR}/generate.cmake")
file(REMOVE_RECURSE "${WORK}")
set(root "${WORK}/release")
if(OVERLAPS)
  sic_generate_layout("${BIN}" "${root}" "${INPUT}" 1 64)
  sic_run("${BIN}/sic-overlaps" "${root}/d64/m1/c0.csv" --vectors)
  return()
endif()
sic_generate_wh("${BIN}" "${WORK}/maximal" 3 maximal)
sic_generate_wh("${BIN}" "${WORK}/standard" 3 standard)
sic_generate_layout("${BIN}" "${root}" "${WORK}/maximal/multiplet.sicx" 1 8)
sic_generate_layout("${BIN}" "${root}" "${WORK}/standard/multiplet.sicx" 2 8)
sic_run("${BIN}/sic-inspect" --catalogue "${root}")
set(catalogue "${root}/catalogue.json")
execute_process(COMMAND "${BIN}/sic-identify" "${root}/d8/m2/c0.csv" --catalogue "${catalogue}"
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc STREQUAL "0" OR NOT out MATCHES "MATCH d8-m2-c0 ")
  message(FATAL_ERROR "generated catalogue identification: ${rc}\n${out}${err}")
endif()
sic_run("${BIN}/sic-stabilizer" --dim 8 --catalogue "${catalogue}" --out "${root}/d8/stabilizers.txt")
sic_run("${BIN}/sic-inspect" --catalogue "${root}")
file(READ "${catalogue}" result)
if(NOT result MATCHES "d8/stabilizers.txt")
  message(FATAL_ERROR "catalogue omitted the generated stabilizer table")
endif()
