include("${CMAKE_CURRENT_LIST_DIR}/generate.cmake")
file(REMOVE_RECURSE "${WORK}")
set(root "${WORK}/release")
set(generated)
set(oracles)
foreach(case IN LISTS CASES)
  string(REPLACE ":" ";" fields "${case}")
  list(GET fields 0 d)
  list(GET fields 1 exponent)
  list(GET fields 2 m)
  list(GET fields 3 order)
  if(d EQUAL 2)
    sic_generate_d2("${BIN}" "${WORK}/d2")
    set(input "${WORK}/d2/d2.sicx")
  elseif(d EQUAL 256)
    set(input "${INPUT_D256}")
  elseif(EXISTS "${FRESH}/d${d}/d${d}.sicx" AND order STREQUAL "standard" AND d LESS_EQUAL 64)
    set(input "${FRESH}/d${d}/d${d}.sicx")
  elseif(d EQUAL 8 AND order STREQUAL "maximal")
    set(input "${FRESH}/d8-maximal/d8-maximal.sicx")
  else()
    set(dir "${WORK}/d${d}-${order}")
    sic_generate_wh("${BIN}" "${dir}" "${exponent}" "${order}" "${THREADS}")
    set(input "${dir}/multiplet.sicx")
  endif()
  sic_generate_layout("${BIN}" "${root}" "${input}" "${m}" "${d}")
  file(GLOB rays "${root}/d${d}/m${m}/c*.csv")
  file(GLOB expected "${ORACLES}/d${d}/m${m}/c*/fiducial-fp64.csv")
  list(LENGTH rays ray_count)
  list(LENGTH expected expected_count)
  if(NOT ray_count OR NOT ray_count EQUAL expected_count)
    message(FATAL_ERROR "generated ray count differs from the archive for d${d}/m${m}")
  endif()
  list(APPEND generated ${rays})
  list(APPEND oracles ${expected})
endforeach()
sic_run("${TEST}" ${generated} --oracles ${oracles})
message(STATUS "Generated fiducials passed Clifford checks and archived oracle comparison")
