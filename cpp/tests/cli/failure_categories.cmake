function(run name code kind tool)
  set(out "")
  set(output_args OUTPUT_VARIABLE out)
  if(name MATCHES "-stdout$")
    set(output_args OUTPUT_FILE /dev/full)
  endif()
  execute_process(COMMAND "${BIN}/${tool}" ${ARGN} RESULT_VARIABLE rc
    ${output_args} ERROR_VARIABLE err TIMEOUT 25 WORKING_DIRECTORY "${WORK}")
  if(NOT "${rc}" STREQUAL "${code}")
    message(FATAL_ERROR "${name}: expected exit ${code}, got ${rc}: ${out}${err}")
  endif()
  if(kind STREQUAL "help")
    if(NOT out MATCHES "usage: " OR NOT err STREQUAL "")
      message(FATAL_ERROR "${name}: help streams: ${out}${err}")
    endif()
  elseif(kind STREQUAL "standard")
    # Explicit baseline controls for standard exceptions/status returns. Conversion
    # owners extend these cases when their library categories become available.
    if(err MATCHES "\\[[a-z_]+\\]" OR err MATCHES "usage: ")
      message(FATAL_ERROR "${name}: unexpected category/usage: ${out}${err}")
    endif()
  else()
    if(NOT err MATCHES ": \\[${kind}\\] " OR (code EQUAL 1 AND err MATCHES "usage: "))
      message(FATAL_ERROR "${name}: expected [${kind}] without runtime usage: ${out}${err}")
    endif()
    if(tool MATCHES "^sic-(check|identify|overlaps|stabilizer)$" AND NOT err MATCHES "(^|\n)${tool}: ")
      message(FATAL_ERROR "${name}: expected tool-name prefix: ${err}")
    endif()
  endif()
  file(APPEND "${WORK}/cases.tsv" "${name}\t${tool}\t${rc}\t${kind}\n")
  set(last_out "${out}" PARENT_SCOPE)
  set(last_err "${err}" PARENT_SCOPE)
endfunction()
