execute_process(COMMAND "${BIN}/sic-identify" "${FIDUCIAL}" --repo "${DATA}" --catalogue "${DATA}/catalogue.tsv"
  --unitary-only --entry-error 1e-14 RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0 OR NOT out MATCHES "MATCH d4 " OR NOT out MATCHES "\\(unitary\\)" OR NOT out MATCHES "entry error 1.000e-14")
  message(FATAL_ERROR "identify: ${rc} ${out} ${err}")
endif()
string(REGEX MATCH "z_error_bound_per_input ([^ ]+)" match "${out}")
set(identify_high "${CMAKE_MATCH_1}")
execute_process(COMMAND "${BIN}/sic-identify" "${FIDUCIAL}" --repo "${DATA}" --catalogue "${DATA}/catalogue.tsv"
  --unitary-only --entry-error 0 RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
string(REGEX MATCH "z_error_bound_per_input ([^ ]+)" match "${out}")
if(NOT rc EQUAL 0 OR identify_high STREQUAL "" OR CMAKE_MATCH_1 STREQUAL "" OR identify_high STREQUAL CMAKE_MATCH_1)
  message(FATAL_ERROR "identify entry error did not change bound: ${rc} ${out} ${err}")
endif()
execute_process(COMMAND "${BIN}/sic-stabilizer" --dim 4 --repo "${DATA}" --catalogue "${DATA}/catalogue.tsv"
  --entry-error 1e-14 RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0 OR NOT out MATCHES "z_error_bound [1-9]" OR NOT out MATCHES "closed yes exhaustive yes")
  message(FATAL_ERROR "stabilizer: ${rc} ${out} ${err}")
endif()
string(REGEX MATCH "z_error_bound [^ ]+" bound_high "${out}")
execute_process(COMMAND "${BIN}/sic-stabilizer" --dim 4 --repo "${DATA}" --catalogue "${DATA}/catalogue.tsv"
  --entry-error 0 RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
string(REGEX MATCH "z_error_bound [^ ]+" bound_zero "${out}")
if(NOT rc EQUAL 0 OR bound_high STREQUAL bound_zero OR bound_zero STREQUAL "")
  message(FATAL_ERROR "entry-error did not change stabilizer bound: ${rc} ${out} ${err}")
endif()
foreach(tool sic-identify sic-stabilizer)
  foreach(value -1 nan inf)
    if(tool STREQUAL sic-identify)
      set(input "${FIDUCIAL}" --unitary-only)
    else()
      set(input --dim 4)
    endif()
    execute_process(COMMAND "${BIN}/${tool}" ${input} --repo "${DATA}" --entry-error ${value}
      RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 2 OR NOT err MATCHES "\\[invalid_argument\\]" OR NOT out STREQUAL "")
      message(FATAL_ERROR "${tool} invalid entry error: ${rc} ${out} ${err}")
    endif()
  endforeach()
endforeach()

# Complex conjugation supplies a d8 ray whose only match in this catalogue is antiunitary.
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
file(STRINGS "${D8}" rows)
file(WRITE "${WORK}/conjugate.csv" "index,real,imag\n")
list(REMOVE_AT rows 0)
foreach(row IN LISTS rows)
  string(REPLACE "," ";" fields "${row}")
  list(GET fields 0 index)
  list(GET fields 1 real)
  list(GET fields 2 imag)
  if(imag MATCHES "^-")
    string(SUBSTRING "${imag}" 1 -1 imag)
  else()
    set(imag "-${imag}")
  endif()
  file(APPEND "${WORK}/conjugate.csv" "${index},${real},${imag}\n")
endforeach()
foreach(mode extended unitary)
  set(options)
  if(mode STREQUAL unitary)
    set(options --unitary-only)
  endif()
  execute_process(COMMAND "${BIN}/sic-identify" "${WORK}/conjugate.csv" --repo "${DATA}"
    --catalogue "${DATA}/catalogue.tsv" ${options} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(mode STREQUAL extended AND (NOT rc EQUAL 0 OR NOT out MATCHES "MATCH d8 " OR NOT out MATCHES "\\(antiunitary,"))
    message(FATAL_ERROR "antiunitary match: ${rc} ${out} ${err}")
  elseif(mode STREQUAL unitary AND (NOT rc EQUAL 1 OR NOT out MATCHES "NO_MATCH"))
    message(FATAL_ERROR "unitary-only search: ${rc} ${out} ${err}")
  endif()
endforeach()
