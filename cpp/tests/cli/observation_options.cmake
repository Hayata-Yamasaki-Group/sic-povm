file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
foreach(mode reference observed)
  set(options)
  if(mode STREQUAL observed)
    set(options --profile --log-admissions)
  endif()
  execute_process(COMMAND "${BIN}/sic-decode" "${FIXTURE}" "${WORK}/${mode}" --threads 2 --no-pin ${options}
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0 OR NOT out MATCHES "PASS")
    message(FATAL_ERROR "decode ${mode}: ${rc} ${out} ${err}")
  endif()
  if(mode STREQUAL reference AND err MATCHES "SICX-PROFILE|ADMISSION ")
    message(FATAL_ERROR "unexpected default diagnostics: ${err}")
  endif()
  if(mode STREQUAL observed AND (NOT err MATCHES "SICX-PROFILE" OR NOT err MATCHES "ADMISSION " OR out MATCHES "SICX-PROFILE|ADMISSION "))
    message(FATAL_ERROR "observation diagnostics missing from stderr: ${out} ${err}")
  endif()
endforeach()
file(GLOB files RELATIVE "${WORK}/reference" "${WORK}/reference/*.raw.balls" "${WORK}/reference/*.normalized.balls" "${WORK}/reference/*.fp64.txt")
file(GLOB observed_files RELATIVE "${WORK}/observed" "${WORK}/observed/*.raw.balls" "${WORK}/observed/*.normalized.balls" "${WORK}/observed/*.fp64.txt")
list(SORT files)
list(SORT observed_files)
if(NOT files STREQUAL observed_files)
  message(FATAL_ERROR "decoder output file sets differ")
endif()
if(NOT files)
  message(FATAL_ERROR "decoder produced no numerical outputs")
endif()
foreach(file IN LISTS files)
  file(SHA256 "${WORK}/reference/${file}" a)
  file(SHA256 "${WORK}/observed/${file}" b)
  if(NOT a STREQUAL b)
    message(FATAL_ERROR "observation changed ${file}")
  endif()
endforeach()
foreach(mode ordinary checked)
  set(options)
  if(mode STREQUAL checked)
    set(options --sic-check)
  endif()
  execute_process(COMMAND "${BIN}/sic-verify" "${FIXTURE}" --threads 2 ${options}
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0 OR NOT out MATCHES "PASS full")
    message(FATAL_ERROR "verify ${mode}: ${rc} ${out} ${err}")
  endif()
  if(mode STREQUAL checked)
    if(NOT out MATCHES "fp64_sic_deviation=" OR NOT out MATCHES "diagnostic, not certified")
      message(FATAL_ERROR "SIC diagnostic missing: ${out}")
    endif()
    string(REGEX MATCH "fp64_sic_deviation=([0-9.eE+-]+)" match "${out}")
    if(NOT match OR NOT CMAKE_MATCH_1 LESS 1e-10)
      message(FATAL_ERROR "SIC deviation is not small: ${out}")
    endif()
  elseif(mode STREQUAL ordinary AND out MATCHES "fp64_sic_deviation=")
    message(FATAL_ERROR "unexpected SIC diagnostic: ${out}")
  endif()
endforeach()
