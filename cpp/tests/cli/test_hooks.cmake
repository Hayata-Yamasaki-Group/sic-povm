cmake_minimum_required(VERSION 3.20)
if(MODE STREQUAL "compiler")
  file(MAKE_DIRECTORY "${WORK}")
  file(WRITE "${WORK}/mode.cpp" "int main() { return 0; }\n")
  foreach(_case absent zero one)
    set(_definition "")
    if(_case STREQUAL "zero")
      set(_definition -DSIC_ENABLE_TEST_HOOKS=0)
    elseif(_case STREQUAL "one")
      set(_definition -DSIC_ENABLE_TEST_HOOKS=1)
    endif()
    if(MSVC_MODE)
      set(_args /nologo "/FI${HEADER}" /c "${WORK}/mode.cpp" "/Fo${WORK}/mode.obj")
    else()
      set(_args -include "${HEADER}" -c "${WORK}/mode.cpp" -o "${WORK}/mode.o")
    endif()
    execute_process(COMMAND "${CXX}" ${_definition} ${_args}
      RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    if((ENABLED AND NOT _case STREQUAL "absent") OR
       (NOT ENABLED AND _case STREQUAL "absent"))
      if(NOT _rc EQUAL 0)
        message(FATAL_ERROR "effective-mode compiler check failed: ${_case} ${_out}${_err}")
      endif()
    elseif(_rc EQUAL 0 OR NOT "${_out}${_err}" MATCHES "SIC_ENABLE_TEST_HOOKS must")
      message(FATAL_ERROR "mode mismatch was not rejected by compiler: ${_case} ${_out}${_err}")
    endif()
  endforeach()
  return()
endif()

if(MODE STREQUAL "manifest")
  execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${BUILD}" --show-only=json-v1
    RESULT_VARIABLE _rc OUTPUT_VARIABLE _json ERROR_VARIABLE _err)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "CTest manifest unavailable: ${_err}")
  endif()
  file(STRINGS "${BUILD}/test-hooks-required.txt" _required)
  file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/hook_dependent_tests.txt" _hook_dependent)
  foreach(_name IN LISTS _hook_dependent)
    if(NOT _name IN_LIST _required)
      message(FATAL_ERROR "original hook suite dropped from manifest: ${_name}")
    endif()
  endforeach()
  string(JSON _count LENGTH "${_json}" tests)
  math(EXPR _last "${_count}-1")
  set(_enrolled "")
  foreach(_i RANGE ${_last})
    string(JSON _name GET "${_json}" tests ${_i} name)
    string(JSON _props GET "${_json}" tests ${_i} properties)
    if(_name IN_LIST _required)
      if(NOT ENABLED)
        message(FATAL_ERROR "hook control present in OFF manifest: ${_name}")
      endif()
      if(NOT _props MATCHES "test_hooks" OR _props MATCHES "DISABLED|SKIP_RETURN_CODE|SKIP_REGULAR_EXPRESSION")
        message(FATAL_ERROR "hook control unlabelled, disabled or skippable: ${_name}")
      endif()
      list(APPEND _enrolled "${_name}")
    elseif(_props MATCHES "test_hooks")
      message(FATAL_ERROR "undeclared hook control: ${_name}")
    endif()
  endforeach()
  if(ENABLED)
    foreach(_name IN LISTS _required)
      if(NOT _name IN_LIST _enrolled)
        message(FATAL_ERROR "required hook control missing: ${_name}")
      endif()
    endforeach()
  endif()
  if(DEFINED REPORT)
    file(READ "${REPORT}" _report)
    if(_report MATCHES "<failure|<skipped")
      message(FATAL_ERROR "hook execution contains failed/skipped controls")
    endif()
    foreach(_name IN LISTS _required)
      if(NOT _report MATCHES "<testcase name=\"${_name}\"[^>]*status=\"run\"")
        message(FATAL_ERROR "hook control did not execute: ${_name}")
      endif()
    endforeach()
  endif()
  file(READ "${BUILD}/compile_commands.json" _commands)
  string(JSON _count LENGTH "${_commands}")
  math(EXPR _last "${_count}-1")
  foreach(_i RANGE ${_last})
    string(JSON _file GET "${_commands}" ${_i} file)
    string(JSON _command GET "${_commands}" ${_i} command)
    if(_file MATCHES "/(checkers/|tests/independence/)")
      if(_command MATCHES "test_hooks_mode|[/-]DSIC_ENABLE_TEST_HOOKS")
        message(FATAL_ERROR "independent source inherited hook policy: ${_file}")
      endif()
    elseif(NOT _command MATCHES "test_hooks_mode" OR
           (ENABLED AND NOT _command MATCHES "[/-]DSIC_ENABLE_TEST_HOOKS=1") OR
           (NOT ENABLED AND _command MATCHES "[/-]DSIC_ENABLE_TEST_HOOKS"))
      message(FATAL_ERROR "inconsistent TU mode: ${_file}: ${_command}")
    endif()
  endforeach()
  message(STATUS "explicit hook enrollment and compiler mode manifest PASS")
  return()
endif()

if(MODE STREQUAL "activation")
  file(REMOVE_RECURSE "${WORK}")
  file(MAKE_DIRECTORY "${WORK}")
  set(_env SIC_DEV_SPILL=1)
  set(_expected "")
  if(FAULT STREQUAL "defer_class" OR FAULT STREQUAL "defer_entry")
    list(APPEND _env SIC_TEST_NEWTON_DEFER_CLASS=0)
    set(_expected "Newton resource fixture fired: class=0 stage=after_B0")
    if(FAULT STREQUAL "defer_entry")
      list(APPEND _env SIC_TEST_NEWTON_DEFER_ENTRY_AFTER_HINT=1)
      set(_expected "Newton resource fixture fired: class=0 stage=entry hint_rows=[1-9]")
    endif()
  else()
    list(APPEND _env "SIC_DIRECT_ETA_TEST_FAULT=${FAULT}")
    if(FAULT STREQUAL "plan")
      set(_expected "direct eta refused: class=0.*injected planning fault.*literal table path used")
    elseif(FAULT STREQUAL "evaluate")
      set(_expected "direct eta refused: class=0.*injected.*literal table path used")
    elseif(FAULT STREQUAL "nonfinite")
      set(_expected "direct eta refused: class=0.*nonfinite direct representative entry.*literal table path used")
    elseif(FAULT STREQUAL "admission")
      set(_expected "direct eta refused: class=0.*direct representative entries [(]injected[)].*literal table path used")
    elseif(FAULT STREQUAL "stop")
      set(_expected "requested stop")
    else()
      message(FATAL_ERROR "unknown activation control: ${FAULT}")
    endif()
  endif()
  set(_args 4 --out "${WORK}/fault.sicx" --threads 2 --memory-mib 2048
    --stop-file "${WORK}/stop" --progress)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${_env} "${PROGRAM}" ${_args}
    RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 100)
  file(WRITE "${WORK}/activation.log" "${_rc}\n${_out}\n${_err}")
  if(NOT "${_out}${_err}" MATCHES "${_expected}")
    message(FATAL_ERROR "causal activation missing (${_expected}): ${_rc}\n${_out}${_err}")
  endif()
  if(FAULT STREQUAL "stop")
    if(_rc EQUAL 0 OR EXISTS "${WORK}/fault.sicx" OR NOT EXISTS "${WORK}/stop")
      message(FATAL_ERROR "stop did not propagate without publication")
    endif()
    file(REMOVE "${WORK}/stop")
  elseif(NOT _rc EQUAL 0 OR NOT EXISTS "${WORK}/fault.sicx")
    message(FATAL_ERROR "safe fallback did not publish certified output: ${_rc}\n${_out}${_err}")
  endif()
  execute_process(COMMAND "${PROGRAM}" 4 --out "${WORK}/clean.sicx" --threads 2 --memory-mib 2048
    RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 100)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "post-fault clean retry failed: ${_out}${_err}")
  endif()
  if(NOT FAULT STREQUAL "stop")
    file(SHA256 "${WORK}/fault.sicx" _fault)
    file(SHA256 "${WORK}/clean.sicx" _clean)
    if(NOT _fault STREQUAL _clean)
      message(FATAL_ERROR "fallback changed canonical bytes")
    endif()
  endif()
  message(STATUS "${FAULT}: causal activation, safe outcome and clean retry PASS")
  return()
endif()

if(NOT MODE STREQUAL "isolation")
  message(FATAL_ERROR "select a test-hook matrix mode")
endif()
set(_keys SIC_CLASS_THREADS SIC_DEV_MEMORY_MB SIC_DEV_KEEP_ALL SIC_DEV_SPILL
  SIC_DIRECT_ETA_TEST_FAULT SIC_TEST_NEWTON_DEFER_CLASS SIC_TEST_NEWTON_DEFER_ENTRY_AFTER_HINT
  SIC_TEST_FAIL_SIC_CHECK SIC_TEST_KILL_AFTER_WRITE SIC_TEST_PRECISION_RETRY
  SIC_TEST_CEIL1_FORCE_PRECISION_REFUSAL SIC_FAULT_KILL_AFTER_CHUNKS
  SIC_FAULT_KILL_AT_BYTE SIC_TEST_ABORT_AFTER_PARTS)
foreach(_key IN LISTS _keys)
  unset(ENV{${_key}})
endforeach()
file(MAKE_DIRECTORY "${WORK}")
function(_isolation_case _name)
  set(_dir "${WORK}/${_name}")
  file(MAKE_DIRECTORY "${_dir}/data/d4/m1")
  execute_process(COMMAND "${BIN}/sic-construct" 2 --out "${_dir}/native.sicx" --threads 1
    RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "${_name}: installed producer failed: ${_rc} ${_out}${_err}")
  endif()
  file(SHA256 "${_dir}/native.sicx" _digest)
  if(NOT _digest STREQUAL "b5e4771117cd9767d5d096dbb69bde695817aa6f5b872a86370b8e41ce844622")
    message(FATAL_ERROR "${_name}: installed producer bytes changed: ${_digest}")
  endif()
  configure_file("${_dir}/native.sicx" "${_dir}/final.sicx" COPYONLY)
  execute_process(COMMAND "${BIN}/sic-decode" "${_dir}/final.sicx" "${_dir}/decoded"
    --finalize --ray c0 0,0,0 1 --threads 1
    RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  if(NOT _rc EQUAL 0 OR NOT _out MATCHES "FINALIZED")
    message(FATAL_ERROR "${_name}: installed finalization failed: ${_rc} ${_out}${_err}")
  endif()
  file(SHA256 "${_dir}/final.sicx" _final)
  if(_name STREQUAL "clean")
    file(WRITE "${WORK}/clean-final.sha256" "${_final}")
  else()
    file(READ "${WORK}/clean-final.sha256" _expected_final)
    if(NOT _final STREQUAL _expected_final)
      message(FATAL_ERROR "${_name}: installed finalization bytes changed")
    endif()
  endif()
  execute_process(COMMAND "${BIN}/sic-inspect" "${FIXTURE}" --text-json -
    RESULT_VARIABLE _rc OUTPUT_FILE "${_dir}/input.jsonl" ERROR_VARIABLE _err)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "${_name}: to-text failed: ${_err}")
  endif()
  execute_process(COMMAND "${BIN}/sic-container" from-text "${_dir}/input.jsonl" "${_dir}/copy.sicx"
    RESULT_VARIABLE _rc OUTPUT_QUIET ERROR_VARIABLE _err)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "${_name}: installed writer failed: ${_rc} ${_err}")
  endif()
  file(SHA256 "${_dir}/copy.sicx" _copy)
  file(SHA256 "${FIXTURE}" _fixture)
  if(NOT _copy STREQUAL _fixture)
    message(FATAL_ERROR "${_name}: container bytes changed")
  endif()
  execute_process(COMMAND "${BIN}/sic-container" split "${FIXTURE}" --out "${_dir}/parts" --asset-prefix d4-m1
    RESULT_VARIABLE _rc OUTPUT_QUIET ERROR_VARIABLE _err)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "${_name}: split failed: ${_err}")
  endif()
  file(COPY "${_dir}/parts/multiplet.sicx.parts.json" DESTINATION "${_dir}/data/d4/m1")
  foreach(_verb fetch repair)
    if(_verb STREQUAL "repair")
      file(APPEND "${_dir}/fetch/multiplet.sicx" "corruption")
    endif()
    execute_process(COMMAND "${BIN}/sic-container" ${_verb} d4/m1 --data-root "${_dir}/data"
      --source "${_dir}/parts" --out "${_dir}/fetch" --threads 1
      RESULT_VARIABLE _rc OUTPUT_QUIET ERROR_VARIABLE _err)
    if(NOT _rc EQUAL 0)
      message(FATAL_ERROR "${_name}: installed ${_verb} failed: ${_rc} ${_err}")
    endif()
    file(SHA256 "${_dir}/fetch/multiplet.sicx" _fetched)
    if(NOT _fetched STREQUAL _fixture)
      message(FATAL_ERROR "${_name}: ${_verb} bytes changed")
    endif()
  endforeach()
endfunction()
_isolation_case(clean)
# Matrix precision is a documented producer setting, validated before CLI environment setup.
# A valid inherited value is discarded; malformed or out-of-range values are refused.
set(ENV{SIC_NEWTON_MATRIX_BITS} 128)
_isolation_case(valid_matrix_precision)
foreach(_value "1" "" "invalid")
  set(ENV{SIC_NEWTON_MATRIX_BITS} "${_value}")
  execute_process(COMMAND "${BIN}/sic-construct" 2 --out "${WORK}/invalid-matrix.sicx" --threads 1
    RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  if(NOT _rc EQUAL 1 OR NOT _err MATCHES "\\[invalid_argument\\]" OR
     _out MATCHES "d=|entry error bounds|Newton|quadrature start" OR EXISTS "${WORK}/invalid-matrix.sicx")
    message(FATAL_ERROR "invalid inherited matrix precision started work: ${_rc} ${_out}${_err}")
  endif()
endforeach()
unset(ENV{SIC_NEWTON_MATRIX_BITS})
file(APPEND "${WORK}/isolation.tsv" "SIC_NEWTON_MATRIX_BITS\tvalid discarded; 1,empty,invalid refused\tPASS\n")
foreach(_key IN LISTS _keys)
  foreach(_kind one empty invalid)
    if(_kind STREQUAL "one")
      set(ENV{${_key}} 1)
    elseif(_kind STREQUAL "empty")
      set(ENV{${_key}} "")
    else()
      set(ENV{${_key}} invalid)
    endif()
    _isolation_case("${_key}-${_kind}")
    unset(ENV{${_key}})
  endforeach()
  file(APPEND "${WORK}/isolation.tsv" "${_key}\t1,empty,invalid\tPASS producer/writer/fetch/repair\n")
endforeach()
foreach(_fault plan evaluate nonfinite admission stop)
  set(ENV{SIC_DIRECT_ETA_TEST_FAULT} "${_fault}")
  _isolation_case("direct-eta-${_fault}")
endforeach()
foreach(_key IN LISTS _keys)
  set(ENV{${_key}} 1)
endforeach()
_isolation_case(all)
# Every installed executable also runs the same smoke operation with clean and
# fully contaminated environments, including data, bounds and independent tools.
file(GLOB _tools "${BIN}/*")
foreach(_tool IN LISTS _tools)
  execute_process(COMMAND "${_tool}" --help RESULT_VARIABLE _dirty
    OUTPUT_VARIABLE _dirty_out ERROR_VARIABLE _dirty_err)
  foreach(_key IN LISTS _keys)
    unset(ENV{${_key}})
  endforeach()
  execute_process(COMMAND "${_tool}" --help RESULT_VARIABLE _clean
    OUTPUT_VARIABLE _clean_out ERROR_VARIABLE _clean_err)
  if(NOT _dirty STREQUAL _clean OR NOT _dirty_out STREQUAL _clean_out OR NOT _dirty_err STREQUAL _clean_err)
    message(FATAL_ERROR "installed tool smoke contaminated: ${_tool}")
  endif()
  foreach(_key IN LISTS _keys)
    set(ENV{${_key}} 1)
  endforeach()
  file(APPEND "${WORK}/tools.tsv" "${_tool}\tPASS\n")
endforeach()
message(STATUS "all fourteen installed hook selectors are inert: PASS")
