execute_process(COMMAND "${TOOL}" --help RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0 OR NOT err STREQUAL "" OR NOT out MATCHES "usage: " OR NOT out MATCHES "--help")
  message(FATAL_ERROR "--help contract: rc=${rc}, stdout=${out}, stderr=${err}")
endif()
if(NOT NAME STREQUAL "read-fiducial")
file(READ "${DOC}" doc)
string(FIND "${doc}" "<!-- cli:${NAME} -->" first)
string(FIND "${doc}" "<!-- /cli:${NAME} -->" last)
if(first LESS 0 OR last LESS first)
  message(FATAL_ERROR "missing CLI reference for ${NAME}")
endif()
math(EXPR length "${last} - ${first}")
string(SUBSTRING "${doc}" ${first} ${length} section)
  string(FIND "${section}" "```text\n${out}```" exact_help)
  if(exact_help LESS 0)
    message(FATAL_ERROR "${NAME} help reference differs from --help output")
  endif()
foreach(text out section)
  string(REGEX MATCHALL "--[a-z][a-z0-9-]*" opts "${${text}}")
  list(REMOVE_DUPLICATES opts)
  list(SORT opts)
  set(${text}_options "${opts}")
endforeach()
if(NOT out_options STREQUAL section_options)
  message(FATAL_ERROR "${NAME}: help options ${out_options}; documented ${section_options}")
endif()
endif()
foreach(args "--unknown-option" "")
  execute_process(COMMAND "${TOOL}" ${args} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 2 OR NOT out STREQUAL "" OR NOT err MATCHES "usage: ")
    message(FATAL_ERROR "usage contract for '${args}': rc=${rc}, stdout=${out}, stderr=${err}")
  endif()
endforeach()

if(NAME STREQUAL "sic-container")
  set(commands split fetch repair from-text merge-parts merge-element-parts)
elseif(NAME STREQUAL "sic-data")
  set(commands formats write check bundle check-bundle list layout catalogue)
else()
  set(commands)
endif()
foreach(command IN LISTS commands)
  execute_process(COMMAND "${TOOL}" "${command}" --help RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(command STREQUAL split AND NOT out MATCHES "\\[--emit-and-upload CMD --confirm-size-cmd CMD\\]")
    message(FATAL_ERROR "split help must show paired commands: ${out}")
  endif()
  if(NOT rc EQUAL 0 OR NOT err STREQUAL "" OR NOT out MATCHES "usage: ")
    message(FATAL_ERROR "${command} --help contract: rc=${rc}, stdout=${out}, stderr=${err}")
  endif()
endforeach()
