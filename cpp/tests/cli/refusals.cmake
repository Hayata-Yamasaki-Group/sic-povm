# Classified runtime I/O retains exit 1; malformed usage above retains exit 2.
if(FLINT)
  execute_process(COMMAND "${BIN}/sic-container" fetch d4/m1
    --parts "${WORK}/missing.parts.json" --out "${WORK}/io-refusal" --threads 1
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 1 OR NOT out STREQUAL "" OR NOT err MATCHES "\\[io\\]" OR err MATCHES "usage: ")
    message(FATAL_ERROR "I/O exit contract: rc=${rc}, stdout=${out}, stderr=${err}")
  endif()
endif()
