if(FLINT)
  file(REMOVE_RECURSE "${WORK}")
  file(MAKE_DIRECTORY "${WORK}/output")
  execute_process(COMMAND "${BIN}/sic-container" split "${FIXTURE}" --out "${WORK}/assets"
    --asset-prefix d4-m1 RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "split fixture failed: ${err}")
  endif()
  file(WRITE "${WORK}/output/multiplet.sicx" "keep existing output")
  refuse(sic-container fetch d4/m1 --parts "${WORK}/assets/multiplet.sicx.parts.json"
    --out "${WORK}/output" --force --extra-bytes 18446744073709551615)
  file(READ "${WORK}/output/multiplet.sicx" kept)
  if(NOT kept STREQUAL "keep existing output")
    message(FATAL_ERROR "invalid fetch arguments changed the existing destination")
  endif()
endif()

