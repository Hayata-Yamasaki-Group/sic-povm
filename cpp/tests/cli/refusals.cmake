# No real input is needed: malformed arguments must be refused before I/O.
function(refuse name)
  if(IS_ABSOLUTE "${name}")
    set(tool "${name}")
  else()
    set(tool "${BIN}/${name}")
  endif()
  set(extra)
  if(name STREQUAL "sic-identify" OR name STREQUAL "sic-stabilizer")
    set(extra --repo "${REPO}")
  endif()
  execute_process(COMMAND "${tool}" ${ARGN} ${extra}
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 2 OR NOT out STREQUAL "" OR NOT err MATCHES "usage: ")
    message(FATAL_ERROR "${name} ${ARGN}: rc=${rc}, stdout=${out}, stderr=${err}")
  endif()
endfunction()
