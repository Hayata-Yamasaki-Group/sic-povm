{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sic-fiducial-json/1.0",
  "title": "SIC fiducial ray file c<N>.json (one ray, generated from SICX)",
  "description": "docs/sicx.md#9-ray-files-sic-fiducial-json10-cnjson; release layout d<d>/m<N>/c<N>.json (the conductor is not stored). Every number is a string; canonical JSON (sorted keys, no whitespace, one trailing newline). Conventions (WH group, tau, normalization, anchor gauge, coordinate order) are fixed by this schema version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "required_features", "d", "multiplet", "id", "index", "galois_element", "labels", "sicx", "fp32", "fp64", "hp"],
  "$defs": {
    "uint": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "hex32": {"type": "string", "pattern": "^[0-9a-f]{8}$"},
    "dec17": {"type": "string", "pattern": "^-?[0-9]\\.[0-9]{16}e[+-][0-9]{2,3}$"},
    "dec9": {"type": "string", "pattern": "^-?[0-9]\\.[0-9]{8}e[+-][0-9]{2,3}$"},
    "fixed": {"type": "string", "pattern": "^-?[0-9]+\\.[0-9]+$"},
    "bound": {"type": "string", "pattern": "^0x[01]p[+-][0-9]+$"},
    "pairs": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2}},
    "float_level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "decimal", "error_bound", "rounding"],
      "properties": {
        "values": {"$ref": "#/$defs/pairs"},
        "decimal": {"$ref": "#/$defs/pairs"},
        "error_bound": {"$ref": "#/$defs/bound"},
        "rounding": {"type": "string"}
      }
    }
  },
  "properties": {
    "schema": {"const": "sic-fiducial-json/1.0"},
    "required_features": {"type": "array", "maxItems": 0},
    "d": {"$ref": "#/$defs/uint"},
    "multiplet": {"type": "string", "pattern": "^m[1-9][0-9]{0,17}$"},
    "id": {"type": "string", "pattern": "^d[1-9][0-9]*-m[1-9][0-9]{0,17}-c(0|[1-9][0-9]{0,17})$"},
    "index": {"$ref": "#/$defs/uint"},
    "galois_element": {
      "type": "object", "additionalProperties": false, "required": ["smith", "exponents"],
      "properties": {"smith": {"type": "array", "items": {"$ref": "#/$defs/uint"}}, "exponents": {"type": "array", "items": {"$ref": "#/$defs/uint"}}}
    },
    "labels": {"type": "object", "additionalProperties": {"type": "string"}},
    "sicx": {
      "type": "object", "additionalProperties": false, "required": ["name", "sha256", "merkle_root"],
      "properties": {"name": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}, "merkle_root": {"$ref": "#/$defs/sha256"}}
    },
    "exact": {
      "type": "object", "additionalProperties": false, "required": ["file", "ray"],
      "properties": {"file": {"const": "exact.json"}, "ray": {"type": "string"}}
    },
    "fp32": {
      "allOf": [{"$ref": "#/$defs/float_level"}],
      "properties": {
        "values": {"items": {"items": {"$ref": "#/$defs/hex32"}}},
        "decimal": {"items": {"items": {"$ref": "#/$defs/dec9"}}}
      }
    },
    "fp64": {
      "allOf": [{"$ref": "#/$defs/float_level"}],
      "properties": {
        "values": {"items": {"items": {"$ref": "#/$defs/hex64"}}},
        "decimal": {"items": {"items": {"$ref": "#/$defs/dec17"}}}
      }
    },
    "hp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accuracy_bits", "decimal_places", "values"],
      "properties": {
        "accuracy_bits": {"$ref": "#/$defs/uint"},
        "decimal_places": {"$ref": "#/$defs/uint"},
        "values": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/fixed"}, "minItems": 4, "maxItems": 4}}
      }
    }
  }
}
