{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sicx-text-json-parts/1.0",
  "title": "sicx-text-json-parts/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "parts"
  ],
  "properties": {
    "schema": {
      "const": "sicx-text-json-parts/1.0"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "bytes",
          "lines",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "bytes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "lines": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
