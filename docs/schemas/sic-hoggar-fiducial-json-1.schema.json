{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sic-hoggar-fiducial-json/1.0",
  "title": "Hoggar ray file data/d8/hoggar/c0.json",
  "description": "c0.json has the fp32, fp64 and hp blocks of sic-fiducial-json/1.0 (same value layout and error rules, docs/data.md) but no multiplet, galois_element or sicx (there is no SICX). hp: the radius is 0 exactly where the coordinate is exactly 0, otherwise one unit in the last decimal place. exact.json is the exact form (schema sic-hoggar-exact-json/1.0, defined in sic-hoggar-exact-json-1.schema.json).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "required_features", "d", "id", "index", "group", "labels", "status", "exact", "fp32", "fp64", "hp"],
  "$defs": {
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "hex32": {"type": "string", "pattern": "^[0-9a-f]{8}$"},
    "dec17": {"type": "string", "pattern": "^-?[0-9]\\.[0-9]{16}e[+-][0-9]{2,3}$"},
    "dec9": {"type": "string", "pattern": "^-?[0-9]\\.[0-9]{8}e[+-][0-9]{2,3}$"},
    "level": {
      "type": "object", "additionalProperties": false, "required": ["values", "decimal", "error_bound", "rounding"],
      "properties": {"values": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2}}, "decimal": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2}}, "error_bound": {"type": "string", "pattern": "^0x1p-[0-9]+$"}, "rounding": {"type": "string"}}
    }
  },
  "properties": {
    "schema": {"const": "sic-hoggar-fiducial-json/1.0"},
    "required_features": {"type": "array", "maxItems": 0},
    "d": {"const": "8"},
    "id": {"type": "string", "pattern": "^d8-hoggar-c[0-9]+$"},
    "index": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "group": {"const": "3-qubit Pauli group"},
    "labels": {"type": "object", "additionalProperties": {"type": "string"}},
    "status": {"enum": ["proved", "certified", "conditional", "empirical", "conjectural"]},
    "exact": {"type": "object", "additionalProperties": false, "required": ["file", "ray"], "properties": {"file": {"const": "exact.json"}, "ray": {"type": "string"}}},
    "fp32": {"allOf": [{"$ref": "#/$defs/level"}], "properties": {"values": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/hex32"}}}, "decimal": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/dec9"}}}}},
    "fp64": {"allOf": [{"$ref": "#/$defs/level"}], "properties": {"values": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/hex64"}}}, "decimal": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/dec17"}}}}},
    "hp": {
      "type": "object", "additionalProperties": false, "required": ["accuracy_bits", "decimal_places", "values"],
      "properties": {
        "accuracy_bits": {"type": "string"}, "decimal_places": {"type": "string"},
        "values": {"type": "array", "items": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string", "pattern": "^-?[0-9]+\\.[0-9]+$"}}}
      }
    }
  }
}
