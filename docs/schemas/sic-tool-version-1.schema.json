{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sic-tool-version/1.0",
  "title": "sic-tool-version/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "source_commit",
    "version"
  ],
  "properties": {
    "schema": {
      "const": "sic-tool-version/1.0"
    },
    "name": {
      "type": "string",
      "pattern": "^sic-[a-z-]+$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "version": {
      "const": "1.0.0"
    }
  }
}
