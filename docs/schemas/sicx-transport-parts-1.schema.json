{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sicx-transport-parts/1.0",
  "title": "sicx-transport-parts/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "alignment",
    "exact_root",
    "file_root",
    "file",
    "size_bytes",
    "sha256",
    "part_size_bytes",
    "release",
    "parts"
  ],
  "properties": {
    "schema": {
      "const": "sicx-transport-parts/1.0"
    },
    "alignment": {
      "const": "sicx-chunks/1.0"
    },
    "exact_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file": {
      "const": "multiplet.sicx"
    },
    "size_bytes": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "part_size_bytes": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "asset",
          "offset",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "index": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "asset": {
            "type": "string"
          },
          "offset": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "size_bytes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
